<script defer>
(function () {
  "use strict";
  var SAMPLE_RATE = 16000;
  var ws = null;
  var actx = null;
  window.VCMALL = { thr: { nova: 0.5, piattos: 0.5, g2min: 0.5 }, send: null, onServerMessage: null, onAudio: null, micLive: false, ncOn: false, ncReady: false, memorySeconds: 20, intervalSeconds: 1, skipTicksOn: false };

  function setStatus(text, isError) {
    var elStatus = document.getElementById("status");
    if (elStatus) { elStatus.textContent = text; elStatus.className = isError ? "err" : ""; }
  }

  function to16k(samples) {
    var data = (samples instanceof Float32Array) ? samples : new Float32Array(samples);
    var ctxRate = actx ? actx.sampleRate : SAMPLE_RATE;
    if (ctxRate === SAMPLE_RATE) return data;
    var ratio = ctxRate / SAMPLE_RATE;
    var outLength = Math.floor(data.length / ratio);
    var output = new Float32Array(outLength);
    for (var i = 0; i < outLength; i++) {
      var pos = i * ratio;
      var left = Math.floor(pos);
      var right = Math.min(left + 1, data.length - 1);
      var fraction = pos - left;
      output[i] = data[left] * (1 - fraction) + data[right] * fraction;
    }
    return output;
  }

  function connect() {
    var proto = location.protocol === "https:" ? "wss" : "ws";
    ws = new WebSocket(proto + "://" + location.host + "/ws");
    ws.binaryType = "arraybuffer";
    ws.onopen = function () {
      setStatus("server connected. streaming mic…");
      ws.send(JSON.stringify({ type: "mode", mode: "both" }));
      window.VCMALL.send = function (obj) { if (ws && ws.readyState === 1) ws.send(JSON.stringify(obj)); };
      // Reconnect safety: a save click right before a disconnect would otherwise
      // leave the button stuck on "Saving…" with no capture_saved reply.
      // el() is defined only inside later script blocks — resolve directly here,
      // otherwise onopen throws "el is not defined" and startMic never runs.
      var save30 = document.getElementById("pipe2ownervoiceSave30");
      if (save30) { save30.disabled = false; save30.textContent = "⏺ Save last 30 s"; }
      // Reconnect-safe: the server starts every connection fresh, so repeat
      // the persistent operator choices (memory ring + noise-canceller switch).
      ws.send(JSON.stringify({ type: "memory", seconds: window.VCMALL.memorySeconds }));
      if (window.VCMALL.ncOn) ws.send(JSON.stringify({ type: "noise_canceller", enabled: true }));
      ws.send(JSON.stringify({ type: "interval", interval_s: window.VCMALL.intervalSeconds || 1 }));
      if (window.VCMALL.skipTicksOn) ws.send(JSON.stringify({ type: "skip_ticks", enabled: true }));
      startMic();
    };
    ws.onmessage = function (event) {
      if (typeof event.data !== "string") return;
      var msg = null;
      try { msg = JSON.parse(event.data); } catch (err) { return; }
      if (window.VCMALL.onServerMessage) window.VCMALL.onServerMessage(msg);
    };
    ws.onclose = function () { window.VCMALL.micLive = false; setStatus("server disconnected — retrying in 2s…"); setTimeout(connect, 2000); };
    ws.onerror = function () {};
  }

  async function startMic() {
    try {
      var stream = await navigator.mediaDevices.getUserMedia({
        audio: { echoCancellation: false, noiseSuppression: false, autoGainControl: false, channelCount: 1 }
      });
      var Ctx = window.AudioContext || window.webkitAudioContext;
      actx = new Ctx({ sampleRate: SAMPLE_RATE });
      // Some browsers (autoplay policy, energy savers, automation) create the
      // context suspended — onaudioprocess then never fires and no audio
      // reaches the server ("filling first window (0/…)" forever).
      if (actx.state === "suspended") { await actx.resume(); }
      var source = actx.createMediaStreamSource(stream);
      var processor = actx.createScriptProcessor(4096, 1, 1);
      processor.onaudioprocess = function (event) {
        if (!ws || ws.readyState !== 1) return;
        var samples = to16k(event.inputBuffer.getChannelData(0));
        ws.send(samples.buffer);
        if (window.VCMALL.onAudio) window.VCMALL.onAudio(samples);
      };
      source.connect(processor);
      processor.connect(actx.destination);
      window.VCMALL.micLive = true;
      setStatus("microphone live (" + actx.sampleRate + " Hz). pipeline: memory → G1 → G2 → light → G3/4/5 every second.");
    } catch (err) {
      setStatus("MIC ERROR: " + err.message, true);
    }
  }

  window.addEventListener("DOMContentLoaded", function () { connect(); });
})();
</script>
<script>
(function () {
  "use strict";
  var V = window.VCMALL;
  if (!V) return;

  var LOFI_TRACKS = ["01_Study_At_Night.mp3","02_Cozy_Library.mp3","03_Library_Interior.mp3","04_Quiet_Library.mp3","05_Study_Desk.mp3"];
  var CALL_SOUNDS = ["01_Vintage_Telephone_Ringtone.mp3","02_Magic_Notification_Ring.mp3","03_Urgent_Tone_Loop.mp3","04_Office_Telephone_Ring.mp3","05_Marimba_Ringtone.mp3"];
  var dashMusicAudio = new Audio(); dashMusicAudio.loop = true;
  var dashCallAudio = new Audio();
  var thrHist = [];
  var WAVE_MAX = 48000;
  var waveBuf = new Float32Array(WAVE_MAX);
  var wavePos = 0;
  var waveCount = 0;
  var rmsHist = [];              // per-chunk RMS (volume chart)
  var lastG2Thr = null;
  var RMS_MAX = 240;
  var HIST_MAX = 120;

  function el(id) { return document.getElementById(id); }

  V.onAudio = function (samples) {
    var len = samples.length;
    for (var i = 0; i < len; i++) {
      waveBuf[wavePos] = samples[i];
      wavePos = (wavePos + 1) % WAVE_MAX;
      if (waveCount < WAVE_MAX) waveCount++;
    }
    var sum = 0;
    for (var j = 0; j < len; j++) sum += samples[j] * samples[j];
    rmsHist.push(Math.sqrt(sum / Math.max(1, len)));
    if (rmsHist.length > RMS_MAX) rmsHist.shift();
  };

  function pushThr(msg) {
    var g1 = msg && msg.g1 ? msg.g1 : {};
    var g2 = msg && msg.g2 ? msg.g2 : {};
    var spec = msg && msg.spec ? msg.spec : null;
    var g1c = null;
    if (g1.activation_conf != null && Number.isFinite(g1.activation_conf)) g1c = g1.activation_conf;
    else if (Array.isArray(g1.probs) && g1.probs.length) g1c = Math.max(g1.probs[0] || 0, g1.probs[1] || 0);
    else if (g1.conf != null && Number.isFinite(g1.conf)) g1c = g1.conf;

    var g2c = null;
    if (g2.activation_conf != null && Number.isFinite(g2.activation_conf)) g2c = g2.activation_conf;
    else if (g2.current_conf != null && Number.isFinite(g2.current_conf)) g2c = g2.current_conf;
    else if (g2.conf != null && Number.isFinite(g2.conf)) g2c = g2.conf;

    var specC = (spec && spec.conf != null && Number.isFinite(spec.conf)) ? spec.conf : null;

    thrHist.push({
      nova: V.thr.nova,
      piattos: V.thr.piattos,
      g1Conf: g1c,
      g2min: V.thr.g2min,
      lastG2: lastG2Thr,
      g2Conf: g2c,
      specRef: 0.5,
      specConf: specC
    });
    if (thrHist.length > HIST_MAX) thrHist.shift();
  }

  function syncSliders() {
    var n = el("all-thr-nova"), p = el("all-thr-piattos"), g = el("all-thr-g2min");
    if (n) n.value = V.thr.nova;
    if (p) p.value = V.thr.piattos;
    if (g) g.value = V.thr.g2min;
    var nv = el("all-thr-nova-val"), pv = el("all-thr-piattos-val"), gv = el("all-thr-g2min-val");
    if (nv) nv.textContent = Number(V.thr.nova).toFixed(2);
    if (pv) pv.textContent = Number(V.thr.piattos).toFixed(2);
    if (gv) gv.textContent = Number(V.thr.g2min).toFixed(2);
  }

  function drawWave() {
    var c = el("all-wave");
    if (!c) return;
    var ctx = c.getContext("2d");
    ctx.fillStyle = "#0d1117";
    ctx.fillRect(0, 0, c.width, c.height);
    var mid = c.height / 2;
    ctx.strokeStyle = "#30363d";
    ctx.beginPath();
    ctx.moveTo(0, mid); ctx.lineTo(c.width, mid); ctx.stroke();
    if (waveCount < 10) return;
    ctx.strokeStyle = "#1f6feb";
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    var width = c.width;
    var startIdx = (waveCount < WAVE_MAX) ? 0 : wavePos;
    var total = waveCount;
    var step = total / width;
    for (var col = 0; col < width; col++) {
      var sStart = Math.floor(col * step);
      var sEnd = Math.max(sStart + 1, Math.floor((col + 1) * step));
      var min = 1.0, max = -1.0;
      for (var s = sStart; s < sEnd && s < total; s++) {
        var v = waveBuf[(startIdx + s) % WAVE_MAX];
        if (v < min) min = v;
        if (v > max) max = v;
      }
      if (min <= max) {
        var y1 = mid - max * (mid - 4);
        var y2 = mid - min * (mid - 4);
        if (Math.abs(y2 - y1) < 1) { y1 -= 0.5; y2 += 0.5; }
        ctx.moveTo(col, y1);
        ctx.lineTo(col, y2);
      }
    }
    ctx.stroke();
  }

  function drawVolume() {
    var c = el("all-volume");
    if (!c) return;
    var ctx = c.getContext("2d");
    ctx.fillStyle = "#0d1117";
    ctx.fillRect(0, 0, c.width, c.height);
    var bw = Math.max(2, Math.floor(c.width / RMS_MAX));
    var start = Math.max(0, rmsHist.length - Math.floor(c.width / bw));
    ctx.fillStyle = "#2ea043";
    for (var i = start; i < rmsHist.length; i++) {
      var h = Math.min(1, rmsHist[i] / 0.25) * (c.height - 4);
      var x = (i - start) * bw;
      ctx.fillRect(x, c.height - h, bw - 1, h);
    }
  }

  function drawSubChart(canvasId, lines) {
    var c = el(canvasId);
    if (!c) return;
    var ctx = c.getContext("2d");
    ctx.fillStyle = "#0d1117";
    ctx.fillRect(0, 0, c.width, c.height);
    var plotLeft = 24, plotRight = c.width - 4, plotTop = 18, plotBottom = c.height - 12;
    var ticks = [0, 0.25, 0.5, 0.75, 1];
    ctx.font = "8px Consolas, monospace";
    ticks.forEach(function (tick) {
      var gy = plotBottom - tick * (plotBottom - plotTop);
      ctx.strokeStyle = "#21262d"; ctx.lineWidth = 1; ctx.beginPath(); ctx.moveTo(plotLeft, gy); ctx.lineTo(plotRight, gy); ctx.stroke();
      ctx.fillStyle = "#8b949e"; ctx.fillText(tick.toFixed(1), 2, gy + 3);
    });
    var n = thrHist.length;
    lines.forEach(function (line) {
      ctx.strokeStyle = line.color;
      ctx.lineWidth = line.width || 1.4;
      if (line.dashed) ctx.setLineDash([3, 2]); else ctx.setLineDash([]);
      ctx.beginPath();
      for (var i = 0; i < n; i++) {
        var v = thrHist[i][line.key];
        if (v == null) continue;
        var y = plotBottom - Math.max(0, Math.min(1, v)) * (plotBottom - plotTop);
        var x = (n <= 1) ? plotLeft : plotLeft + (i / Math.max(1, n - 1)) * (plotRight - plotLeft);
        if (i === 0 || thrHist[i - 1][line.key] == null) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
      }
      ctx.stroke();
    });
    ctx.setLineDash([]);
    var lx = plotLeft;
    lines.forEach(function (line) {
      ctx.fillStyle = line.color;
      ctx.fillText(line.label, lx, 10);
      lx += ctx.measureText(line.label).width + 6;
    });
  }

  function drawThrChart() {
    drawSubChart("all-thrchart-g1", [
      { key: "nova", color: "#1f6feb", label: "Nova (" + Number(V.thr.nova).toFixed(2) + ")", width: 1.2, dashed: true },
      { key: "piattos", color: "#f0883e", label: "Piattos (" + Number(V.thr.piattos).toFixed(2) + ")", width: 1.2, dashed: true },
      { key: "g1Conf", color: "#2ea043", label: "Wake", width: 1.8 }
    ]);
    drawSubChart("all-thrchart-g2", [
      { key: "g2min", color: "#a371f7", label: "Min (" + Number(V.thr.g2min).toFixed(2) + ")", width: 1.2, dashed: true },
      { key: "lastG2", color: "#f0883e", label: "Intent thr", width: 1.2, dashed: true },
      { key: "g2Conf", color: "#2ea043", label: "Conf", width: 1.8 }
    ]);
    drawSubChart("all-thrchart-g3", [
      { key: "specRef", color: "#8b949e", label: "Ref (0.50)", width: 1.0, dashed: true },
      { key: "specConf", color: "#d29922", label: "Slot conf", width: 1.8 }
    ]);
  }

  function setLit(id, on) {
    var box = el(id);
    if (box) box.classList.toggle("lit", !!on);
  }

  function updateDiagram(msg) {
    setLit("all-box-mic", V.micLive);
    setLit("all-box-g1", !!(msg.g1 && msg.g1.active));
    setLit("all-box-g2", !!(msg.g2 && msg.g2.active && !msg.g2.waiting));
    setLit("all-box-light", !!(msg.action_gate && (msg.action_gate.light_on || msg.action_gate.triggered)));
    var spec = msg.spec || null;
    var routed = spec ? spec.gate : null;
    var specs = msg.specialists || {};
    [["gateN", "all-box-g3"], ["gate4", "all-box-g4"], ["gate5", "all-box-g5"]].forEach(function (pair) {
      var box = el(pair[1]);
      if (!box) return;
      var ran = !!(specs[pair[0]]);
      box.classList.toggle("lit", ran);
      box.classList.toggle("route", routed === pair[0]);
    });
    setLit("all-box-out", !!msg.final);
  }

  function setThresholdMeter(name, confidence, threshold, waiting) {
    var fill = el("all-meter-" + name + "-fill");
    var mark = el("all-meter-" + name + "-mark");
    var state = el("all-meter-" + name + "-state");
    var thr = Number.isFinite(Number(threshold)) ? Number(threshold) : 0.5;
    if (mark) mark.style.left = (thr * 100) + "%";
    if (!Number.isFinite(confidence)) {
      if (fill) { fill.style.width = "0%"; fill.classList.remove("met"); }
      if (state) { state.textContent = waiting ? "WAIT" : "—"; state.className = "meter-state"; }
      return;
    }
    var conf = Math.max(0, Math.min(1, Number(confidence)));
    var met = conf >= thr;
    if (fill) { fill.style.width = (conf * 100) + "%"; fill.classList.toggle("met", met); }
    if (state) { state.textContent = conf.toFixed(2) + (met ? " ≥ " : " < ") + thr.toFixed(2); state.className = "meter-state " + (met ? "met" : "miss"); }
  }

  function updateThresholdMeters(msg) {
    var g1 = msg.g1 || {};
    var probs = Array.isArray(g1.probs) ? g1.probs : [];
    setThresholdMeter("nova", probs.length > 0 ? probs[0] : NaN, V.thr.nova, false);
    setThresholdMeter("piattos", probs.length > 1 ? probs[1] : NaN, V.thr.piattos, false);
    var g2 = msg.g2 || {};
    var g2conf = Number.isFinite(g2.current_conf) ? g2.current_conf : (Number.isFinite(g2.conf) ? g2.conf : NaN);
    setThresholdMeter("g2", g2conf, (g2.threshold != null ? g2.threshold : V.thr.g2min), !!g2.waiting);
  }

  var gateHistory = [];
  function gateScore(label, conf, suffix) {
    if (!label) return suffix || "—";
    return label + (Number.isFinite(conf) ? " " + Number(conf).toFixed(2) : "") + (suffix ? " · " + suffix : "");
  }

  function updateGateHistory(msg) {
    var body = el("all-gate-history");
    if (!body) return;
    var g1 = msg.g1 || {}, g2 = msg.g2 || {}, specs = msg.specialists || {};
    var g1name = g1.activation_label || g1.wake || g1.candidate || null;
    var g1conf = Number.isFinite(g1.activation_conf) ? g1.activation_conf : (Array.isArray(g1.probs) && g1.probs.length ? Math.max(g1.probs[0] || 0, g1.probs[1] || 0) : NaN);
    var g2name = g2.current_intent || g2.activation_intent || g2.intent || null;
    var g2conf = Number.isFinite(g2.current_conf) ? g2.current_conf : g2.conf;
    var g2thr = Number.isFinite(g2.threshold) ? g2.threshold : V.thr.g2min;
    var g2status = g2.waiting ? "wake first" : (Number.isFinite(g2conf) ? (g2conf >= g2thr ? "met" : "below") : "not run");
    var stampDate = msg.ts ? new Date(msg.ts) : new Date();
    if (!Number.isFinite(stampDate.getTime())) stampDate = new Date();
    var timestamp = new Intl.DateTimeFormat("en-GB", {hour: "2-digit", minute: "2-digit", second: "2-digit", hourCycle: "h23"}).format(stampDate);
    var row = {time:timestamp, g1:gateScore(g1name, g1conf, g1.active ? "active" : (g1.candidate ? "candidate" : "")),
      g2:gateScore(g2name, g2conf, g2status), g3:specs.gateN ? gateScore(specs.gateN.label, specs.gateN.conf, "") : "not run",
      g4:specs.gate4 ? gateScore(specs.gate4.label, specs.gate4.conf, "") : "not run",
      g5:specs.gate5 ? gateScore(specs.gate5.label, specs.gate5.conf, "") : "not run", routed:msg.spec ? msg.spec.gate : null, met:g2status === "met"};
    gateHistory.unshift(row);
    if (gateHistory.length > 6) gateHistory.pop();
    body.textContent = "";
    gateHistory.forEach(function (entry) {
      var tr = document.createElement("tr");
      ["time","g1","g2","g3","g4","g5"].forEach(function (key) {
        var td = document.createElement("td"); td.textContent = entry[key];
        if (key === "g2") td.classList.add(entry.met ? "met" : "miss");
        if ((key === "g3" && entry.routed === "gateN") || (key === "g4" && entry.routed === "gate4") || (key === "g5" && entry.routed === "gate5")) td.classList.add("route");
        tr.appendChild(td);
      });
      body.appendChild(tr);
    });
  }

  // --- Embedded VCM Room Simulation State & Logic ---
  var BULB_COLORS = {'warm white':'#ffe27a',white:'#fff2cc',red:'#ff6b6b',green:'#57d18f',blue:'#69aefc',yellow:'#ffd75e',purple:'#c792ea',pink:'#ff88b7',orange:'#ffad66',cyan:'#64d8e6'};
  var S = {playing:false, track:1, vol:50, bright:0, on:false, color:'#ffe27a', colorName:'warm white', temp:22, timerEnd:0, reminders:[], logs:[], persona:'nova'};
  var voiceAudio = new Audio();
  var musicAudio = new Audio();
  var callAudio = new Audio();
  musicAudio.loop = true;
  var lastRoomActionKey = '';
  var lastWakeKey = '';

  function togglePersona() {
    S.persona = (S.persona === 'nova') ? 'piattos' : 'nova';
    var isN = (S.persona === 'nova');
    var lbl = el('lbl-persona');
    if (lbl) {
      lbl.textContent = isN ? 'Nova ♀' : 'Piattos ♂';
      lbl.style.color = isN ? '#58a6ff' : '#f0883e';
    }
  }

  function speakOffline(text, persona, onDone) {
    if (!window.speechSynthesis || !window.SpeechSynthesisUtterance) return false;
    var voices = window.speechSynthesis.getVoices().filter(function(v) { return v.localService !== false; });
    if (!voices.length) return false;
    var p = (persona || S.persona || 'nova').toLowerCase();
    var preferred = p === 'nova' ? /zira|female|susan|aria|jenny/i : /david|male|mark|guy/i;
    var voice = voices.find(function(v) { return preferred.test(v.name); }) || voices.find(function(v) { return /^en/i.test(v.lang); }) || voices[0];
    var utterance = new SpeechSynthesisUtterance(text);
    utterance.voice = voice;
    utterance.lang = voice.lang || 'en-US';
    var finished = false;
    function finish() { if (!finished) { finished = true; if (onDone) onDone(); } }
    utterance.onend = finish;
    utterance.onerror = finish;
    try { window.speechSynthesis.cancel(); window.speechSynthesis.speak(utterance); return true; }
    catch (e) { return false; }
  }

  function playVoice(intent, persona, onDone, responseUrl, dynamicText) {
    if (dynamicText && speakOffline(dynamicText, persona, onDone)) return;
    var p = (persona || S.persona || 'nova').toLowerCase();
    var i = String(intent || '').toLowerCase();
    var url1 = responseUrl || ('/assistant-responses/resp_' + p + '_' + i + '_1.wav');
    var url2 = responseUrl ? responseUrl.replace(/_1\.wav$/, '_2.wav') : ('/assistant-responses/resp_' + p + '_' + i + '_2.wav');
    var finished = false, triedFallback = false;
    function finish() { if (!finished) { finished = true; if (onDone) onDone(); } }
    function attempt(url) {
      voiceAudio.onended = finish;
      voiceAudio.onerror = function() {
        if (!triedFallback && url2 !== url1) { triedFallback = true; attempt(url2); }
        else finish();
      };
      voiceAudio.src = url;
      var pb = voiceAudio.play();
      if (pb && pb.catch) pb.catch(function() {
        if (!triedFallback && url2 !== url1) { triedFallback = true; attempt(url2); }
        else finish();
      });
    }
    attempt(url1);
  }

  function parseNum(s) { var m = /([0-9]+)/.exec(String(s||'')); return m ? parseInt(m[1], 10) : null; }

  function setBulb() {
    var b = el('bulb'); var lamp = el('nslamp'); var on = S.on && S.bright > 0;
    if (b) {
      b.style.setProperty('--bright', (S.bright / 100).toFixed(2));
      b.style.setProperty('--bulb-color', S.color);
      b.classList.toggle('on', on);
    }
    if (lamp) {
      var lampOn = on && S.bright >= 40;
      lamp.classList.toggle('on', lampOn);
    }
  }

  function setMusic() {
    var mb = el('musicbox'); if (mb) mb.classList.toggle('playing', S.playing);
    var vb = el('volbar'); if (vb) vb.style.width = S.vol + '%';
    var trk = el('track');
    if (trk) trk.textContent = LOFI_TRACKS[S.track - 1].replace('.mp3', '') + ' · ' + (S.playing ? 'playing' : 'paused');
  }

  function setTemp() {
    var p = Math.max(0, Math.min(100, (S.temp - 16) / 16 * 100));
    var tn = el('tempnum'); if (tn) tn.textContent = S.temp;
    var tb = el('tempbar'); if (tb) tb.style.height = p + '%';
  }

  function showRoomPanel(id, txt) {
    var p = el(id); if (!p) return;
    p.style.display = 'block';
    if (txt !== undefined) {
      if (id === 'p-msg') { var m = el('msgtext'); if (m) m.textContent = txt; }
      else if (id === 'p-info') { var info = el('infotext'); if (info) info.textContent = txt; }
      else if (id === 'p-alarm') { var al = el('alarmset'); if (al) al.textContent = txt; }
      else if (id === 'p-call') { var cs = el('callstate'); if (cs) cs.textContent = txt; }
    }
  }

  function hideRoomPanel(id) { var p = el(id); if (p) p.style.display = 'none'; }

  function currentTimeText() { return new Date().toLocaleTimeString([], {hour:'numeric', minute:'2-digit'}); }

  function responseText(intent, value) {
    var v = String(value || '').trim();
    switch (intent) {
      case 'LIGHT_ON': return 'Turning the lights on.';
      case 'LIGHT_OFF': return 'Turning the lights off.';
      case 'BRIGHTNESS': return 'Setting brightness to ' + (v || S.bright + ' percent') + '.';
      case 'COLOR': return 'Changing the light color to ' + (v || 'warm white') + '.';
      case 'TEMPERATURE': return 'Setting the temperature to ' + (v || S.temp + ' degrees') + '.';
      case 'PLAY_MUSIC': return 'Playing music: ' + LOFI_TRACKS[S.track - 1].replace('.mp3', '') + '.';
      case 'PAUSE': return 'Pausing the music.';
      case 'NEXT': return 'Playing the next track.';
      case 'PREV': return 'Playing the previous track.';
      case 'VOLUME_UP': return 'Volume increased to ' + S.vol + ' percent.';
      case 'VOLUME_DOWN': return 'Volume lowered to ' + S.vol + ' percent.';
      case 'TIMER': return 'Timer started for ' + (v || '10 seconds') + '.';
      case 'ALARM': return 'Alarm set for ' + (v || '6 AM') + '.';
      case 'CREATE_REMINDER': return v ? 'Reminder set: ' + v + '.' : 'Reminder created.';
      case 'LIST_REMINDERS': return S.reminders.length ? 'Your reminders: ' + S.reminders.join(', ') + '.' : 'You have no reminders.';
      case 'CALL': return 'Calling now.';
      case 'MESSAGE': return v ? 'Sending your message: ' + v + '.' : 'Sending your message.';
      case 'STOP': return 'Stopped.';
      case 'WEATHER': return 'The demo weather is clear and 27 degrees.';
      case 'TIME': return 'The current time is ' + currentTimeText() + '.';
      case 'SEARCH': return 'Searching now.';
      default: return 'Command received: ' + String(intent || '').replace(/_/g, ' ').toLowerCase() + '.';
    }
  }

  function setSubtitle(text, persona) {
    var p = (persona || S.persona || 'nova').toLowerCase();
    var spk = el('room-subtitle-speaker');
    var txt = el('room-subtitle-text');
    if (spk) spk.textContent = (p === 'piattos' ? 'Piattos' : 'Nova') + ':';
    if (txt) txt.textContent = text;
  }

  function applyRoomAction(intent, slot, persona, response) {
    var v = slot && slot.label ? slot.label : '';
    var activePersona = persona || S.persona;
    var responseUrl = response && response.url ? response.url : null;
    var subtitle = (response && response.text) ? response.text : responseText(intent, v);
    setSubtitle(subtitle, activePersona);
    function say(onDone, dynamicText) { playVoice(intent, activePersona, onDone || null, responseUrl, dynamicText || ''); }

    if (intent === 'LIGHT_ON') { S.on = true; S.bright = 100; setBulb(); say(); }
    else if (intent === 'LIGHT_OFF') { S.on = false; setBulb(); say(); }
    else if (intent === 'BRIGHTNESS') { S.on = true; S.bright = parseNum(v) || S.bright; setBulb(); say(); }
    else if (intent === 'TEMPERATURE') { S.temp = parseNum(v) || S.temp; setTemp(); say(); }
    else if (intent === 'COLOR') {
      var requested = String(v || 'warm white').trim().toLowerCase();
      var colorKey = Object.keys(BULB_COLORS).find(function(name) { return requested === name || requested.includes(name); });
      if (colorKey) S.color = BULB_COLORS[colorKey];
      else if (/^#[0-9a-f]{6}$/i.test(requested)) S.color = requested;
      else S.color = BULB_COLORS['warm white'];
      S.colorName = colorKey || requested; S.on = true; if (!S.bright) S.bright = 100; setBulb(); say();
    }
    else if (intent === 'PLAY_MUSIC') {
      callAudio.pause(); callAudio.currentTime = 0; hideRoomPanel('p-call'); var pc = el('p-call'); if (pc) pc.classList.remove('ring');
      var tName = LOFI_TRACKS[S.track - 1];
      var trk = el('track'); if (trk) trk.textContent = tName.replace('.mp3', '') + ' · loading…';
      say(function() {
        musicAudio.src = '/media/lofiradio/' + tName;
        musicAudio.volume = S.vol / 100;
        musicAudio.play().catch(function() {});
        S.playing = true; setMusic();
      });
    }
    else if (intent === 'PAUSE') {
      musicAudio.pause(); S.playing = false; setMusic(); say();
    }
    else if (intent === 'NEXT') {
      S.track = (S.track % LOFI_TRACKS.length) + 1;
      var tName = LOFI_TRACKS[S.track - 1];
      say(function() {
        musicAudio.src = '/media/lofiradio/' + tName;
        musicAudio.volume = S.vol / 100;
        musicAudio.play().catch(function() {});
        S.playing = true; setMusic();
      });
    }
    else if (intent === 'PREV') {
      S.track = S.track > 1 ? S.track - 1 : LOFI_TRACKS.length;
      var tName = LOFI_TRACKS[S.track - 1];
      say(function() {
        musicAudio.src = '/media/lofiradio/' + tName;
        musicAudio.volume = S.vol / 100;
        musicAudio.play().catch(function() {});
        S.playing = true; setMusic();
      });
    }
    else if (intent === 'VOLUME_UP') {
      S.vol = Math.min(100, S.vol + 20); musicAudio.volume = S.vol / 100; setMusic(); say();
    }
    else if (intent === 'VOLUME_DOWN') {
      S.vol = Math.max(0, S.vol - 20); musicAudio.volume = S.vol / 100; setMusic(); say();
    }
    else if (intent === 'TIMER') {
      var n = parseNum(v) || 10; S.timerEnd = Date.now() + ((v && /minute/i.test(v)) ? n * 60 : n) * 1000;
      showRoomPanel('p-timer'); say();
    }
    else if (intent === 'ALARM') { showRoomPanel('p-alarm', v || '6 AM'); say(); }
    else if (intent === 'CREATE_REMINDER') {
      S.reminders.unshift(v || 'reminder'); S.reminders = S.reminders.slice(0, 5);
      var rl = el('remlist');
      if (rl) {
        rl.textContent = '';
        S.reminders.forEach(function(r) { var li = document.createElement('li'); li.textContent = r; rl.appendChild(li); });
      }
      showRoomPanel('p-remind'); say();
    }
    else if (intent === 'LIST_REMINDERS') { showRoomPanel('p-remind'); say(); }
    else if (intent === 'CALL') {
      if (S.playing) musicAudio.pause();
      var ringSound = CALL_SOUNDS[Math.floor(Math.random() * CALL_SOUNDS.length)];
      var rName = ringSound.replace('.mp3', '').replace(/^[0-9]+_/, '').replace(/_/g, ' ');
      showRoomPanel('p-call', 'calling… (' + activePersona + ')');
      say(function() {
        callAudio.src = '/media/call-sounds/' + ringSound;
        callAudio.play().catch(function() {});
        showRoomPanel('p-call', 'ringing… 📞 ' + rName);
        var pc = el('p-call'); if (pc) pc.classList.add('ring');
        callAudio.onended = function() {
          hideRoomPanel('p-call'); if (pc) pc.classList.remove('ring');
          if (S.playing) musicAudio.play().catch(function() {});
        };
        setTimeout(function() {
          callAudio.pause(); callAudio.currentTime = 0;
          hideRoomPanel('p-call'); if (pc) pc.classList.remove('ring');
          if (S.playing) musicAudio.play().catch(function() {});
        }, 9000);
      });
    }
    else if (intent === 'MESSAGE') { showRoomPanel('p-msg', v || 'new message'); say(); }
    else if (intent === 'STOP') {
      musicAudio.pause(); musicAudio.currentTime = 0;
      callAudio.pause(); callAudio.currentTime = 0;
      hideRoomPanel('p-call'); var pc = el('p-call'); if (pc) pc.classList.remove('ring');
      S.playing = false; setMusic(); say();
    }
    else if (intent === 'WEATHER') { showRoomPanel('p-info', 'Clear · 27°C (demo)'); say(); }
    else if (intent === 'TIME') { var nt = currentTimeText(); showRoomPanel('p-info', nt); say(null, subtitle); }
    else if (intent === 'SEARCH') { showRoomPanel('p-info', 'searching…'); say(); }
  }

  // --- Actions Play/Stop switch (main window) ---
  // Stopped = detection keeps running (gates, meters, gantt) but the pipeline
  // executes NO actions and plays NO voice — practice and record in peace.
  var ACTIONS_PLAYING = (function () {
    try { return (localStorage.getItem("vcmActions") || "playing") !== "stopped"; } catch (e) { return true; }
  })();
  function setActionsPlaying(on) {
    ACTIONS_PLAYING = on;
    try { localStorage.setItem("vcmActions", on ? "playing" : "stopped"); } catch (e) {}
    window.ACTIONS_PLAYING = on;
    var b = el("all-actions-toggle");
    if (b) {
      b.textContent = on ? "⏸ Stop actions" : "▶ Play actions";
      b.style.background = on ? "#21262d" : "#b62324";
      b.style.borderColor = on ? "var(--line)" : "#f85149";
      b.title = on
        ? "Stop the pipeline's ACTION execution (lights, music, calls, voice). Detection keeps running — practice and record without triggering anything."
        : "Resume action execution — live triggers will work again.";
    }
    var warn = el("rf-actwarn");
    if (warn) warn.style.display = on ? "inline" : "none";
  }
  (function () {
    var b = el("all-actions-toggle");
    if (b) b.addEventListener("click", function () { setActionsPlaying(!ACTIONS_PLAYING); });
    setActionsPlaying(ACTIONS_PLAYING);
  })();
  function updateRoomSim(m) {
    if (m.g1) {
      var wl = m.g1.activation_label || m.g1.wake;
      if (wl) S.persona = wl.toLowerCase();
      var g1Text = 'idle';
      if (m.g1.active) g1Text = (wl || 'wake') + ' ' + Number(m.g1.remaining_s || 0).toFixed(0) + 's';
      var g1s = el('g1s'); if (g1s) g1s.textContent = g1Text;
    }
    if (m.g2) {
      var ci = m.g2.current_intent || m.g2.intent;
      var g2Text = ci || 'idle';
      if (m.g2.active) g2Text = (m.g2.activation_intent || ci || '—') + ' ' + Number(m.g2.remaining_s || 0).toFixed(0) + 's';
      var g2s = el('g2s'); if (g2s) g2s.textContent = g2Text;
    }
    var ag = m.action_gate || {};
    if (ag.triggered && ag.intent) {
      var key = String(ag.event_id || 0);
      if (key !== lastRoomActionKey) {
        lastRoomActionKey = key;
        if (!ACTIONS_PLAYING) {
          var vs = el("all-voice-status");
          if (vs) { vs.textContent = "⏸ Actions stopped — detection only (" + ag.intent + ")"; vs.style.color = "#f0883e"; }
        } else {
          applyRoomAction(ag.intent, m.spec, S.persona, m.assistant_response);
        }
      }
    }
  }
  window.updateRoomSim = updateRoomSim;   // probe/introspection handle

  function resetClientState() {
    musicAudio.pause(); musicAudio.currentTime = 0;
    callAudio.pause(); callAudio.currentTime = 0;
    voiceAudio.pause(); voiceAudio.currentTime = 0;
    dashMusicAudio.pause(); dashMusicAudio.currentTime = 0;
    dashCallAudio.pause(); dashCallAudio.currentTime = 0;
    S.playing = false; S.on = false; S.bright = 0; S.temp = 22; S.timerEnd = 0;
    setBulb(); setMusic(); setTemp();
    hideRoomPanel('p-timer'); hideRoomPanel('p-alarm'); hideRoomPanel('p-remind');
    hideRoomPanel('p-call'); hideRoomPanel('p-msg'); hideRoomPanel('p-info');
    var pc = el('p-call'); if (pc) pc.classList.remove('ring');
    lastWakeKey = '';
    setSubtitle('Pipeline reset complete. Ready for wake word.', S.persona);
    ganttEvents = [];
    drawGanttChart();
  }
  window.resetRoomSim = resetClientState;

  // --- Gate 1 & Gate 2 Gantt Chart ---
  var ganttEvents = [];
  function recordGanttEvent(gate, label, conf, active, remaining_s) {
    if (!active || !label) return;
    var nowMs = Date.now();
    var durMs = Math.max(1000, (remaining_s && remaining_s > 0 ? remaining_s : (gate === 'g1' ? 8 : 4)) * 1000);
    var found = null;
    for (var i = ganttEvents.length - 1; i >= 0; i--) {
      var e = ganttEvents[i];
      if (e.gate === gate && e.label === label && (nowMs - e.end) < 2200) {
        found = e;
        break;
      }
    }
    if (found) {
      found.end = Math.max(found.end, nowMs + Math.min(durMs, 3000));
    } else {
      var col = gate === 'g1' ? (label === 'Piattos' ? '#f0883e' : '#3fb950') : '#d29922';
      ganttEvents.push({
        gate: gate,
        start: nowMs,
        end: nowMs + Math.min(durMs, 3500),
        label: label,
        conf: conf,
        color: col
      });
    }
    while (ganttEvents.length > 0 && (nowMs - ganttEvents[0].end) > 60000) {
      ganttEvents.shift();
    }
  }

  function drawGanttChart() {
    var canvas = el("all-gantt-chart");
    if (!canvas) return;
    var ctx = canvas.getContext("2d");
    var w = canvas.width, h = canvas.height;
    var nowMs = Date.now();
    var SPAN_MS = 30000;
    var startMs = nowMs - SPAN_MS;

    ctx.fillStyle = "#0d1117";
    ctx.fillRect(0, 0, w, h);

    var labelW = 44;
    var plotW = w - labelW - 6;

    // G1 Wake track
    var g1Y = 3, g1H = 22;
    ctx.fillStyle = "#161b22";
    ctx.fillRect(labelW, g1Y, plotW, g1H);
    ctx.fillStyle = "#8b949e";
    ctx.font = "9px 'Segoe UI',Arial,sans-serif";
    ctx.textBaseline = "middle";
    ctx.fillText("G1 Wake", 3, g1Y + g1H / 2);

    // G2 Intent track
    var g2Y = 28, g2H = 22;
    ctx.fillStyle = "#161b22";
    ctx.fillRect(labelW, g2Y, plotW, g2H);
    ctx.fillStyle = "#8b949e";
    ctx.fillText("G2 Intent", 3, g2Y + g2H / 2);

    // Gridlines every 5s
    ctx.strokeStyle = "#252c34";
    ctx.lineWidth = 1;
    ctx.fillStyle = "#6e7681";
    ctx.font = "8px 'Segoe UI',Arial,sans-serif";
    ctx.textBaseline = "top";
    for (var s = 5; s <= 30; s += 5) {
      var gx = labelW + plotW * (1 - s / 30);
      ctx.beginPath();
      ctx.moveTo(gx, 2);
      ctx.lineTo(gx, 52);
      ctx.stroke();
      ctx.fillText("-" + s + "s", gx - 7, 54);
    }
    // NOW line
    var nowX = labelW + plotW;
    ctx.strokeStyle = "#3fb950";
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    ctx.moveTo(nowX, 2);
    ctx.lineTo(nowX, 52);
    ctx.stroke();
    ctx.fillStyle = "#3fb950";
    ctx.fillText("NOW", nowX - 19, 54);

    // Draw blocks
    for (var i = 0; i < ganttEvents.length; i++) {
      var ev = ganttEvents[i];
      if (ev.end < startMs || ev.start > nowMs) continue;
      var x1 = labelW + plotW * Math.max(0, (ev.start - startMs) / SPAN_MS);
      var x2 = labelW + plotW * Math.min(1, (ev.end - startMs) / SPAN_MS);
      var bw = Math.max(4, x2 - x1);
      var by = ev.gate === 'g1' ? g1Y : g2Y;
      var bh = ev.gate === 'g1' ? g1H : g2H;

      ctx.fillStyle = ev.color;
      ctx.globalAlpha = 0.85;
      ctx.fillRect(x1 + 1, by + 2, bw - 2, bh - 4);
      ctx.strokeStyle = "#ffffff";
      ctx.lineWidth = 1;
      ctx.strokeRect(x1 + 1, by + 2, bw - 2, bh - 4);

      if (bw > 22) {
        ctx.globalAlpha = 1.0;
        ctx.fillStyle = "#ffffff";
        ctx.font = "bold 8.5px 'Segoe UI',Arial,sans-serif";
        ctx.textBaseline = "middle";
        var txt = ev.label;
        if (ev.conf && ev.conf > 0) {
          txt += " " + (ev.conf >= 1 ? ev.conf.toFixed(1) : (ev.conf * 100).toFixed(0) + "%");
        }
        ctx.save();
        ctx.rect(x1 + 2, by + 2, bw - 4, bh - 4);
        ctx.clip();
        ctx.fillText(txt, x1 + 3, by + bh / 2);
        ctx.restore();
      }
      ctx.globalAlpha = 1.0;
    }
  }

  V.onServerMessage = function (msg) {
    if (!msg || typeof msg !== "object") return;
    if (msg.type === "pipe") {
      if (window.VCMPIPE2) VCMPIPE2.update(msg);
      var sched = msg.memory && msg.memory.scheduler ? msg.memory.scheduler : {};
      var schedEl = document.getElementById("all-scheduler-status");
      if (schedEl) {
        var skTxt = (sched.skip_ticks_enabled || V.skipTicksOn) ? "ON" : "OFF";
        var late = !!sched.late;
        var drift = Number(sched.drift_s || 0);
        schedEl.textContent = Number(sched.interval_s || V.intervalSeconds || 1) + " s evaluation · eval " + Number(sched.eval_ms || 0) + " ms" + (late ? " · ⚠ DELAYED" : "") + " · skipped_ticks " + Number(sched.skipped_ticks || 0) + " (" + skTxt + ") · 20-second recording buffer" + (drift > 0.4 ? " · behind realtime +" + drift.toFixed(1) + "s" : "");
        schedEl.classList.toggle("delayed", late || drift > 2);
        var logEl = document.getElementById("all-skipped-log");
        if (logEl) {
          var log = sched.skipped_log || [];
          if (log.length) {
            logEl.style.display = "block";
            logEl.textContent = "skipped audio windows: " + log.map(function (s) { return s.wall + " (+" + s.gap + "s)"; }).join(" · ") + " — consider a longer evaluation cadence";
          } else {
            logEl.style.display = "none";
            logEl.textContent = "";
          }
        }
      }

      // Record Gantt triggers
      if (msg.g1) {
        var g1Act = !!msg.g1.active;
        var g1Lbl = msg.g1.activation_label || msg.g1.wake;
        if (g1Act && g1Lbl) {
          recordGanttEvent('g1', g1Lbl, msg.g1.activation_conf || msg.g1.conf, true, msg.g1.remaining_s);
        }
      }
      if (msg.g2) {
        var g2Act = !!msg.g2.active;
        var g2Int = msg.g2.activation_intent || msg.g2.intent;
        if (g2Act && g2Int && g2Int !== "NEGATIVE") {
          recordGanttEvent('g2', g2Int, msg.g2.activation_conf || msg.g2.conf, true, msg.g2.remaining_s);
        }
      }
      if (msg.action_gate && msg.action_gate.triggered && msg.action_gate.intent) {
        recordGanttEvent('g2', msg.action_gate.intent, 1.0, true, 4);
      }
      drawGanttChart();

      // Update embedded room simulation
      updateRoomSim(msg);

      if (msg.wake_response && msg.wake_response.url) {
        var wakeKey = String(msg.wake_response.event_id || 0);
        if (wakeKey !== lastWakeKey) {
          lastWakeKey = wakeKey;
          var wakePersona = msg.wake_response.persona || S.persona;
          var wakeText = msg.wake_response.text || 'wake';
          setSubtitle(wakeText, wakePersona);
          var wakeStatus = document.getElementById("all-voice-status");
          if (wakeStatus) {
            wakeStatus.textContent = "🔊 wake · " + wakeText + " (" + msg.wake_response.url.split("/").pop() + ")";
            wakeStatus.style.color = "#58a6ff";
          }
          if (!ACTIONS_PLAYING) {
            var wsv = document.getElementById("all-voice-status");
            if (wsv) { wsv.textContent = "⏸ Actions stopped — wake detected, voice held (" + wakeText + ")"; wsv.style.color = "#f0883e"; }
          } else if (!msg.wake_response.room_active) {
            playVoice("wake", wakePersona, null, msg.wake_response.url, "");
          }
        }
      }
      if (msg.assistant_response && msg.assistant_response.room_active) {
        var roomVoiceStatus = document.getElementById("all-voice-status");
        if (roomVoiceStatus) { roomVoiceStatus.textContent = "🔊 Room simulator is handling voice and media"; roomVoiceStatus.style.color = "#3fb950"; }
      } else if (msg.assistant_response && msg.assistant_response.url) {
        var vEl = document.getElementById("all-voice-status");
        var respIntent = msg.assistant_response.intent;
        var clipFile = msg.assistant_response.url.split("/").pop();
        if (vEl) { vEl.textContent = "🔊 " + respIntent + " (" + clipFile + ")"; vEl.style.color = "#3fb950"; }
      }
      if (msg.g2 && msg.g2.threshold != null) lastG2Thr = Number(msg.g2.threshold);
      pushThr(msg);
      updateThresholdMeters(msg);
      updateGateHistory(msg);
      updateDiagram(msg);
      drawThrChart();
    } else if (msg.type === "interval") {
      if (msg.interval_s) {
        V.intervalSeconds = Number(msg.interval_s);
        var intSel = el("all-interval");
        if (intSel) intSel.value = String(V.intervalSeconds);
      }
    } else if (msg.type === "skip_ticks") {
      if (typeof msg.enabled === "boolean") {
        V.skipTicksOn = msg.enabled;
        var skBtn = el("all-skip-ticks");
        if (skBtn) {
          skBtn.textContent = "Skipped ticks: " + (V.skipTicksOn ? "ON" : "OFF");
          skBtn.style.color = V.skipTicksOn ? "var(--amber)" : "var(--muted)";
        }
      }
    } else if (msg.type === "ticker_error") {
      setStatus("trigger pipeline restarted after error: " + (msg.error || "unknown"), true);
    } else if (msg.type === "capture_saved") {
      var save30 = el("pipe2ownervoiceSave30");
      if (save30) { save30.disabled = false; save30.textContent = "⏺ Save last 30 s"; }
      var cap = el("pipe2-ownervoice-capture");
      if (cap) {
        cap.textContent = "";
        if (msg.error) {
          cap.textContent = msg.error;
          cap.style.color = "#ff7b72";
        } else {
          var rec = msg.recording || {};
          cap.style.color = "#3fb950";
          cap.textContent = "Saved " + rec.duration_s + " s → ";
          var labLink = document.createElement("a");
          labLink.href = "/recording_lab.html?rec=" + rec.id;
          labLink.textContent = "Recording Lab (test all models)";
          cap.appendChild(labLink);
        }
      }
    } else if (msg.type === "reset") {
      resetClientState();
    } else if (msg.type === "calibrated" && msg.thr) {
      if (typeof msg.thr.Nova === "number") V.thr.nova = msg.thr.Nova;
      if (typeof msg.thr.Piattos === "number") V.thr.piattos = msg.thr.Piattos;
      syncSliders();
      pushThr();
      drawThrChart();
    } else if (msg.type === "g2model" && msg.model) {
      var sel = el("all-g2model");
      if (sel) {
        for (var i = 0; i < sel.options.length; i++) {
          if (sel.options[i].value === msg.model) { sel.value = msg.model; break; }
        }
      }
    } else if (msg.type === "arch" && typeof msg.arch === "number") {
      var archSel = el("all-arch");
      if (archSel) archSel.value = String(msg.arch);
      setStageLabels();
    } else if (msg.type === "status" && msg.text) {
      var elStatus = el("status");
      if (elStatus) elStatus.textContent = msg.text;
    }
  };

  // --- Benchmark gantt (top-right toggle): saved runs, one lane set per
  // (Gate 1, Gate 2) combination, drawn from the persisted result files. ---
  var benchMode = false;
  var RF_ALIAS = { settimer: "timer", alarmset: "alarm", tempup: "temperature", tempdown: "temperature", lightsdim: "brightness", lightsbright: "brightness", lightson: "lighton", lightsoff: "lightoff", reminderset: "createreminder", remindercheck: "listreminders", checkreminders: "listreminders", mediaplay: "playmusic", mediapause: "pause", medianext: "next", silence: "stop" };
  function rfBag(s) {
    return String(s || "").toLowerCase().split(/[^a-z]+/).filter(Boolean).sort().join("");
  }
  function rfAlias(b) {
    return RF_ALIAS[b] || b;
  }
  function benchSummary(job) {
    var box = el("all-bench-summary");
    if (!box || !job) return;
    box.textContent = "";
    var wait = document.createElement("div");
    wait.style.cssText = "font-size:10px;color:#8b949e;";
    wait.textContent = "Combination summary: loading take tags…";
    box.appendChild(wait);
    fetch("/api/recordings").then(function (r) { return r.json(); }).then(function (d) {
      var rec = null;
      (d.recordings || []).forEach(function (r) { if (r.id === job.recording) rec = r; });
      var expWake = rec ? String(rec.wake_word || "").trim() : "";
      var expAct = rec ? String(rec.action || "").trim() : "";
      box.textContent = "";
      var head = document.createElement("div");
      head.style.cssText = "font-size:11px;font-weight:700;color:#58a6ff;margin:2px 0 4px;";
      head.textContent = "Combination summary — expected wake: " + (expWake || "—") + " · expected action: " + (expAct || "—");
      box.appendChild(head);
      var g1ByLane = {};
      (job.events || []).forEach(function (e) {
        if (e.kind !== "g1") return;
        var k = (e.g1_model || "") + "|" + (e.model || "") + "|" + (e.nc ? 1 : 0) + "|" + (e.arch === undefined ? (e.gated ? 1 : 0) : e.arch);
        (g1ByLane[k] = g1ByLane[k] || []).push(e);
      });
      var rows = (job.summaries || []).map(function (s) {
        var key = (s.g1_model || "") + "|" + (s.model || "") + "|" + (s.nc ? 1 : 0) + "|" + (s.arch === undefined ? (s.gated ? 1 : 0) : s.arch);
        var fired = expWake ? (g1ByLane[key] || []).filter(function (e) { return rfBag(e.label) === rfBag(expWake); }) : [];
        var g1ok = expWake ? (fired.length > 0) : null;
        var matched = 0;
        if (expAct) {
          var eb = rfAlias(rfBag(expAct));
          Object.keys(s.intents || {}).forEach(function (k2) {
            if (rfAlias(rfBag(k2)) === eb) matched += (s.intents[k2] || 0);
          });
        }
        var g2ok = expAct ? (matched > 0) : null;
        var verdict;
        if (g1ok === null && g2ok === null) verdict = "na";
        else if (g1ok === false && g2ok === false) verdict = "none";
        else if (g2ok === false) verdict = "g2";
        else if (g1ok === false) verdict = "g1";
        else verdict = "ok";
        return { s: s, g1ok: g1ok, g1n: fired.length, g2ok: g2ok, matched: matched, ticks: (s.command_ticks || 0), verdict: verdict };
      });
      var order = { none: 0, g2: 1, g1: 2, na: 3, ok: 4 };
      rows.sort(function (a, b) {
        return (order[a.verdict] - order[b.verdict]) ||
          String(a.s.g1_model).localeCompare(String(b.s.g1_model)) ||
          String(a.s.model).localeCompare(String(b.s.model)) || (a.s.nc ? 1 : 0) - (b.s.nc ? 1 : 0);
      });
      var nOk = rows.filter(function (r) { return r.verdict === "ok"; }).length;
      var nG1 = rows.filter(function (r) { return r.g1ok === true; }).length;
      var nG2 = rows.filter(function (r) { return r.g2ok === true; }).length;
      var nNa = rows.filter(function (r) { return r.verdict === "na"; }).length;
      var missing = [];
      if (!expWake) missing.push("no wake tag");
      if (!expAct) missing.push("no action tag");
      var agg = document.createElement("div");
      agg.style.cssText = "font-size:11px;color:#e6edf3;margin-bottom:4px;";
      agg.textContent = rows.length + " lanes · fully correct " + nOk + " · Gate 1 correct " + nG1 + " · Gate 2 correct " + nG2 + " · not judgeable " + nNa + (missing.length ? " (" + missing.join(", ") + ")" : "");
      box.appendChild(agg);
      var tbl = document.createElement("table");
      tbl.style.cssText = "border-collapse:collapse;font-size:10px;width:100%;max-width:760px;";
      var thead = document.createElement("thead");
      var hr = document.createElement("tr");
      ["Combination", "Gate 1 (wake)", "Gate 2 (action)", "Latency", "Verdict"].forEach(function (t) {
        var th = document.createElement("th");
        th.style.cssText = "text-align:left;border-bottom:1px solid #30363d;padding:2px 6px;color:#8b949e;";
        th.textContent = t;
        hr.appendChild(th);
      });
      thead.appendChild(hr);
      tbl.appendChild(thead);
      var tbody = document.createElement("tbody");
      var CAP = 60;
      rows.slice(0, CAP).forEach(function (r) {
        var tr = document.createElement("tr");
        var archN = (r.s.arch === undefined ? (r.s.gated ? 1 : 0) : r.s.arch);
        var name = String(r.s.g1_model || "").replace("gate1", "") + " × " + String(r.s.model || "").replace("gate2", "") + (r.s.nc ? " · NC" : " · raw") + " · " + (archN === 2 ? "Arch v3" : archN === 1 ? "Arch v2" : "Arch v1");
        var g1txt = r.g1ok === null ? "—" : (r.g1ok ? "✓ fired " + r.g1n + "×" : "✗ no wake fire");
        var g2txt = r.g2ok === null ? "—" : (r.g2ok ? "✓ " + r.matched + "/" + r.ticks + " ticks" : "✗ top: " + (r.s.top_intent || "?"));
        var vtxt = r.verdict === "ok" ? "✓ correct" : (r.verdict === "na" ? "—" : (r.verdict === "none" ? "✗ both gates wrong" : (r.verdict === "g1" ? "✗ gate 1 wrong" : "✗ gate 2 wrong")));
        var vcol = r.verdict === "ok" ? "#3fb950" : (r.verdict === "na" ? "#6e7681" : "#f85149");
        var lat = (r.s.mean_infer_ms !== undefined) ? (Math.round(r.s.mean_infer_ms * 10) / 10) + " ms" : "—";
        [[name, "#e6edf3"], [g1txt, r.g1ok === false ? "#f85149" : (r.g1ok ? "#3fb950" : "#6e7681")], [g2txt, r.g2ok === false ? "#f85149" : (r.g2ok ? "#3fb950" : "#6e7681")], [lat, "#8b949e"], [vtxt, vcol]].forEach(function (pair) {
          var td = document.createElement("td");
          td.style.cssText = "padding:2px 6px;border-bottom:1px solid #21262d;color:" + pair[1] + ";";
          td.textContent = pair[0];
          tr.appendChild(td);
        });
        tbody.appendChild(tr);
      });
      tbl.appendChild(tbody);
      box.appendChild(tbl);
      if (rows.length > CAP) {
        var more = document.createElement("div");
        more.style.cssText = "font-size:10px;color:#8b949e;margin-top:3px;";
        more.textContent = "Showing first " + CAP + " of " + rows.length + " lanes (problem lanes first).";
        box.appendChild(more);
      }
    }).catch(function () {
      box.textContent = "";
      var err = document.createElement("div");
      err.style.cssText = "font-size:10px;color:#f85149;";
      err.textContent = "Combination summary failed to load take tags.";
      box.appendChild(err);
    });
  }
  function benchLabel(r) {
    // The results LISTING carries summaries, not combos, so count lanes from
    // whichever is present (NC A/B runs have one summary per lane, per mode).
    var lanes = (r.combos || []).length || (r.summaries || []).length;
    return String(r.created || "").replace("T", " ").slice(5, 16) + " · " + (r.label || r.recording) + " · " + lanes + " lane" + (lanes === 1 ? "" : "s");
  }
  function benchDraw(job) {
    var canvas = el("all-bench-chart");
    if (!canvas || !job) return;
    var ctx = canvas.getContext("2d");
    var combos = job.combos || [], dur = Math.max(1, job.duration_s || 1);
    var pps = 24, laneH = 18, blockH = 78, axisH = 22, left = 8;
    canvas.width = left + Math.ceil(dur * pps) + 60;
    canvas.height = axisH + combos.length * blockH + 8;
    canvas.style.width = canvas.width + "px";
    ctx.fillStyle = "#0d1117"; ctx.fillRect(0, 0, canvas.width, canvas.height);
    ctx.strokeStyle = "#30363d";
    for (var s = 0; s <= dur; s += 2) {
      var x = left + s * pps;
      ctx.strokeStyle = (s % 5 === 0) ? "#30363d" : "#21262d";
      ctx.beginPath(); ctx.moveTo(x, axisH - 6); ctx.lineTo(x, canvas.height); ctx.stroke();
      if (s % 5 === 0) {
        ctx.fillStyle = "#8b949e"; ctx.font = "10px Arial"; ctx.fillText(s + "s", x + 2, axisH - 9);
      }
    }
    var byCombo = {};
    var totalG1 = 0, totalG2 = 0;
    (job.events || []).forEach(function (e) {
      var k = (e.g1_model || "") + "|" + (e.model || "") + "|" + (e.nc ? 1 : 0) + "|" + (e.arch === undefined ? (e.gated ? 1 : 0) : e.arch);
      (byCombo[k] = byCombo[k] || []).push(e);
      if (e.kind === "g1") totalG1 += 1;
      else if (e.kind === "g2") totalG2 += 1;
    });
    combos.forEach(function (pair, i) {
      var key = pair[0] + "|" + pair[1] + "|" + (pair.length > 2 && pair[2] ? 1 : 0) + "|" + (pair.length > 3 ? pair[3] : 0);
      var y = axisH + i * blockH;
      var evs = byCombo[key] || [];
      var g1Count = 0, g2Count = 0;
      evs.forEach(function (ev) { if (ev.kind === "g1") g1Count += 1; else if (ev.kind === "g2") g2Count += 1; });
      ctx.fillStyle = "#e6edf3"; ctx.font = "bold 10px Arial";
      ctx.fillText(pair[0].replace("gate1", "") + " × " + pair[1].replace("gate2", "") +
        (pair.length > 2 ? (pair[2] ? " · NC on" : " · raw") : "") +
        (pair.length > 3 ? (pair[3] === 2 ? " · Arch v3" : pair[3] === 1 ? " · Arch v2" : " · Arch v1") : ""), left, y + 11);
      ctx.fillStyle = (g1Count + g2Count) > 0 ? "#3fb950" : "#6e7681"; ctx.font = "9px Arial";
      ctx.fillText("G1:" + g1Count + "  G2:" + g2Count, left + 150, y + 11);
      ["G1 Wake", "G2 Intent"].forEach(function (n, k2) {
        var ly = y + 16 + k2 * 22;
        ctx.fillStyle = "#161b22"; ctx.fillRect(left, ly, canvas.width - left - 6, laneH);
        ctx.strokeStyle = "#21262d"; ctx.strokeRect(left, ly, canvas.width - left - 6, laneH);
        ctx.fillStyle = "#6e7681"; ctx.font = "8px Arial"; ctx.fillText(n, left + 3, ly + 12);
      });
      evs.forEach(function (ev) {
        var x = left + ev.t * pps;
        if (ev.kind === "g1") {
          ctx.fillStyle = "#58a6ff"; ctx.fillRect(x, y + 16, Math.min(12 * pps, canvas.width - x - 6), laneH);
        } else if (ev.kind === "g2") {
          ctx.fillStyle = "#3fb950"; ctx.fillRect(x, y + 38, Math.min(8 * pps, canvas.width - x - 6), laneH);
          if (ev.label && pps > 18) {
            ctx.fillStyle = "#ffffff"; ctx.font = "8px Arial";
            ctx.fillText(ev.label + " " + Math.round((ev.conf || 0) * 100) + "%", x + 3, y + 51);
          }
        } else if (ev.kind === "g2-low") {
          ctx.fillStyle = "#6e7681"; ctx.fillRect(x, y + 38, 2, laneH);
        } else if (ev.kind === "g3") {
          ctx.fillStyle = "#f0883e"; ctx.fillRect(x, y + 38, 4, laneH);
        }
      });
    });
    var best = (job.summaries || []).slice().sort(function (a, b) { return (b.trigger_ticks || 0) - (a.trigger_ticks || 0); })[0];
    var info = el("all-bench-info");
    if (info) info.textContent = (job.label || "recording") + " · " + dur + " s · " + combos.length + " combinations" +
      (best && best.trigger_ticks ? " · best: " + (best.g1_model || "").replace("gate1", "") + " × " + (best.model || "").replace("gate2", "") + " (" + best.trigger_ticks + " triggers, " + (best.top_intent || "—") + ")" : " · no triggers recorded") +
      (totalG1 === 0 && totalG2 === 0 ? " · ⚠ no Gate 1 or Gate 2 activity — the audio has no wake-word speech. A tone/ringtone never triggers Gate 1: speak the wake word + intent, or test with a speech recording." : "");
  }
  function benchLoadResults() {
    fetch("/api/results").then(function (r) { return r.json(); }).then(function (d) {
      var sel = el("all-bench-results");
      if (!sel) return;
      sel.textContent = "";
      (d.results || []).forEach(function (r) {
        var o = document.createElement("option");
        o.value = r.id; o.textContent = benchLabel(r);
        sel.appendChild(o);
      });
      if (sel.options.length) { sel.selectedIndex = 0; benchOpen(sel.value); }
      else {
        var info = el("all-bench-info");
        if (info) info.textContent = "no saved runs yet — capture a take and run a test in the Recording Lab";
      }
    }).catch(function (e) { setStatus("benchmark results: " + e.message, true); });
  }
  function benchOpen(id) {
    fetch("/api/results/" + id).then(function (r) { return r.json(); }).then(function (d) { benchDraw(d.job); benchSummary(d.job); })
      .catch(function (e) { setStatus("benchmark open: " + e.message, true); });
  }
  var benchBtn = el("all-bench-toggle");
  if (benchBtn) benchBtn.addEventListener("click", function () {
    benchMode = !benchMode;
    var wrap = el("all-gantt-wrap"), view = el("all-bench-view");
    if (benchBtn) benchBtn.textContent = benchMode ? "📊 Live gantt" : "📊 Benchmark gantt";
    if (wrap) wrap.style.display = benchMode ? "none" : "block";
    if (view) view.style.display = benchMode ? "block" : "none";
    if (benchMode) benchLoadResults();
  });
  var benchRefresh = el("all-bench-refresh");
  if (benchRefresh) benchRefresh.addEventListener("click", benchLoadResults);
  var benchSel = el("all-bench-results");
  if (benchSel) benchSel.addEventListener("change", function () { benchOpen(benchSel.value); });

  function setStageLabels() {
    var lab = el("all-stage-g2-label");
    var sel = el("all-arch");
    if (!lab || !sel) return;
    var a = sel.value;
    lab.textContent = a === "0" ? "Gate 2 · all gates run"
      : a === "2" ? "Gate 2 · after wake + intent vote"
      : "Gate 2 · only after wake";
  }

  // --- Top-combination bookmarks (js/best_combo.js, refreshed by the batch analysis) ---
  function buildTopComboBookmarks() {
    var host = el("all-topcombos");
    if (!host) return;
    var combos = window.VCM_TOP_COMBOS || [];
    if (!combos.length) { host.style.display = "none"; return; }
    combos.slice(0, 5).forEach(function (b, i) {
      var btn = document.createElement("button");
      btn.style.cssText = "background:#21262d;color:#c9d1d9;border:1px solid #30363d;border-radius:5px;padding:3px 8px;cursor:pointer;font-size:10px;";
      btn.textContent = "\u2605" + (i + 1) + " " + String(b.g1 || "").replace("gate1", "G1") + " \u00d7 " + String(b.g2 || "").replace("gate2", "G2") + " \u00b7 " + (b.nc ? "NC" : "raw") + " \u00b7 v" + ((b.arch || 0) + 1);
      btn.title = "full " + (b.full || "?") + " (" + (b.rate || "?") + "%) \u00b7 action " + (b.act || "?") + "% \u00b7 wake " + (b.wake || "?") + "% \u00b7 OOS reject " + (b.oos_rej || "?") + "% \u00b7 p95 " + (b.p95 || "?") + " ms \u2014 click to apply these settings";
      btn.addEventListener("click", function () { applyTopComboBookmark(b, btn); });
      host.appendChild(btn);
    });
  }
  function bmStatus(msg) {
    var st = el("all-topcombos-status");
    if (st) st.textContent = msg;
  }
  function applyTopComboBookmark(b, btn) {
    var V = window.VCMALL;
    if (!V || !V.send) { bmStatus("waiting for the live connection \u2014 then click the bookmark again"); return; }
    var applied = [];
    var g1 = el("all-g1model");
    if (g1 && b.g1 && g1.value !== b.g1) { g1.value = b.g1; V.send({ type: "model", model: b.g1 }); applied.push("G1 " + String(b.g1).replace("gate1", "")); }
    var g2 = el("all-g2model");
    if (g2 && b.g2 && g2.value !== b.g2) { g2.value = b.g2; V.send({ type: "g2model", model: b.g2 }); applied.push("G2 " + String(b.g2).replace("gate2", "")); }
    var archSel = el("all-arch");
    if (archSel && typeof b.arch === "number" && archSel.value !== String(b.arch)) { archSel.value = String(b.arch); V.send({ type: "arch", arch: b.arch }); setStageLabels(); applied.push("arch v" + (b.arch + 1)); }
    var ncBtn = el("all-noise-canceller");
    if (ncBtn && typeof b.nc === "boolean" && b.nc !== V.ncOn) {
      V.ncOn = b.nc;
      ncBtn.textContent = "Noise canceller: " + (V.ncOn ? "ON" : "OFF");
      ncBtn.style.borderColor = V.ncOn ? "#3fb950" : "";
      V.send({ type: "noise_canceller", enabled: V.ncOn });
      applied.push(V.ncOn ? "NC on" : "NC off");
    }
    var strip = el("all-topcombos");
    if (strip) {
      var kids = strip.querySelectorAll("button");
      for (var k = 0; k < kids.length; k++) kids[k].style.borderColor = "#30363d";
    }
    if (btn) btn.style.borderColor = "#3fb950";
    bmStatus("\u2605 applied: " + (applied.length ? applied.join(" \u00b7 ") : "already active \u2014 this combination is running"));
  }
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", function () { buildTopComboBookmarks(); });
  } else {
    buildTopComboBookmarks();
  }

  function bindControls() {
    var g1 = el("all-g1model");
    if (g1) g1.addEventListener("change", function () { V.send({ type: "model", model: g1.value }); });
    var g2 = el("all-g2model");
    if (g2) g2.addEventListener("change", function () { V.send({ type: "g2model", model: g2.value }); });
    var archSel = el("all-arch");
    if (archSel) archSel.addEventListener("change", function () {
      V.send({ type: "arch", arch: Number(archSel.value) });
      setStageLabels();
    });
    setStageLabels();
    var cal = el("all-calibrate");
    if (cal) cal.addEventListener("click", function () { V.send({ type: "calibrate", seconds: 10 }); });
    var stopBtn = el("all-stop-action");
    if (stopBtn) stopBtn.addEventListener("click", function () {
      dashMusicAudio.pause(); dashMusicAudio.currentTime = 0;
      dashCallAudio.pause(); dashCallAudio.currentTime = 0;
      musicAudio.pause(); musicAudio.currentTime = 0;
      callAudio.pause(); callAudio.currentTime = 0;
      if (V.send) V.send({ type: "manual_stop" });
    });
    var save30 = el("pipe2ownervoiceSave30");
    if (save30) save30.addEventListener("click", function () {
      if (!V.send) return;
      save30.disabled = true;
      save30.textContent = "Saving…";
      V.send({ type: "save_capture", label: "live30-" + new Date().toTimeString().slice(0, 8).replace(/:/g, "") });
      setTimeout(function () {
        if (save30.disabled) { save30.disabled = false; save30.textContent = "⏺ Save last 30 s"; }
      }, 8000);
    });
    var ncBtn = el("all-noise-canceller");
    if (ncBtn) {
      ncBtn.addEventListener("click", function () {
        V.ncOn = !V.ncOn;
        ncBtn.textContent = "Noise canceller: " + (V.ncOn ? "ON" : "OFF");
        ncBtn.style.borderColor = V.ncOn ? "#3fb950" : "";
        if (V.send) V.send({ type: "noise_canceller", enabled: V.ncOn });
      });
    }
    var memSel = el("all-memory");
    if (memSel) memSel.addEventListener("change", function () {
      V.memorySeconds = parseInt(memSel.value, 10) || 20;
      if (V.send) V.send({ type: "memory", seconds: V.memorySeconds });
    });
    var intSel = el("all-interval");
    if (intSel) intSel.addEventListener("change", function () {
      V.intervalSeconds = parseInt(intSel.value, 10) || 1;
      if (V.send) V.send({ type: "interval", interval_s: V.intervalSeconds });
    });
    var skipBtn = el("all-skip-ticks");
    if (skipBtn) skipBtn.addEventListener("click", function () {
      V.skipTicksOn = !V.skipTicksOn;
      skipBtn.textContent = "Skipped ticks: " + (V.skipTicksOn ? "ON" : "OFF");
      skipBtn.style.color = V.skipTicksOn ? "var(--amber)" : "var(--muted)";
      if (V.send) V.send({ type: "skip_ticks", enabled: V.skipTicksOn });
    });
    var rstBtn = el("all-reset-pipeline");
    if (rstBtn) rstBtn.addEventListener("click", function () {
      rstBtn.disabled = true;
      rstBtn.textContent = "Resetting…";
      resetClientState();
      if (V.send) V.send({ type: "reset" });
      setTimeout(function () {
        rstBtn.disabled = false;
        rstBtn.textContent = "↺ Reset";
      }, 800);
    });
    var persBtn = el("btn-persona");
    if (persBtn) persBtn.addEventListener("click", togglePersona);

    [["all-thr-nova", "nova"], ["all-thr-piattos", "piattos"], ["all-thr-g2min", "g2min"]].forEach(function (pair) {
      var slider = el(pair[0]);
      if (!slider) return;
      slider.addEventListener("input", function () {
        V.thr[pair[1]] = parseFloat(slider.value);
        syncSliders();
        V.send({ type: "thr", thr: { Nova: V.thr.nova, Piattos: V.thr.piattos, gate2MinConf: V.thr.g2min } });
        pushThr();
        drawThrChart();
      });
    });
  }

  bindControls();
  syncSliders();
  setInterval(drawWave, 80);
  setInterval(drawVolume, 200);
  setInterval(drawThrChart, 1000);
  setInterval(drawGanttChart, 500);
  setInterval(function() {
    var t = new Date().toLocaleTimeString([], {hour:'2-digit', minute:'2-digit'});
    var c1 = el('clock'); if (c1) c1.textContent = t;
    if (S.timerEnd) {
      var r = Math.max(0, Math.round((S.timerEnd - Date.now()) / 1000));
      var tcd = el('timercd');
      if (tcd) tcd.textContent = r > 0 ? r + ' s' : 'done';
      if (r === 0) S.timerEnd = 0;
    }
  }, 1000);
  setBulb(); setMusic(); setTemp();
  window.VCMALL.thrHist = thrHist;
  window.VCMALL.rmsHist = rmsHist;
})();
</script>
<div id="recframe" style="display:none;position:fixed;inset:0;z-index:1000;overflow-y:auto;background:#0d1117;padding:22px;">
 <div style="max-width:1720px;margin:0 auto;">
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;">
   <div style="font-size:16px;font-weight:700;">🧪 Recording test frame <span style="font-size:11px;color:#8b949e;font-weight:400;">— replay one saved recording through every Gate 1 × Gate 2 combination</span> <span id="rf-actwarn" style="display:none;color:#f0883e;font-size:11px;font-weight:600;">⚠ actions are LIVE — stop them in the main window before recording</span></div>
   <button id="recframe-back" style="background:#21262d;color:#c9d1d9;border:1px solid var(--line);border-radius:5px;padding:5px 12px;cursor:pointer;font-size:12px;">✖ Go back to main window</button>
  </div>
  <div style="display:flex;gap:14px;align-items:flex-start;">
   <div id="rf-left" style="flex:0 0 520px;min-width:470px;">
  <div class="panel" style="background:var(--panel);border:1px solid var(--line);border-radius:8px;padding:12px;margin-bottom:12px;">
   <div style="font-size:11px;font-weight:700;color:#58a6ff;margin-bottom:8px;">① PICK A SAVED TAKE <span style="font-weight:400;color:#8b949e;">— bank with “⏺ Save last 30 s”, or ⏺ Record take right here</span></div>
   <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:end;">
    <div><div style="font-size:10px;color:#8b949e;margin-bottom:3px;">Saved recordings (<span id="rf-reccount">0</span>)</div>
     <select id="rf-rec" style="background:#0d1117;color:var(--text);border:1px solid var(--line);border-radius:5px;padding:5px 8px;min-width:230px;font-size:12px;"></select></div>
    <div style="border:1px solid #1f6feb;border-radius:6px;padding:6px 10px;background:#0d1117;">
     <div style="font-size:9px;font-weight:700;color:#58a6ff;margin-bottom:4px;">🔎 FILTERS</div>
     <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:end;">
    <div><div style="font-size:10px;color:#8b949e;margin-bottom:3px;">Label</div>
     <select id="rf-label" style="background:#0d1117;color:var(--text);border:1px solid var(--line);border-radius:5px;padding:5px 8px;min-width:160px;font-size:12px;"><option value="">All labels</option></select></div>
    <div><div style="font-size:10px;color:#8b949e;margin-bottom:3px;">Wake word</div>
     <select id="rf-fwake" style="background:#0d1117;color:var(--text);border:1px solid var(--line);border-radius:5px;padding:5px 8px;font-size:12px;min-width:130px;"><option value="">All wake words</option></select></div>
    <div><div style="font-size:10px;color:#8b949e;margin-bottom:3px;">Action</div>
     <select id="rf-faction" style="background:#0d1117;color:var(--text);border:1px solid var(--line);border-radius:5px;padding:5px 8px;font-size:12px;min-width:150px;"><option value="">All actions</option></select></div>
     <div class="control-field"><label style="font-size:11px;color:#8b949e;">Source</label><select id="rf-fsource" style="background:#0d1117;color:var(--text);border:1px solid var(--line);border-radius:5px;padding:5px 8px;font-size:12px;min-width:170px;" title="Filter the take list by source: ME2 benchmark takes (wake+cmd combined, cmd-only, OOS traps) vs your own recorded takes. 'Newest takes first' sorts by record date."><option value="">All sources</option><option value="me2w">ME2 wake+cmd (benchmark)</option><option value="me2h">ME2 cmd-only</option><option value="me2oos">ME2 OOS (traps)</option><option value="mine">My takes</option><option value="new">Newest takes first</option></select></div>
    <div><div style="font-size:10px;color:#8b949e;margin-bottom:3px;">Search</div>
     <input type="text" id="rf-fsearch" placeholder="label text…" style="background:#0d1117;color:var(--text);border:1px solid var(--line);border-radius:5px;padding:5px 8px;font-size:12px;min-width:150px;"></div>
     </div>
    </div>
    <div style="flex:1"></div>
    <button id="rf-refresh" title="Re-read the saved takes list" style="background:#21262d;color:#c9d1d9;border:1px solid var(--line);border-radius:5px;padding:5px 14px;cursor:pointer;font-size:12px;">⟳ Refresh</button>
    <button id="rf-play" style="background:#1f6feb;color:#fff;border:1px solid #388bfd;border-radius:5px;padding:5px 14px;cursor:pointer;font-size:12px;">▶ Play</button>
    <button id="rf-pause" style="background:#21262d;color:#c9d1d9;border:1px solid var(--line);border-radius:5px;padding:5px 14px;cursor:pointer;font-size:12px;" disabled>⏸ Pause</button>
    <button id="rf-stopaudio" style="background:#21262d;color:#c9d1d9;border:1px solid var(--line);border-radius:5px;padding:5px 14px;cursor:pointer;font-size:12px;">⏹ Stop audio</button>
    <button id="rf-reset" style="background:#21262d;color:#c9d1d9;border:1px solid var(--line);border-radius:5px;padding:5px 14px;cursor:pointer;font-size:12px;">⟲ Reset</button>
    <button id="rf-delselected" disabled title="Delete every checked take permanently" style="background:#b62324;color:#fff;border:1px solid #f85149;border-radius:5px;padding:5px 14px;cursor:pointer;font-size:12px;">🗑 Delete (0)</button>
   </div>
   <div style="display:flex;gap:10px;align-items:center;margin-top:8px;">
    <label style="display:flex;align-items:center;gap:5px;font-size:10px;color:#c9d1d9;cursor:pointer;user-select:none;" title="Select or deselect every take in the list — batch test and delete use this selection">
     <input type="checkbox" id="rf-selall" style="accent-color:#1f6feb;cursor:pointer;">Select all <span id="rf-selcount" style="color:#8b949e;">(0 selected)</span></label>
   </div>
   <div id="rf-recpane" style="display:flex;flex-direction:column;gap:3px;max-height:132px;overflow-y:auto;margin-top:4px;border:1px solid var(--line);border-radius:6px;padding:6px;background:#0d1117;font-size:11px;"></div>
   <div style="display:flex;gap:8px;align-items:end;margin-top:8px;flex-wrap:wrap;">
    <div><div style="font-size:9px;color:#8b949e;margin-bottom:2px;">Wake word used</div>
     <select id="rf-tagwake" style="background:#0d1117;color:var(--text);border:1px solid var(--line);border-radius:5px;padding:5px 8px;font-size:12px;padding:3px 6px;min-width:110px;"><option value="">— none —</option><option>Piattos</option><option>Nova</option><option>Other</option></select></div>
    <div><div style="font-size:9px;color:#8b949e;margin-bottom:2px;">Main action used</div>
     <input type="text" id="rf-tagaction" list="rf-actions" placeholder="e.g. timer_set" style="background:#0d1117;color:var(--text);border:1px solid var(--line);border-radius:5px;padding:5px 8px;font-size:12px;padding:3px 6px;min-width:150px;"></div>
    <button id="rf-savetags" style="background:#238636;color:#fff;border:1px solid #2ea043;border-radius:5px;padding:4px 12px;cursor:pointer;font-size:11px;font-weight:600;">🏷 Save tags</button>
    <span id="rf-taginfo" style="font-size:10px;color:#8b949e;"></span>
    <datalist id="rf-actions"><option value="music_play"></option><option value="search"></option><option value="lights_on"></option><option value="lights_off"></option><option value="lights_dim"></option><option value="lights_bright"></option><option value="timer_set"></option><option value="alarm_set"></option><option value="temp_up"></option><option value="temp_down"></option><option value="media_play"></option><option value="media_pause"></option><option value="media_next"></option><option value="media_prev"></option><option value="volume_up"></option><option value="volume_down"></option><option value="reminder_set"></option><option value="reminder_check"></option><option value="call"></option><option value="silence"></option><option value="PLAY_MUSIC"></option><option value="WEATHER"></option><option value="TIME"></option><option value="LIGHT_ON"></option><option value="LIGHT_OFF"></option><option value="PAUSE"></option><option value="STOP"></option><option value="NEXT"></option><option value="VOLUME_UP"></option><option value="VOLUME_DOWN"></option><option value="CALL"></option><option value="MESSAGE"></option><option value="LIST_REMINDERS"></option><option value="TIMER"></option><option value="ALARM"></option><option value="TEMPERATURE"></option><option value="BRIGHTNESS"></option><option value="COLOR"></option><option value="CREATE_REMINDER"></option></datalist>
    <button id="rf-phrasebtn" title="Example phrases to say for each main action" style="background:#21262d;color:#58a6ff;border:1px solid var(--line);border-radius:5px;padding:4px 10px;cursor:pointer;font-size:11px;">ⓘ phrases</button>
   </div>
   <div id="rf-phrasepanel" style="display:none;margin-top:6px;max-height:260px;overflow-y:auto;background:#0d1117;border:1px solid var(--line);border-radius:6px;padding:8px;font-size:11px;"></div>
   <div style="display:flex;gap:10px;align-items:center;margin-top:10px;">
    <canvas id="rf-wave" width="600" height="54" style="background:#0d1117;border:1px solid var(--line);border-radius:5px;flex:1;min-width:180px;"></canvas>
    <div style="min-width:110px;"><div style="font-size:9px;color:#8b949e;margin-bottom:2px;">level (Record ● / Play ▶)</div>
     <div style="height:8px;background:#161b22;border:1px solid var(--line);border-radius:4px;overflow:hidden;"><div id="rf-level" style="height:100%;width:0%;background:#3fb950;"></div></div></div>
   </div>
   <div style="display:flex;gap:8px;align-items:center;margin-top:8px;">
    <button id="rf-recnew" title="Record a new take straight from this browser mic. ⏹ Stop saves it into the take list. Cap 30 s." style="background:#238636;color:#fff;border:1px solid #2ea043;border-radius:5px;padding:5px 14px;cursor:pointer;font-size:12px;font-weight:600;">⏺ Record take</button>
    <button id="rf-recpause" disabled title="Pause / resume the capture" style="background:#21262d;color:#c9d1d9;border:1px solid var(--line);border-radius:5px;padding:5px 14px;cursor:pointer;font-size:12px;">⏸ Pause</button>
    <button id="rf-recstop" disabled title="Stop and save the take to the list" style="background:#b62324;color:#fff;border:1px solid #f85149;border-radius:5px;padding:5px 14px;cursor:pointer;font-size:12px;">⏹ Stop</button>
    <button id="rf-recdiscard" disabled title="Throw the take away" style="background:#21262d;color:#c9d1d9;border:1px solid var(--line);border-radius:5px;padding:5px 14px;cursor:pointer;font-size:12px;">✖ Discard</button>
    <label style="font-size:10px;color:#8b949e;">wake
     <select id="rf-recwake" style="background:#0d1117;color:var(--text);border:1px solid var(--line);border-radius:5px;padding:3px 6px;font-size:11px;min-width:160px;"><option value="">—</option><option>Piattos</option><option>Nova</option><option>Other</option></select></label>
    <label style="font-size:10px;color:#8b949e;">action
     <input type="text" id="rf-recaction" list="rf-actions" placeholder="timer_set" style="background:#0d1117;color:var(--text);border:1px solid var(--line);border-radius:5px;padding:3px 6px;font-size:11px;min-width:230px;"></label>
    <span id="rf-recstate" style="font-size:11px;color:#8b949e;">idle — ⏹ Stop saves straight into the take list</span>
    <button id="rf-recinfo" title="Phrases to say for the chosen action" style="background:#21262d;color:#58a6ff;border:1px solid var(--line);border-radius:5px;padding:2px 8px;cursor:pointer;font-size:11px;">ⓘ</button>
   </div>
   <div style="font-size:11px;font-weight:700;color:#58a6ff;margin:12px 0 8px;">② CHOOSE COMBINATIONS <span style="font-weight:400;color:#8b949e;">— one test lane per checked Gate 1 × Gate 2 pair</span></div>
   <div style="display:flex;gap:8px;align-items:center;margin-bottom:6px;flex-wrap:wrap;">
    <button id="rf-selectall" title="Tick every Gate 1 and Gate 2 variant (full cross-product)" style="background:#238636;color:#fff;border:1px solid #2ea043;border-radius:5px;padding:4px 12px;cursor:pointer;font-size:11px;font-weight:600;">☑ Select all</button>
    <button id="rf-clearall" title="Untick everything" style="background:#21262d;color:#c9d1d9;border:1px solid var(--line);border-radius:5px;padding:4px 12px;cursor:pointer;font-size:11px;">☐ Clear all</button>
    <button id="rf-quickset" title="The usual quick pair: G1 v12+v8 × G2 v21p/v22/v46/v56×2/v19" style="background:#21262d;color:#c9d1d9;border:1px solid var(--line);border-radius:5px;padding:4px 12px;cursor:pointer;font-size:11px;">⚡ Quick set</button>
    <span style="font-size:10px;color:#8b949e;">applies to both lists at once</span>
    <div style="flex:1"></div>
    <input type="text" id="rf-modelsearch" placeholder="Filter models (e.g. gate2v2 or f16)" style="background:#0d1117;color:var(--text);border:1px solid var(--line);border-radius:5px;padding:5px 8px;font-size:12px;min-width:220px;" title="Hide model rows that do not match — checkboxes stay ticked, so you can tick a family, filter to another, and keep both">
    <button id="rf-selectvisible" title="Tick every model currently shown by the filter" style="background:#21262d;color:#c9d1d9;border:1px solid var(--line);border-radius:5px;padding:4px 12px;cursor:pointer;font-size:11px;">☑ Tick visible</button>
   </div>
   <div style="display:flex;gap:10px;flex-wrap:wrap;">
    <div style="flex:1;min-width:200px;"><div style="font-size:10px;color:#8b949e;margin-bottom:4px;">Gate 1 variants (<span id="rf-g1count">0</span> selected)</div><div id="rf-g1box" style="display:flex;flex-direction:column;gap:6px;font-size:11px;max-height:120px;overflow-y:auto;border:1px solid var(--line);border-radius:6px;padding:8px;background:#0d1117;"></div></div>
    <div style="flex:2;min-width:280px;"><div style="font-size:10px;color:#8b949e;margin-bottom:4px;">Gate 2 models (<span id="rf-mcount">0</span> selected)</div><div id="rf-mbox" style="display:flex;flex-direction:column;gap:6px;font-size:11px;max-height:120px;overflow-y:auto;border:1px solid var(--line);border-radius:6px;padding:8px;background:#0d1117;"></div></div>
   </div>
   <div style="font-size:11px;font-weight:700;color:#58a6ff;margin:12px 0 8px;">③ RUN THE TEST <span style="font-weight:400;color:#8b949e;">— replays the take through every checked pair</span></div>
   <div style="display:flex;gap:10px;align-items:center;">
    <button id="rf-start" style="background:#238636;color:#fff;border:1px solid #2ea043;border-radius:5px;padding:6px 16px;cursor:pointer;font-size:12px;font-weight:600;">▶ Test selected combinations</button>
    <button id="rf-batchstart" title="Run the selected combinations on EVERY checked take, one after another" style="background:#1f6feb;color:#fff;border:1px solid #388bfd;border-radius:5px;padding:6px 14px;cursor:pointer;font-size:12px;font-weight:600;">▶▶ Batch test (0 takes)</button>
    <button id="rf-stop" disabled style="background:#b62324;color:#fff;border:1px solid #f85149;border-radius:5px;padding:6px 16px;cursor:pointer;font-size:12px;">⏹ Stop</button>
    <label style="display:flex;align-items:center;gap:5px;font-size:11px;color:#c9d1d9;white-space:nowrap;" title="Noise-canceller axis: run every pair raw, NC-cleaned, or both for an A/B">NC
     <select id="rf-ncmode" style="background:#0d1117;color:var(--text);border:1px solid var(--line);border-radius:5px;padding:5px 8px;font-size:12px;padding:3px 6px;">
      <option value="off">Raw only</option>
      <option value="on">Canceller only</option>
      <option value="both" selected>Both (A/B)</option>
     </select></label>
    <label style="display:flex;align-items:center;gap:4px;font-size:11px;color:#c9d1d9;white-space:nowrap;" title="Architecture axis: v1 = the original — all gates run simultaneously, a trigger needs Gate 1 + Gate 2; v2 = Gate 1 must be triggered before the other gates process; v3 = v2 plus a two-tick intent stability vote; All replays every pair under all three architectures">Architecture
     <select id="rf-gatemode" style="background:#0d1117;color:var(--text);border:1px solid var(--line);border-radius:5px;padding:3px 6px;font-size:12px;">
      <option value="off">v1 — all gates run</option>
      <option value="on">v2 — G1 first</option>
      <option value="v3">v3 — G1 first + intent vote</option>
      <option value="both" selected>v1 + v2 (A/B)</option>
      <option value="all">All (v1 + v2 + v3)</option>
     </select></label>
    <label style="display:flex;align-items:center;gap:4px;font-size:11px;color:#c9d1d9;white-space:nowrap;" title="Worker threads for test replays: lanes run in parallel ACROSS Gate 2 models (lanes sharing a model stay sequential, so results are identical). Auto = up to 8 cores.">Workers
     <select id="rf-workers" style="background:#0d1117;color:var(--text);border:1px solid var(--line);border-radius:5px;padding:3px 6px;font-size:12px;">
      <option value="auto" selected>Auto</option><option value="1">1 · sequential</option><option value="2">2</option><option value="4">4</option><option value="8">8</option>
     </select></label>
    <input type="text" id="rf-find" placeholder="Find lane (v60, v10_dr, v3…)…" style="background:#0d1117;color:var(--text);border:1px solid var(--line);border-radius:5px;padding:5px 8px;font-size:12px;min-width:180px;" title="Search result lanes by Gate 1, Gate 2, architecture or NC text. Click a match to jump and inspect it.">
    <span id="rf-lanecount" style="font-size:10px;color:#8b949e;white-space:nowrap;"></span>
    <div style="flex:1;height:8px;background:#0d1117;border:1px solid var(--line);border-radius:4px;overflow:hidden;"><div id="rf-bar" style="height:100%;width:0%;background:#238636;transition:width .3s;"></div></div>
    <div id="rf-prog" style="font-size:11px;color:#8b949e;min-width:130px;text-align:right;">idle</div>
   </div>
   <div id="rf-findout" style="display:none;border:1px solid #30363d;border-radius:6px;padding:6px;background:#0d1117;margin:6px 0;max-height:220px;overflow:auto;"></div>
   <div id="rf-progress" style="display:none;border:1px solid #1f6feb;border-radius:8px;padding:8px 10px;background:#132241;margin:6px 0;">
    <div style="display:flex;gap:8px;align-items:center;">
     <div style="flex:1;height:14px;background:#0d1117;border:1px solid #30363d;border-radius:6px;overflow:hidden;"><div id="rf-progress-fill" style="height:100%;width:0%;background:linear-gradient(90deg,#1f6feb,#238636);transition:width .3s;"></div></div>
     <span id="rf-progress-text" style="font-size:11px;color:#c9d1d9;white-space:nowrap;">0%</span>
    </div>
   </div>
   <div id="rf-g3info" style="font-size:10px;color:#8b949e;margin-top:6px;"></div>
   <div id="rf-say" style="font-size:10px;color:#8b949e;margin-top:6px;"></div>
  </div>
   </div>
   <div id="rf-right" style="flex:1;min-width:0;">
    <div style="font-size:11px;font-weight:700;color:#58a6ff;margin:0 0 6px;">RESULTS &amp; SUMMARY <span style="font-weight:400;color:#8b949e;">— digest, best-lane timeline, then the per-combination cards</span></div>
    <div id="rf-summary" style="border:1px solid #30363d;border-radius:8px;padding:10px;background:#161b22;margin-bottom:10px;"></div>
    <div id="rf-best" style="border:1px solid #30363d;border-radius:8px;padding:10px;background:#161b22;margin-bottom:10px;"></div>
  <div id="rf-results" style="max-height:640px;overflow-y:auto;border:1px solid #30363d;border-radius:8px;padding:12px;background:#161b22;"></div>
   </div>
  </div>
 </div>
</div>
<script>
(function () {
  "use strict";
  var RF = { recs: [], g1: [], models: [], jobId: null, pollTimer: null, audio: null };
  var $ = function (id) { return document.getElementById(id); };
   function say(t) { var e = $("rf-say"); if (e) e.textContent = t; }

  // --- Manual take recorder: capture the mic here, save straight into the list ---
  var RFR = { mic: null, stream: null, chunks: [], timer: null, t0: 0, acc: 0, cap: 30, discarding: false,
              actx: null, src: null, analyser: null, waveData: null, waveTimer: null };
  window.RFR = RFR;   // introspection handle for browser probes
  function rfRecSay(t) { say(t); var e = $("rf-recstate"); if (e) e.textContent = t; }
  function rfRecBtns(state) {
    $("rf-recnew").disabled = state !== "idle";
    $("rf-recpause").disabled = !(state === "rec" || state === "pause");
    $("rf-recstop").disabled = !(state === "rec" || state === "pause");
    $("rf-recdiscard").disabled = !(state === "rec" || state === "pause");
    $("rf-recpause").textContent = state === "pause" ? "▶ Resume" : "⏸ Pause";
  }
  function rfRecSecs() { return (RFR.acc + (RFR.mic && RFR.mic.state === "recording" ? Date.now() - RFR.t0 : 0)) / 1000; }
  function rfRecFmt(s) { var m = Math.floor(s / 60); return m + ":" + ("0" + Math.floor(s - m * 60)).slice(-2); }
  function rfRecStart() {
    stopAudio();   // free the shared waveform canvas from playback
    navigator.mediaDevices.getUserMedia({ audio: { channelCount: 1, echoCancellation: false, noiseSuppression: false, autoGainControl: false } })
      .then(function (stream) {
        RFR.stream = stream;
        rfRecStartWave(stream);
        RFR.mic = new MediaRecorder(stream);
        RFR.chunks = []; RFR.acc = 0; RFR.discarding = false;
        RFR.mic.ondataavailable = function (e) { if (e.data.size) RFR.chunks.push(e.data); };
        RFR.mic.onstop = function () {
          if (!RFR.mic) return;                    // guard: onstop can re-enter
          var dur = rfRecSecs(); RFR.acc = 0;
          rfRecStopWave();                          // release the mic meter before anything else
          if (RFR.stream) { RFR.stream.getTracks().forEach(function (t) { t.stop(); }); RFR.stream = null; }
          RFR.mic = null;
          clearInterval(RFR.timer); RFR.timer = null;
          if (RFR.discarding) {
            RFR.chunks = []; RFR.discarding = false;
            rfRecBtns("idle");
            rfRecSay("take discarded — nothing saved");
            return;
          }
          rfRecBtns("idle");
          rfRecSay("encoding take " + rfRecFmt(dur) + "…");
          var blob = new Blob(RFR.chunks, { type: "audio/webm" });
          RFR.chunks = [];
          blob.arrayBuffer().then(function (buf) {
            var ctx = new (window.AudioContext || window.webkitAudioContext)();
            return ctx.decodeAudioData(buf);
          }).then(function (decoded) {
            var ch = decoded.numberOfChannels, n = decoded.length;
            var data = new Float32Array(n);
            for (var c = 0; c < ch; c++) {
              var chan = decoded.getChannelData(c);
              for (var i = 0; i < n; i++) data[i] += chan[i] / ch;
            }
            var target = Math.max(1, Math.round(n * 16000 / (decoded.sampleRate || 48000)));
            var res = new Float32Array(target);
            for (var i2 = 0; i2 < target; i2++) {
              var pos = i2 * (n - 1) / Math.max(1, target - 1);
              var lo = Math.floor(pos), hi = Math.ceil(pos), f = pos - lo;
              res[i2] = data[lo] * (1 - f) + data[hi] * f;
            }
            var pcm = new Int16Array(res.length);
            for (var i3 = 0; i3 < res.length; i3++) { var v = Math.max(-1, Math.min(1, res[i3])); pcm[i3] = v < 0 ? v * 32768 : v * 32767; }
            var out = new ArrayBuffer(44 + pcm.length * 2);
            var dv = new DataView(out);
            function ws(o, s) { for (var j = 0; j < s.length; j++) dv.setUint8(o + j, s.charCodeAt(j)); }
            ws(0, "RIFF"); dv.setUint32(4, 36 + pcm.length * 2, true); ws(8, "WAVE"); ws(12, "fmt ");
            dv.setUint32(16, 16, true); dv.setUint16(20, 1, true); dv.setUint16(22, 1, true);
            dv.setUint32(24, 16000, true); dv.setUint32(28, 32000, true); dv.setUint16(32, 2, true); dv.setUint16(34, 16, true);
            ws(36, "data"); dv.setUint32(40, pcm.length * 2, true);
            new Int16Array(out, 44).set(pcm);
            var bytes = new Uint8Array(out), bin = "";
            for (var k = 0; k < bytes.length; k += 32768) bin += String.fromCharCode.apply(null, bytes.subarray(k, k + 32768));
             var label = "rf-take-" + new Date().toTimeString().slice(0, 8).replace(/:/g, "");
             return send("POST", "/api/recordings", {
               label: label, wav_base64: btoa(bin),
               wake_word: ($("rf-recwake") && $("rf-recwake").value) || "",
               action: (($("rf-recaction") && $("rf-recaction").value) || "").trim()
             });
          }).then(function (d) {
            rfRecSay("saved " + ((d && d.recording && d.recording.label) || "take") + " — list refreshed");
            loadRecs();
          }).catch(function (e) { rfRecSay("save failed: " + e.message); });
        };
        RFR.mic.start();
        RFR.t0 = Date.now();
        rfRecBtns("rec");
        rfRecSay("● recording 0:00 / 30 s — ⏹ Stop saves the take");
        RFR.timer = setInterval(function () {
          if (RFR.mic && RFR.mic.state === "recording") {
            var s = rfRecSecs();
            rfRecSay("● recording " + rfRecFmt(s) + " / 30 s");
            if (s >= RFR.cap) { RFR.acc += Date.now() - RFR.t0; RFR.mic.stop(); }
          }
        }, 200);
      })
      .catch(function (e) { say("mic: " + e.message); rfRecBtns("idle"); });
  }
  function rfRecPause() {
    if (!RFR.mic) return;
    if (RFR.mic.state === "recording") {
      RFR.mic.pause(); RFR.acc += Date.now() - RFR.t0;
      rfRecBtns("pause"); rfRecSay("⏸ paused at " + rfRecFmt(rfRecSecs()) + " — ▶ Resume or ⏹ Stop");
    } else if (RFR.mic.state === "paused") {
      RFR.mic.resume(); RFR.t0 = Date.now();
      rfRecBtns("rec"); rfRecSay("● recording — resumed at " + rfRecFmt(rfRecSecs()));
    }
  }
  function rfRecStartWave(stream) {
    // Draw the LIVE MIC waveform + level into rf-wave / rf-level so you can see
    // your own voice while recording. The analyser is deliberately not connected
    // to destination: monitoring the mic through the speakers would feed back.
    try {
      if (!RFR.actx) RFR.actx = new (window.AudioContext || window.webkitAudioContext)();
      if (RFR.actx.state === "suspended") RFR.actx.resume();
      RFR.src = RFR.actx.createMediaStreamSource(stream);
      RFR.analyser = RFR.actx.createAnalyser(); RFR.analyser.fftSize = 1024;
      RFR.src.connect(RFR.analyser);
      RFR.waveData = new Float32Array(RFR.analyser.fftSize);
    } catch (e) { RFR.analyser = null; say("mic meter unavailable: " + e.message); }
    var cv = $("rf-wave"); if (!cv || !RFR.analyser) return;
    var ctx = cv.getContext("2d");
    function loop() {
      RFR.waveTimer = requestAnimationFrame(loop);
      ctx.fillStyle = "#0d1117"; ctx.fillRect(0, 0, cv.width, cv.height);
      RFR.analyser.getFloatTimeDomainData(RFR.waveData);
      ctx.strokeStyle = "#f85149"; ctx.lineWidth = 1.5; ctx.beginPath();
      var peak = 0;
      for (var i = 0; i < RFR.waveData.length; i += 4) {
        var x = i / RFR.waveData.length * cv.width, yv = cv.height / 2 + RFR.waveData[i] * (cv.height / 2 - 4);
        if (i === 0) ctx.moveTo(x, yv); else ctx.lineTo(x, yv);
        var ab = Math.abs(RFR.waveData[i]); if (ab > peak) peak = ab;
      }
      ctx.stroke();
      ctx.fillStyle = "#f85149"; ctx.font = "10px Arial";
      ctx.fillText("● mic input", 8, 12);
      var lv = $("rf-level"); if (lv) lv.style.width = Math.min(100, Math.round(peak * 160)) + "%";
    }
    loop();
  }
  function rfRecStopWave() {
    if (RFR.waveTimer) { cancelAnimationFrame(RFR.waveTimer); RFR.waveTimer = null; }
    try { if (RFR.src) { RFR.src.disconnect(); RFR.src = null; } } catch (e) {}
    RFR.analyser = null;
    var lv = $("rf-level"); if (lv) lv.style.width = "0%";
    // Clear the canvas so no stale "mic input" frame is left on screen (the
    // playback waveform owns it next).
    var cv = $("rf-wave");
    if (cv) { var c = cv.getContext("2d"); c.fillStyle = "#0d1117"; c.fillRect(0, 0, cv.width, cv.height); }
  }

  function rfRecStop() {
    if (RFR.mic && RFR.mic.state !== "inactive") {
      if (RFR.mic.state === "recording") RFR.acc += Date.now() - RFR.t0;
      RFR.mic.stop();
    }
  }
  function rfRecDiscard() {
    if (RFR.mic && RFR.mic.state !== "inactive") { RFR.discarding = true; RFR.mic.stop(); }
  }
  // Safety: never leave the mic meter loop running over a playback waveform.
  var rfStartWaveOrig = startWave;
  startWave = function () { rfRecStopWave(); return rfStartWaveOrig(); };
  function get(url) { return fetch(url).then(function (r) { if (!r.ok) throw new Error("HTTP " + r.status); return r.json(); }); }
  function send(method, url, body) {
    return fetch(url, { method: method, headers: { "Content-Type": "application/json" }, body: body ? JSON.stringify(body) : undefined })
      .then(function (r) { return r.json().then(function (d) { if (!r.ok) throw new Error(d.error || ("HTTP " + r.status)); return d; }); });
  }
  function open() {
    // The frame is a fixed full-screen modal: body has overflow:hidden, so the
    // old below-the-fold panel + scrollIntoView could never become visible
    // ("click → nothing happens"). A modal overlay always shows on top.
    $("recframe").style.display = "block";
    loadRecs(); loadModels(); rfBestSummary();
    var warn = document.getElementById("rf-actwarn");
    if (warn) warn.style.display = (window.ACTIONS_PLAYING === false) ? "none" : "inline";
    $("all-recframe-toggle").textContent = "✖ Close recording test";
  }
  function close() {
    $("recframe").style.display = "none";
    $("all-recframe-toggle").textContent = "🧪 Recording test";
  }
  function archOf(s) { return (s.arch === undefined || s.arch === null) ? (s.gated ? 1 : 0) : s.arch; }
  function archNames(codes) { return (codes || []).slice().sort(function (a, b) { return a - b; }).map(function (a) { return "v" + (a + 1); }).join(" + "); }
  function rfArchCodes(items) { var out = []; (items || []).forEach(function (s) { var a = archOf(s); if (out.indexOf(a) < 0) out.push(a); }); return out.sort(function (a, b) { return a - b; }); }
  function archLabel(a) { return a === 2 ? "Arch v3" : a === 1 ? "Arch v2" : "Arch v1"; }
  function comboName(s) {
    return (s.g1_model || "").replace("gate1", "G1") + " × " + (s.model || "").replace("gate2", "G2") +
      (s.nc ? " · NC on" : " · raw") + " · " + archLabel(archOf(s));
  }
  function loadRecs() {
    get("/api/recordings").then(function (d) {
      RF.recs = d.recordings || [];
      var rec = $("rf-rec"), lab = $("rf-label"), cur = rec.value, curL = lab.value;
      rec.innerHTML = ""; lab.innerHTML = "<option value=''>All labels</option>";
      var labels = {};
      RF.recs.forEach(function (r) {
        var o = document.createElement("option"); o.value = r.id;
        o.textContent = (r.label || "recording") + " · " + (r.duration_s || r.duration || "?") + "s" + (r.created ? " · " + String(r.created).slice(5, 16).replace("T", " ") : "");
        rec.appendChild(o);
        if (r.label) labels[r.label] = 1;
      });
      Object.keys(labels).sort().forEach(function (l) { var o = document.createElement("option"); o.value = l; o.textContent = l; lab.appendChild(o); });
      if (cur) rec.value = cur; if (curL) lab.value = curL;
      rec.onchange = function () { drawAudioInfo(); };
      fillFilterOptions("rf-fwake", RF.recs.map(function (r) { return r.wake_word; }));
      fillFilterOptions("rf-faction", RF.recs.map(function (r) { return r.action; }));
      renderRecPane();
      var cnt = $("rf-reccount"); if (cnt) cnt.textContent = String(RF.recs.length);
      if (!RF.recs.length) say("no saved takes yet — click “⏺ Save last 30 s” in the live dashboard to bank one");
    }).catch(function (e) { say("cannot load recordings: " + e.message); });
  }
  function loadModels() {
    get("/api/lab/models").then(function (d) {
      RF.g1 = d.g1_models || []; RF.models = d.models || [];
      var gb = $("rf-g1box"), mb = $("rf-mbox"); gb.innerHTML = ""; mb.innerHTML = "";
      RF.g1.forEach(function (g, i) {
        var w = document.createElement("label"); w.style.cssText = "display:flex;align-items:center;gap:4px;cursor:pointer;";
        var c = document.createElement("input"); c.type = "checkbox"; c.value = g; c.checked = i < 2; c.onchange = updateCount;
        w.appendChild(c); w.appendChild(document.createTextNode(g.replace("gate1", "G1 ")));
        gb.appendChild(w);
      });
      RF.models.forEach(function (m, i) {
        var w = document.createElement("label"); w.style.cssText = "display:flex;align-items:center;gap:4px;cursor:pointer;";
        var c = document.createElement("input"); c.type = "checkbox"; c.value = m; c.checked = i < 3; c.onchange = updateCount;
        w.appendChild(c); w.appendChild(document.createTextNode(m.replace("gate2", "G2 ")));
        mb.appendChild(w);
      });
      updateCount();
      var g3i = $("rf-g3info");
      if (g3i) {
        g3i.textContent = d.g3 ? ("Gate 3 specialists: " + (d.g3.available
          ? "available — routed " + Object.keys(d.g3.routes || {}).join(", ") + " fire on trigger"
          : "unavailable (TensorFlow not installed)")) : "";
        g3i.style.color = d.g3 && d.g3.available ? "#3fb950" : "";
      }
    }).catch(function (e) { say("cannot load models: " + e.message); });
  }
  function fillFilterOptions(id, values) {
    // Rebuild a <select> from the distinct non-empty values, keeping the choice.
    var sel = $(id); if (!sel) return;
    var cur = sel.value;
    var first = sel.options.length ? sel.options[0].textContent : "";
    sel.textContent = "";
    var o0 = document.createElement("option"); o0.value = ""; o0.textContent = first; sel.appendChild(o0);
    var uniq = {};
    values.forEach(function (v) { if (v) uniq[String(v)] = 1; });
    Object.keys(uniq).sort().forEach(function (v) {
      var o = document.createElement("option"); o.value = v; o.textContent = v; sel.appendChild(o);
    });
    sel.value = cur && uniq[cur] !== undefined ? cur : "";
  }

  function filteredRecs() {
    var w = ($("rf-fwake") && $("rf-fwake").value) || "";
    var a = ($("rf-faction") && $("rf-faction").value) || "";
    var l = ($("rf-label") && $("rf-label").value) || "";
    var q = (($("rf-fsearch") && $("rf-fsearch").value) || "").toLowerCase();
    var s = ($("rf-fsource") && $("rf-fsource").value) || "";
    var list = RF.recs.filter(function (r) {
      var id = String(r.id || "");
      if (w && String(r.wake_word || "") !== w) return false;
      if (a && String(r.action || "") !== a) return false;
      if (l && String(r.label || "") !== l) return false;
      if (q && (String(r.label || "") + " " + String(r.wake_word || "") + " " + String(r.action || "")).toLowerCase().indexOf(q) < 0) return false;
      if (s === "me2w" && id.indexOf("me2w_") !== 0) return false;
      else if (s === "me2h" && id.indexOf("me2h_") !== 0) return false;
      else if (s === "me2oos" && !(id.indexOf("me2") === 0 && String(r.label || "").indexOf("OOS") >= 0)) return false;
      else if (s === "mine" && (id.indexOf("me2") === 0 || id.indexOf("wakegen") === 0)) return false;
      return true;
    });
    if (s === "new") list = list.slice().sort(function (x, y) { return String(y.created || "").localeCompare(String(x.created || "")); });
    return list;
  }

  function renderRecPane() {
    RF.batchIds = RF.batchIds || {};
    var pane = $("rf-recpane"); if (!pane) return;
    var sel = $("rf-rec").value;
    var list = filteredRecs();
    pane.textContent = "";
    if (!list.length) {
      var n = document.createElement("div");
      n.style.cssText = "font-size:11px;color:#8b949e;padding:4px;";
      n.textContent = RF.recs.length ? "no takes match the filter (" + RF.recs.length + " saved total)" : "no saved takes yet — use ⏺ Record take below";
      pane.appendChild(n);
    }
    list.forEach(function (r) {
      var row = document.createElement("div");
      var on = r.id === sel;
      row.style.cssText = "display:flex;gap:8px;align-items:center;padding:4px 6px;border-radius:4px;cursor:pointer;border:1px solid " + (on ? "#1f6feb" : "transparent") + ";background:" + (on ? "#132241" : "transparent") + ";";
      var cb = document.createElement("input");
      cb.type = "checkbox"; cb.checked = !!RF.batchIds[r.id];
      cb.style.cssText = "accent-color:#1f6feb;cursor:pointer;flex:0 0 auto;";
      cb.addEventListener("click", function (ev) { ev.stopPropagation(); });
      cb.addEventListener("change", function () { if (cb.checked) RF.batchIds[r.id] = true; else delete RF.batchIds[r.id]; updateBatchLabel(); });
      row.appendChild(cb);
      var name = document.createElement("span");
      name.style.cssText = "flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:" + (on ? "#58a6ff" : "var(--text)") + ";";
      name.textContent = r.label || r.id;
      row.appendChild(name);
      [r.wake_word, r.action].forEach(function (tag) {
        var b = document.createElement("span");
        b.style.cssText = "font-size:9px;padding:1px 6px;border-radius:8px;background:" + (tag ? "#1f2a44" : "#21262d") + ";color:" + (tag ? "#a5d6ff" : "#484f58") + ";";
        b.textContent = tag || "untagged";
        row.appendChild(b);
      });
      var dur = document.createElement("span");
      dur.style.cssText = "font-size:10px;color:#8b949e;min-width:44px;text-align:right;";
      dur.textContent = (r.duration_s || r.duration || "?") + " s";
      row.appendChild(dur);
      row.addEventListener("click", function () {
        $("rf-rec").value = r.id; drawAudioInfo(); renderRecPane(); syncTagEditor();
      });
      pane.appendChild(row);
    });
    var cnt = $("rf-reccount");
    if (cnt) cnt.textContent = list.length === RF.recs.length ? String(RF.recs.length) : list.length + "/" + RF.recs.length;
    var sa = $("rf-selall");
    if (sa) sa.checked = list.length > 0 && list.every(function (r) { return !!RF.batchIds[r.id]; });
    updateBatchLabel();
  }

  function syncTagEditor() {
    var r = RF.recs.filter(function (x) { return x.id === $("rf-rec").value; })[0];
    var info = $("rf-taginfo");
    if (!r) {
      if ($("rf-tagwake")) $("rf-tagwake").value = "";
      if ($("rf-tagaction")) $("rf-tagaction").value = "";
      if (info) info.textContent = "";
      return;
    }
    if ($("rf-tagwake")) $("rf-tagwake").value = ["Piattos", "Nova", "Other"].indexOf(r.wake_word) >= 0 ? r.wake_word : (r.wake_word ? "Other" : "");
    if ($("rf-tagaction")) $("rf-tagaction").value = r.action || "";
    if (info) info.textContent = "tagging: " + (r.label || r.id);
  }

  function saveTags() {
    var id = $("rf-rec").value;
    if (!id) { say("select a take to tag first"); return; }
    send("PATCH", "/api/recordings/" + id, {
      wake_word: $("rf-tagwake").value, action: $("rf-tagaction").value.trim()
    }).then(function (d) {
      say("tagged " + (d.recording.label || id) + " · " + (d.recording.wake_word || "—") + " · " + (d.recording.action || "—"));
      return loadRecs();
    }).catch(function (e) { say("tag failed: " + e.message); });
  }

  function applyModelFilter() {
    var q = (($("rf-modelsearch") && $("rf-modelsearch").value) || "").toLowerCase();
    document.querySelectorAll("#rf-g1box label, #rf-mbox label").forEach(function (l) {
      l.style.display = !q || l.textContent.toLowerCase().indexOf(q) >= 0 ? "" : "none";
    });
    updateCount();
  }

  function ncModes() {
    var m = ($("rf-ncmode") && $("rf-ncmode").value) || "off";
    return m === "both" ? [false, true] : [m === "on"];
  }
  function gateModes() {
    var m = ($("rf-gatemode") && $("rf-gatemode").value) || "off";
    if (m === "v3") return [2];
    if (m === "all") return [0, 1, 2];
    if (m === "both") return [0, 1];
    return [m === "on" ? 1 : 0];
  }

  function checked(box) { return Array.prototype.slice.call(box.querySelectorAll("input:checked")).map(function (c) { return c.value; }); }
  function updateCount() {
    $("rf-g1count").textContent = checked($("rf-g1box")).length;
    $("rf-mcount").textContent = checked($("rf-mbox")).length;
    var lanes = checked($("rf-g1box")).length * checked($("rf-mbox")).length * ncModes().length * gateModes().length;
    var lc = $("rf-lanecount");
    if (lc) lc.textContent = lanes + " gantt lane" + (lanes === 1 ? "" : "s");
  }
  function drawAudioInfo() {
    var id = $("rf-rec").value;
    var rec = RF.recs.filter(function (r) { return r.id === id; })[0];
    if (!rec) { say("select a saved take"); return; }
    say("selected: " + (rec.label || id) + " · " + (rec.duration_s || "?") + " s · saved " + (rec.created ? String(rec.created).slice(0, 16).replace("T", " ") : "?"));
  }
  function startTest() {
    var id = $("rf-rec").value;
    if (!id) { say("select a saved recording first"); return; }
    var g1s = checked($("rf-g1box")), models = checked($("rf-mbox"));
    if (!g1s.length || !models.length) { say("select at least one Gate 1 variant and Gate 2 model"); return; }
    $("rf-start").disabled = true; $("rf-stop").disabled = false; $("rf-bar").style.width = "0%"; $("rf-prog").textContent = "queued…";
    rfProgress(true, 0, "queued…");
    var modes = ncModes();
    say("running " + (g1s.length * models.length) + " pairs × " + modes.length +
        " NC mode" + (modes.length === 1 ? "" : "s") + " × " + gateModes().length +
        " architecture" + (gateModes().length === 1 ? "" : "s") + " (" + archNames(gateModes()) + ") = " +
        (g1s.length * models.length * modes.length * gateModes().length) + " lanes…");
    var wSel1 = $("rf-workers");
    send("POST", "/api/recordings/" + id + "/test", { g1_models: g1s, models: models, hop_s: 1.0, nc_modes: modes, architectures: gateModes(), workers: (wSel1 && wSel1.value !== "auto") ? Math.max(0, parseInt(wSel1.value, 10) || 0) : 0 })
      .then(function (d) { RF.jobId = d.job.id; RF.pollMiss = 0; poll(d.job.id); })
      .catch(function (e) { $("rf-start").disabled = false; $("rf-stop").disabled = true; $("rf-prog").textContent = "failed"; say(e.message); });
  }
  function poll(id) {
    get("/api/jobs/" + id).then(function (d) {
      RF.pollMiss = 0;
      var job = d.job;
      var pct = Math.round((job.progress || 0) * 100);
      var tickN = Math.round((job.progress || 0) * (job.ticks_total || 0));
      var lanesN = (job.combos || []).length;
      $("rf-bar").style.width = pct + "%";
      var ptxt = job.status + " " + pct + "%"
        + (job.ticks_total ? " · tick " + tickN + "/" + job.ticks_total : "")
        + (lanesN ? " · ~" + (tickN * lanesN) + "/" + ((job.ticks_total || 0) * lanesN) + " lane-scores" : "")
        + (job.workers > 1 ? " · " + job.workers + " workers" : "");
      $("rf-prog").textContent = ptxt;
      rfProgress(job.status === "running" || job.status === "queued", pct, ptxt);
      if (job.status === "running" || job.status === "queued") { RF.pollTimer = setTimeout(function () { poll(id); }, 700); return; }
      $("rf-start").disabled = false; $("rf-stop").disabled = true;
      if (job.status === "error") { $("rf-prog").textContent = "error: " + job.error; if ((job.summaries || []).length) render(job); return; }
      $("rf-prog").textContent = "done in " + job.elapsed_s + " s";
      render(job);
    }).catch(function () {
      // One failed poll (server hiccup / reload) must not kill the job —
      // this used to show "job lost" and never draw the gantt. Retry instead.
      RF.pollMiss = (RF.pollMiss || 0) + 1;
      if (RF.pollMiss <= 8) {
        $("rf-prog").textContent = "reconnecting… (" + RF.pollMiss + ")";
        RF.pollTimer = setTimeout(function () { poll(id); }, 700 + RF.pollMiss * 300);
        return;
      }
      $("rf-start").disabled = false; $("rf-stop").disabled = true; $("rf-prog").textContent = "job lost";
      rfProgress(false);
    });
  }
  var RF_INTENT_COLORS = ["#a371f7", "#f0883e", "#d29922", "#39c5cf"];
  // --- Summary view: digest + best-lane timeline ("when did wake/intent fire") ---
  var RFZ_ALIAS = { settimer: "timer", alarmset: "alarm", tempup: "temperature", tempdown: "temperature",
    lightsdim: "brightness", lightsbright: "brightness", lightson: "lighton", lightsoff: "lightoff",
    reminderset: "createreminder", remindercheck: "listreminders", checkreminders: "listreminders",
    mediaplay: "playmusic", mediapause: "pause", medianext: "next", silence: "stop" };
  function rfzBag(s) { return String(s || "").toLowerCase().split(/[^a-z]+/).filter(Boolean).sort().join(""); }
  function rfzAlias(b) { return RFZ_ALIAS[b] || b; }
  function rfzMatch(pred, exp) { return exp ? rfzAlias(rfzBag(pred)) === rfzAlias(rfzBag(exp)) : false; }
  function rfzLaneKey(g1, g2, nc, gated) { return (g1 || "") + "|" + (g2 || "") + "|" + (nc ? 1 : 0) + "|" + (gated ? 1 : 0); }
  function rfzTimeline(lane, dur) {
    var wrap = document.createElement("div");
    wrap.style.cssText = "position:relative;height:36px;background:#0d1117;border:1px solid var(--line);border-radius:4px;overflow:hidden;";
    if (!(dur > 0)) dur = 30;
    for (var t = 0; t <= dur; t += 5) {
      var gl = document.createElement("div");
      gl.style.cssText = "position:absolute;top:0;bottom:0;width:1px;background:#21262d;left:" + (t / dur * 100) + "%;";
      wrap.appendChild(gl);
    }
    (lane.wakeTimes || []).forEach(function (tv) {
      var m = document.createElement("div");
      m.style.cssText = "position:absolute;top:3px;height:14px;width:3px;background:#58a6ff;left:" + Math.min(99.2, tv / dur * 100) + "%;border-radius:1px;";
      m.title = "wake fired " + tv.toFixed(1) + "s";
      wrap.appendChild(m);
    });
    (lane.g2Times || []).forEach(function (e) {
      var m = document.createElement("div");
      m.style.cssText = "position:absolute;top:19px;height:13px;width:5px;background:#3fb950;left:" + Math.min(98.5, e.t / dur * 100) + "%;border-radius:1px;";
      m.title = "intent " + e.label + " " + e.t.toFixed(1) + "s (" + Math.round((e.conf || 0) * 100) + "%)";
      wrap.appendChild(m);
    });
    return wrap;
  }
  function rfTip(txt, tip) {
    var sp = document.createElement("span");
    sp.textContent = txt; sp.title = tip;
    sp.style.borderBottom = "1px dotted #4a5568"; sp.style.cursor = "help";
    return sp;
  }
  function rfBuildLanes(job, rec) {
    var expWake = rec ? String(rec.wake_word || "").trim() : "";
    var expAct = rec ? String(rec.action || "").trim() : "";
    var g1ByLane = {}, g2ByLane = {};
    (job.events || []).forEach(function (e) {
      var k = rfzLaneKey(e.g1_model, e.model, e.nc, archOf(e));
      if (e.kind === "g1") (g1ByLane[k] = g1ByLane[k] || []).push(e);
      else if (e.kind === "g2") (g2ByLane[k] = g2ByLane[k] || []).push(e);
    });
    var lanes = (job.summaries || []).map(function (s) {
      var key = rfzLaneKey(s.g1_model, s.model, s.nc, archOf(s));
      var wHits = expWake ? (g1ByLane[key] || []).filter(function (e) { return rfzBag(e.label) === rfzBag(expWake); }) : [];
      var g1ok = expWake ? (wHits.length > 0) : null;
      var matched = 0;
      if (expAct) Object.keys(s.intents || {}).forEach(function (k2) { if (rfzMatch(k2, expAct)) matched += (s.intents[k2] || 0); });
      var g2ok = expAct ? (matched > 0) : null;
      var verdict = (g1ok === null && g2ok === null) ? "na" : (g1ok === false && g2ok === false) ? "none" : (g2ok === false) ? "g2" : (g1ok === false) ? "g1" : "ok";
      return { s: s, key: key, g1ok: g1ok, wakeTimes: wHits.map(function (e) { return e.t; }), g2Times: (g2ByLane[key] || []), g2ok: g2ok, matched: matched, ticks: (s.command_ticks || 0), verdict: verdict };
    });
    var order = { none: 0, g2: 1, g1: 2, na: 3, ok: 4 };
    lanes.sort(function (a, b) { return (order[a.verdict] - order[b.verdict]) || (b.matched - a.matched); });
    return { lanes: lanes, expWake: expWake, expAct: expAct };
  }
  function rfDrawBars(cv, rows, color) {
    var W = 470, rowH = 15, padL = 112, padR = 64;
    cv.width = W; cv.height = Math.max(1, rows.length) * rowH + 4;
    cv.style.width = W + "px"; cv.style.height = cv.height + "px";
    var ctx = cv.getContext("2d");
    ctx.font = "10px 'Segoe UI',Arial";
    rows.forEach(function (r, i) {
      var y = i * rowH + 3;
      ctx.fillStyle = "#8b949e"; ctx.textAlign = "right"; ctx.fillText(String(r.label).slice(0, 15), padL - 6, y + 10);
      var frac = r.total ? r.ok / r.total : 0;
      ctx.fillStyle = "#21262d"; ctx.fillRect(padL, y, W - padL - padR, 9);
      ctx.fillStyle = color || "#238636"; ctx.fillRect(padL, y, (W - padL - padR) * frac, 9);
      ctx.fillStyle = "#e6edf3"; ctx.textAlign = "left"; ctx.fillText(r.ok + "/" + r.total, W - padR + 6, y + 10);
    });
  }
  function rfAxisCharts(host, entries) {
    // Bar charts of correct lanes per axis: Architecture / NC / Gate 1 / Gate 2 / Gate 3-5
    var arch = {}, ncG = {}, g1G = {}, g2G = {}, g3G = {};
    function bump(map, key, l) {
      if (l.verdict === "na") return;
      var e = map[key] = map[key] || { ok: 0, total: 0 };
      e.total++;
      if (l.g2ok === true) e.ok++;
    }
    entries.forEach(function (en) {
      var built = rfBuildLanes(en.job, en.rec);
      built.lanes.forEach(function (l) {
        var s = l.s;
        bump(arch, "v" + (archOf(s) + 1), l);
        bump(ncG, s.nc ? "canceller" : "raw", l);
        bump(g1G, String(s.g1_model || "?").replace("gate1", ""), l);
        bump(g2G, String(s.model || "?").replace("gate2", ""), l);
        if ((s.g3_fired || 0) > 0) {
          var routes = {};
          Object.keys(s.g3_labels || {}).forEach(function (k) {
            var parts = String(k).split(":");
            (routes[parts[0] || "?"] = routes[parts[0] || "?"] || []).push(parts.slice(1).join(":"));
          });
          Object.keys(routes).forEach(function (route) {
            if (l.verdict === "na") return;
            var e = g3G[route] = g3G[route] || { ok: 0, total: 0 };
            e.total++;
            if (built.expAct && routes[route].some(function (lb) { return rfzMatch(lb, built.expAct); })) e.ok++;
          });
        }
      });
    });
    var secs = [["Architecture", arch, "#1f6feb"], ["Noise canceller", ncG, "#238636"],
                ["Gate 1 · wake", g1G, "#8957e5"], ["Gate 2 · intent", g2G, "#d29922"],
                ["Gate 3-5 · specialists", g3G, "#db6d28"]];
    var grid = document.createElement("div");
    grid.style.cssText = "display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:8px;margin:6px 0;";
    var anyAxis = false;
    secs.forEach(function (sd) {
      var keys = Object.keys(sd[1]);
      if (!keys.length) return;
      anyAxis = true;
      var card = document.createElement("div");
      card.style.cssText = "border:1px solid #30363d;border-radius:8px;padding:8px 10px;background:#161b22;";
      var lab = document.createElement("div");
      lab.style.cssText = "font-size:11px;color:#58a6ff;margin-bottom:4px;font-weight:700;";
      lab.textContent = sd[0];
      lab.title = "Lanes whose fired action matched the expected action (ok) out of judged lanes (total), grouped by " + sd[0].toLowerCase() + ".";
      card.appendChild(lab);
      var cv = document.createElement("canvas");
      cv.style.cssText = "background:#0d1117;border:1px solid #30363d;border-radius:5px;max-width:100%;";
      var rows = keys.map(function (k) { return { label: k, ok: sd[1][k].ok, total: sd[1][k].total }; })
        .sort(function (a, b) { return (b.ok - a.ok) || (b.total - a.total); });
      rfDrawBars(cv, rows, sd[2]);
      cv.title = rows.map(function (r) { return r.label + ": " + r.ok + " correct of " + r.total + " judged"; }).join("\n");
      card.appendChild(cv);
      grid.appendChild(card);
    });
    if (anyAxis) host.appendChild(grid);
  }
  function rfFindLanes(q) {
    var out = [];
    (RF.takeViews || []).forEach(function (v) {
      if (!(v.card && v.card.isConnected)) return; // stale view from a cleared run
      (v.lanes || []).forEach(function (l) {
        var name = comboName(l.s);
        if (!q || name.toLowerCase().indexOf(q) >= 0) out.push({ view: v, lane: l, name: name });
      });
    });
    return out;
  }
  function rfFindRender() {
    var host = $("rf-findout"); if (!host) return;
    var q = (($("rf-find") && $("rf-find").value) || "").trim().toLowerCase();
    host.textContent = "";
    if (!q || q.length < 2) { host.style.display = "none"; return; }
    var matches = rfFindLanes(q).slice(0, 40);
    var info = document.createElement("div");
    info.style.cssText = "font-size:10px;color:#8b949e;margin-bottom:3px;";
    info.textContent = matches.length + " matching lane(s) — click to inspect" + (matches.length >= 40 ? " (first 40 shown)" : "");
    host.appendChild(info);
    matches.forEach(function (m) {
      var b = document.createElement("button");
      b.style.cssText = "display:block;width:100%;text-align:left;background:#21262d;color:#c9d1d9;border:1px solid #30363d;border-radius:5px;padding:3px 6px;margin:2px 0;font-size:10px;cursor:pointer;";
      var vtxt = m.lane.verdict === "ok" ? "✓" : (m.lane.verdict === "na" ? "–" : "✗");
      b.textContent = vtxt + " " + m.view.label + " · " + m.name + " · " + m.lane.matched + "/" + m.lane.ticks + " action ticks";
      b.title = "Jump to this take's summary and inspect the lane";
      b.addEventListener("click", function () {
        try { m.view.show(m.lane); } catch (e) { /* stale view */ }
        if (m.view.card && m.view.card.scrollIntoView) m.view.card.scrollIntoView({ block: "start" });
      });
      host.appendChild(b);
    });
    host.style.display = "block";
  }
  function rfProgress(show, pct, text) {
    var p = $("rf-progress"); if (!p) return;
    p.style.display = show ? "block" : "none";
    if (pct !== undefined) { var f = $("rf-progress-fill"); if (f) f.style.width = Math.max(0, Math.min(100, pct)) + "%"; }
    if (text !== undefined) { var t = $("rf-progress-text"); if (t) t.textContent = text; }
  }
  function rfSummary(job, host) {
    if (!host) host = $("rf-summary");
    if (!host || !job) return;
    host.textContent = "";
    var rec = RF.recs.filter(function (r) { return r.id === job.recording; })[0];
    var expWake = rec ? String(rec.wake_word || "").trim() : "";
    var expAct = rec ? String(rec.action || "").trim() : "";
    var dur = (isFinite(job.duration_s) && job.duration_s > 0) ? job.duration_s : 30;
    var head = document.createElement("div");
    head.style.cssText = "font-size:12px;font-weight:700;color:#58a6ff;margin:0 0 4px;";
    var ac = rfArchCodes(job.summaries);
    var gateTxt = " · Architecture " + (ac.length ? archNames(ac) : "v1 (all gates run)");
    head.textContent = "Summary — expected wake: " + (expWake || "—") + " · expected action: " + (expAct || "—") + gateTxt;
    head.title = "Correctness is scored against this take's tags: wake word vs Gate 1 fires, action vs Gate 2 fired intents. The charts below group correct lanes by axis.";
    host.appendChild(head);
    if (!expWake && !expAct) {
      var hint = document.createElement("div");
      hint.style.cssText = "font-size:10px;color:#f0883e;margin-bottom:4px;";
      hint.textContent = "Tag this take (wake word + main action) to score correctness.";
      host.appendChild(hint);
    }
    var built = rfBuildLanes(job, rec);
    var lanes = built.lanes;
    var g3GateByLane = {};
    (job.events || []).forEach(function (e) {
      if (e.kind === "g3" && e.gate) g3GateByLane[rfzLaneKey(e.g1_model, e.model, e.nc, archOf(e))] = String(e.gate);
    });
    var nOk = lanes.filter(function (l) { return l.verdict === "ok"; }).length;
    var nG1 = lanes.filter(function (l) { return l.g1ok === true; }).length;
    var nG2 = lanes.filter(function (l) { return l.g2ok === true; }).length;
    var agg = document.createElement("div");
    agg.style.cssText = "font-size:11px;color:#e6edf3;margin-bottom:6px;";
    agg.appendChild(document.createTextNode(lanes.length + " combinations · "));
    agg.appendChild(rfTip("fully correct " + nOk, "Lanes where BOTH the wake (Gate 1) and the action (Gate 2) matched this take's tags."));
    agg.appendChild(document.createTextNode(" · "));
    agg.appendChild(rfTip("Gate 1 (wake) correct " + nG1, "Lanes that fired the expected wake word (Nova/Piattos) with 2-of-3 votes above threshold."));
    agg.appendChild(document.createTextNode(" · "));
    agg.appendChild(rfTip("Gate 2 (action) correct " + nG2, "Lanes whose fired intent matched the expected action (bag-of-words match)."));
    host.appendChild(agg);
    if (!lanes.length) return;
    var byG1 = {}, byG2 = {};
    lanes.forEach(function (l) {
      byG1[l.s.g1_model] = byG1[l.s.g1_model] || { fired: 0, total: 0 };
      byG1[l.s.g1_model].total++; if (l.g1ok === true) byG1[l.s.g1_model].fired++;
      byG2[l.s.model] = byG2[l.s.model] || { matched: 0 };
      byG2[l.s.model].matched += l.matched;
    });
    var topG1 = Object.keys(byG1).sort(function (a, b) { return byG1[b].fired - byG1[a].fired; }).slice(0, 3);
    var topG2 = Object.keys(byG2).sort(function (a, b) { return byG2[b].matched - byG2[a].matched; }).slice(0, 3);
    var digest = document.createElement("div");
    digest.style.cssText = "font-size:10px;color:#8b949e;margin-bottom:8px;line-height:1.6;";
    digest.textContent = "Best wake variants: " + topG1.map(function (g) { return g.replace("gate1", "") + " " + byG1[g].fired + "/" + byG1[g].total; }).join(" · ")
      + "  |  Best intent models: " + topG2.map(function (g) { return g.replace("gate2", "") + " " + byG2[g].matched + " ticks"; }).join(" · ");
    digest.title = "Top 3 wake variants by expected-wake hits, and top 3 Gate 2 models by matched action ticks.";
    host.appendChild(digest);
    rfAxisCharts(host, [{ job: job, rec: rec }]);
    var best = lanes.find(function (l) { return l.verdict === "ok"; }) || lanes.find(function (l) { return l.g2ok === true; }) || lanes.find(function (l) { return l.g1ok === true; }) || lanes[0];
    var card = document.createElement("div");
    card.style.cssText = "border:1px solid #30363d;border-radius:8px;padding:8px;background:#0d1117;margin-bottom:8px;";
    var bt = document.createElement("div"); bt.style.cssText = "font-size:11px;font-weight:600;margin-bottom:6px;"; card.appendChild(bt);
    var tl = document.createElement("div"); card.appendChild(tl);
    var times = document.createElement("div"); times.style.cssText = "font-size:10px;color:#8b949e;margin-top:5px;line-height:1.5;"; card.appendChild(times);
    host.appendChild(card);
    function showLane(l) {
      var vtxt = l.verdict === "ok" ? "✓ CORRECT" : (l.verdict === "na" ? "not judgeable" : "✗ wrong");
      var slotTxt = "";
      if ((l.s.g3_fired || 0) > 0 && l.s.g3_top) {
        var sp_ = String(l.s.g3_top).split(":");
        var gate_ = g3GateByLane[l.key] || "";
        var gnum_ = gate_ === "gateN" ? "Gate 3" : (gate_ === "gate4" ? "Gate 4" : (gate_ === "gate5" ? "Gate 5" : (gate_ || "Gate 3-5")));
        slotTxt = " · slot via " + gnum_ + " (" + sp_[0] + "): " + sp_.slice(1).join(":");
      }
      bt.textContent = "Lane: " + comboName(l.s) + " · " + l.matched + "/" + l.ticks + " action ticks · " + vtxt + slotTxt;
      bt.title = "action ticks X/Y: ticks whose fired intent matched the expected action (Y = ticks that actually fired an action). ms mean/p95: Gate 2 inference latency per 1 s tick. cpu/tick: CPU time per tick (per worker thread).";
      bt.style.color = l.verdict === "ok" ? "#3fb950" : (l.verdict === "na" ? "#8b949e" : "#f85149");
      tl.textContent = ""; tl.appendChild(rfzTimeline(l, dur));
      var wakeTxt = l.wakeTimes.length ? l.wakeTimes.map(function (t) { return t.toFixed(1) + "s"; }).join(", ") : "never";
      var actTxt = l.g2Times.length ? l.g2Times.map(function (e) { return e.t.toFixed(1) + "s " + e.label; }).join(", ") : "never";
      var perf = [];
      if (l.s.mean_infer_ms !== undefined) perf.push(Math.round(l.s.mean_infer_ms * 10) / 10 + " ms mean · " + Math.round((l.s.p95_infer_ms || 0) * 10) / 10 + " ms p95");
      if (l.s.mean_cpu_ms !== undefined) perf.push(Math.round(l.s.mean_cpu_ms * 10) / 10 + " ms cpu/tick");
      times.textContent = "Wake fired at: " + wakeTxt + "   ·   Intent fired at: " + actTxt + (perf.length ? "   ·   " + perf.join(" · ") : "");
    }
    showLane(best);
    var pwrap = document.createElement("div");
    pwrap.style.cssText = "display:flex;gap:6px;align-items:center;margin-top:6px;";
    var plab = document.createElement("span"); plab.style.cssText = "font-size:10px;color:#8b949e;white-space:nowrap;"; plab.textContent = "Inspect lane:";
    var picker = document.createElement("select");
    picker.style.cssText = "background:#0d1117;color:var(--text);border:1px solid var(--line);border-radius:5px;padding:3px 6px;font-size:11px;max-width:330px;";
    var actLanes = lanes.filter(function (l) { return l.wakeTimes.length || l.g2Times.length; });
    (actLanes.length ? actLanes : lanes).slice(0, 400).forEach(function (l) {
      var o = document.createElement("option");
      o.value = l.key;
      o.textContent = comboName(l.s) + (l.verdict === "ok" ? " ✓" : l.verdict === "na" ? "" : " ✗");
      if (l === best) o.selected = true;
      picker.appendChild(o);
    });
    picker.addEventListener("change", function () {
      var l = lanes.filter(function (x) { return x.key === picker.value; })[0];
      if (l) showLane(l);
    });
    pwrap.appendChild(plab); pwrap.appendChild(picker); card.appendChild(pwrap);
    RF.takeViews = (RF.takeViews || []).filter(function (v) { return v.job !== job.id; });
    RF.takeViews.push({ job: job.id, label: (rec ? (rec.label || job.recording) : job.recording), lanes: lanes, show: showLane, card: card });
  }
  // --- Batch: run the selected combinations across several takes ---
  function updateBatchLabel() {
    var b = $("rf-batchstart"); if (!b) return;
    RF.batchIds = RF.batchIds || {};
    var n = Object.keys(RF.batchIds).length;
    b.textContent = "▶▶ Batch test (" + n + " take" + (n === 1 ? "" : "s") + ")";
    var d = $("rf-delselected");
    if (d) { d.textContent = "🗑 Delete (" + n + ")"; d.disabled = n === 0; }
  }
  function runJobFor(id, payload) {
    return send("POST", "/api/recordings/" + id + "/test", payload).then(function (d) {
      return new Promise(function (resolve) {
        (function pollOne() {
          get("/api/jobs/" + d.job.id).then(function (jd) {
            var j = jd.job;
            var pct = Math.round((j.progress || 0) * 100);
            var tickN = Math.round((j.progress || 0) * (j.ticks_total || 0));
            var lanesN = (j.combos || []).length;
            $("rf-bar").style.width = pct + "%";
            var ptxt = j.status + " " + pct + "%"
              + (j.ticks_total ? " · tick " + tickN + "/" + j.ticks_total : "")
              + (lanesN ? " · ~" + (tickN * lanesN) + "/" + ((j.ticks_total || 0) * lanesN) + " lane-scores" : "")
              + (j.workers > 1 ? " · " + j.workers + " workers" : "");
            $("rf-prog").textContent = ptxt;
            rfProgress(true, pct, ptxt);
            if (j.status === "running" || j.status === "queued") { setTimeout(pollOne, 700); return; }
            resolve(j);
          }).catch(function () { setTimeout(pollOne, 1200); });
        })();
      });
    });
  }
  function startBatch() {
    RF.batchIds = RF.batchIds || {};
    var ids = Object.keys(RF.batchIds);
    if (!ids.length && $("rf-rec").value) ids = [$("rf-rec").value];
    if (!ids.length) { say("check some takes in the list first (or select one)"); return; }
    var g1s = checked($("rf-g1box")), models = checked($("rf-mbox"));
    if (!g1s.length || !models.length) { say("select at least one Gate 1 variant and Gate 2 model"); return; }
    var modes = ncModes();
    var archSel = gateModes().slice();
    var archLbl = archNames(archSel);
    var wSel = $("rf-workers");
    var workers = (wSel && wSel.value !== "auto") ? Math.max(0, parseInt(wSel.value, 10) || 0) : 0;
    var payload = { g1_models: g1s, models: models, hop_s: 1.0, nc_modes: modes, architectures: archSel, workers: workers };
    RF.batchCancel = false;
    $("rf-start").disabled = true; $("rf-batchstart").disabled = true; $("rf-stop").disabled = false;
    var host = $("rf-results"); host.innerHTML = "";
    if ($("rf-summary")) $("rf-summary").textContent = "";
    var laneCount = g1s.length * models.length * modes.length * archSel.length;
    say("batch: " + ids.length + " take" + (ids.length === 1 ? "" : "s") + " × " + laneCount + " lanes each (G1 " + g1s.length + " × G2 " + models.length + " × NC " + modes.length + " × arch " + archSel.length + ": " + archLbl + ")" + (workers > 1 ? " · " + workers + " workers" : " · auto workers") + "…");
    rfProgress(true, 0, "batch: " + ids.length + " take" + (ids.length === 1 ? "" : "s") + "…");
    var results = [];
    (function next(i) {
      if (i >= ids.length || RF.batchCancel) {
        $("rf-start").disabled = false; $("rf-batchstart").disabled = false; $("rf-stop").disabled = true;
        $("rf-prog").textContent = RF.batchCancel ? "batch stopped" : "batch done";
        rfProgress(false);
        rfBestSummary();
        var head = document.createElement("div");
        head.style.cssText = "font-size:12px;font-weight:700;margin:0 0 8px;color:#58a6ff;";
        var ran = rfArchCodes(results.reduce(function (acc, j) { return acc.concat(j.summaries || []); }, []));
        var wUsed = (results[0] && results[0].workers) || payload.workers || 0;
        head.textContent = "Batch: " + results.length + "/" + ids.length + " takes tested · " + laneCount + " lanes/take (G1 " + g1s.length + " × G2 " + models.length + " × NC " + modes.length + " × arch " + (ran.length || archSel.length) + ": " + (ran.length ? archNames(ran) : archLbl) + ")" + (wUsed > 1 ? " · " + wUsed + " workers" : " · 1 worker") + " — per-take summaries above";
        head.title = "Each take was replayed through every selected lane; lanes scored in parallel across Gate 2 models.";
        host.insertBefore(head, host.firstChild);
        rfAxisCharts(host, results.map(function (j) { return { job: j, rec: RF.recs.filter(function (r) { return r.id === j.recording; })[0] }; }));
        say("batch finished — " + results.length + " takes tested");
        return;
      }
      var rec = RF.recs.filter(function (r) { return r.id === ids[i]; })[0];
      $("rf-prog").textContent = "take " + (i + 1) + "/" + ids.length + ": " + (rec ? (rec.label || ids[i]) : ids[i]);
      runJobFor(ids[i], payload).then(function (job) {
        results.push(job);
        var sec = document.createElement("div");
        sec.style.cssText = "border:1px solid #30363d;border-radius:8px;padding:10px;margin-bottom:10px;background:#161b22;";
        var h = document.createElement("div");
        h.style.cssText = "font-size:12px;font-weight:700;color:#58a6ff;margin-bottom:6px;";
        var ta = rfArchCodes(job.summaries);
        h.textContent = (i + 1) + ". " + (rec ? (rec.label || ids[i]) : ids[i]) + " · " + (job.summaries || []).length + " combinations · arch " + (ta.length ? archNames(ta) : archLbl);
        h.title = "Each combination lane is judged against this take's tags: wake word (Gate 1) and action (Gate 2).";
        sec.appendChild(h);
        var box = document.createElement("div");
        sec.appendChild(box);
        rfSummary(job, box);
        host.appendChild(sec);
        next(i + 1);
      }).catch(function (e) { say("take " + (i + 1) + " failed: " + e.message); next(i + 1); });
    })(0);
  }
  // --- Delete selected takes ---
  function deleteSelected() {
    RF.batchIds = RF.batchIds || {};
    var ids = Object.keys(RF.batchIds);
    if (!ids.length) { say("check the takes to delete first"); return; }
    if (!window.confirm("Delete " + ids.length + " take" + (ids.length === 1 ? "" : "s") + " permanently? This cannot be undone.")) { say("delete cancelled"); return; }
    var done = 0, failed = 0;
    (function next(i) {
      if (i >= ids.length) {
        RF.batchIds = {};
        updateBatchLabel();
        say("deleted " + done + " take" + (done === 1 ? "" : "s") + (failed ? " · " + failed + " failed" : ""));
        loadRecs();
        return;
      }
      send("DELETE", "/api/recordings/" + ids[i], {}).then(function () {
        done++; next(i + 1);
      }).catch(function (e) { failed++; say("delete failed: " + e.message); next(i + 1); });
    })(0);
  }
  // --- Best combination across runs (demo recommendation) ---
  function rfBestSummary() {
    var host = $("rf-best"); if (!host) return;
    host.textContent = "";
    var head = document.createElement("div");
    head.style.cssText = "font-size:11px;font-weight:700;color:#58a6ff;margin-bottom:6px;";
    head.textContent = "🏆 Best combination across runs";
    host.appendChild(head);
    Promise.all([get("/api/results"), get("/api/recordings")]).then(function (all) {
      var recs = all[1].recordings || [];
      var tags = {};
      recs.forEach(function (r) { tags[r.id] = r; });
      var jobs = (all[0].results || []).filter(function (j) { return (j.summaries || []).length && tags[j.recording]; }).slice(0, 12);
      host.textContent = "";
      host.appendChild(head);
      if (!jobs.length) {
        var n = document.createElement("div"); n.style.cssText = "font-size:10px;color:#8b949e;";
        n.textContent = "run a test on a tagged take to see which combination wins across scenarios";
        host.appendChild(n); return;
      }
      var byCombo = {}, perTake = [];
      jobs.forEach(function (j) {
        var rec = tags[j.recording];
        var expAct = String(rec.action || "").trim();
        var laneWin = null;
        (j.summaries || []).forEach(function (s) {
          var k = rfzLaneKey(s.g1_model, s.model, s.nc, archOf(s));
          var c = byCombo[k] = byCombo[k] || { g1: s.g1_model, g2: s.model, nc: !!s.nc, gated: !!s.gated, arch: archOf(s), takes: 0, triggered: 0, matched: 0, ticks: 0, latSum: 0, latTicks: 0, cpuSum: 0 };
          c.takes += 1;
          if ((s.trigger_ticks || 0) > 0) c.triggered += 1;
          var m = 0;
          if (expAct) Object.keys(s.intents || {}).forEach(function (k2) { if (rfzMatch(k2, expAct)) m += (s.intents[k2] || 0); });
          if (m > 0) c.matched += 1;
          c.ticks += (s.command_ticks || 0);
          var tks = Math.max(1, s.ticks || 1);
          c.latSum += (s.mean_infer_ms || 0) * tks; c.latTicks += tks;
          c.cpuSum += (s.mean_cpu_ms || 0) * tks;
          if (!laneWin || m > laneWin.m || (m === laneWin.m && (s.trigger_ticks || 0) > (laneWin.s.trigger_ticks || 0))) laneWin = { s: s, m: m };
        });
        if (laneWin) perTake.push({ job: j, rec: rec, lane: laneWin });
      });
      var combos = Object.keys(byCombo).map(function (k) { return byCombo[k]; });
      combos.sort(function (a, b) {
        return (b.matched - a.matched) || (b.triggered - a.triggered) ||
          (a.latSum / Math.max(1, a.latTicks) - b.latSum / Math.max(1, b.latTicks));
      });
      var w = combos[0];
      if (w) {
        var lat = w.latTicks ? (w.latSum / w.latTicks).toFixed(1) + " ms mean" : "—";
        var win = document.createElement("div");
        win.style.cssText = "font-size:12px;font-weight:700;color:#3fb950;margin-bottom:6px;";
        win.textContent = "★ Recommended for demo: " + comboName({ g1_model: w.g1, model: w.g2, nc: w.nc, gated: w.gated, arch: w.arch }) +
          " — intent correct in " + w.matched + "/" + w.takes + " takes · triggered " + w.triggered + "/" + w.takes + " · " + lat;
        host.appendChild(win);
      }
      var tbl = document.createElement("table");
      tbl.style.cssText = "border-collapse:collapse;font-size:10px;width:100%;max-width:760px;margin-bottom:8px;";
      var thead = document.createElement("thead"); var hr = document.createElement("tr");
      ["Combination", "Intent correct", "Triggered", "Latency", "CPU (approx)"].forEach(function (t) {
        var th = document.createElement("th");
        th.style.cssText = "text-align:left;border-bottom:1px solid #30363d;padding:2px 6px;color:#8b949e;";
        th.textContent = t; hr.appendChild(th);
      });
      thead.appendChild(hr); tbl.appendChild(thead);
      var tbody = document.createElement("tbody");
      combos.slice(0, 5).forEach(function (c) {
        var tr = document.createElement("tr");
        var lat = c.latTicks ? (c.latSum / c.latTicks).toFixed(1) + " ms" : "—";
        var cpu = c.latTicks ? (c.cpuSum / c.latTicks).toFixed(1) + " ms/tick" : "—";
        [[comboName({ g1_model: c.g1, model: c.g2, nc: c.nc, gated: c.gated }), "#e6edf3"],
         [c.matched + "/" + c.takes + " takes", c.matched ? "#3fb950" : "#f85149"],
         [c.triggered + "/" + c.takes, "#8b949e"],
         [lat, "#8b949e"], [cpu, "#8b949e"]].forEach(function (p) {
          var td = document.createElement("td");
          td.style.cssText = "padding:2px 6px;border-bottom:1px solid #21262d;color:" + p[1] + ";";
          td.textContent = p[0]; tr.appendChild(td);
        });
        tbody.appendChild(tr);
      });
      tbl.appendChild(tbody); host.appendChild(tbl);
      var pw = document.createElement("div");
      pw.style.cssText = "font-size:10px;color:#8b949e;line-height:1.6;";
      pw.textContent = "Best per scenario (newest first): " + perTake.slice(0, 8).map(function (p) {
        return (p.rec.label || p.job.label || p.job.recording) + " → " + comboName(p.lane.s) + (p.lane.m ? " ✓" : " ✗");
      }).join("  |  ");
      host.appendChild(pw);
      var note = document.createElement("div");
      note.style.cssText = "font-size:9px;color:#8b949e;margin-top:4px;";
      note.textContent = "Ranked by intent-correct takes → triggers → latency across the last " + jobs.length + " runs. CPU is approximate (process-wide timer).";
      host.appendChild(note);
    }).catch(function (e) {
      host.textContent = "";
      var err = document.createElement("div"); err.style.cssText = "font-size:10px;color:#f85149;";
      err.textContent = "best-across-runs failed: " + e.message; host.appendChild(err);
    });
  }

  function render(job) {
    var host = $("rf-results"); host.innerHTML = "";
    rfSummary(job, $("rf-summary"));
    RF.job = job; RF.cards = [];
    var rec = RF.recs.filter(function (r) { return r.id === job.recording; })[0];
    var dur = (isFinite(job.duration_s) && job.duration_s > 0) ? job.duration_s : ((rec && (rec.duration_s || rec.duration)) || 30);
    var title = "Testing: " + (rec ? rec.label || "recording" : job.label || "recording") + " · " + dur + " s · " + (job.combos || []).length + " combinations";
    var t = document.createElement("div"); t.style.cssText = "font-size:12px;font-weight:600;margin:8px 0 6px;"; t.textContent = title; host.appendChild(t);
    var rows = (job.summaries || []).slice().sort(function (a, b) { return (b.trigger_ticks || 0) - (a.trigger_ticks || 0); });
    if (!rows.length) {
      var note = document.createElement("div");
      note.style.cssText = "font-size:11px;color:#8b949e;margin:4px 0 10px;";
      note.textContent = "No per-combination data in this run (saved before the matrix upgrade) — re-run the test from the lab to get per-combination gantts.";
      host.appendChild(note);
    }
    var tooMany = rows.length > 24;
    var showRows = tooMany ? rows.filter(function (s) { return (s.trigger_ticks || 0) > 0; }).slice(0, 20) : rows;
    if (tooMany) {
      var cap = document.createElement("div");
      cap.style.cssText = "font-size:10px;color:#8b949e;margin:2px 0 8px;";
      cap.textContent = rows.length + " combinations ran — showing the " + showRows.length + " lanes that actually triggered; the summary above has the full digest.";
      host.appendChild(cap);
    }
    showRows.forEach(function (s) {
      var key = (s.g1_model || "") + "|" + (s.model || "") + "|" + (s.nc ? 1 : 0) + "|" + archOf(s);
      var evs = (job.events || []).filter(function (e) {
        return ((e.g1_model || "") + "|" + (e.model || "") + "|" + (e.nc ? 1 : 0) + "|" + archOf(e)) === key;
      });
      // Top 4 intents (threshold-per-frame lanes): from the summary's per-intent tick counts
      var top4 = Object.keys(s.intents || {}).map(function (k) { return { intent: k, ticks: s.intents[k] }; })
        .sort(function (a, b) { return b.ticks - a.ticks; }).slice(0, 4);
      var card = document.createElement("div");
      card.style.cssText = "background:var(--panel);border:1px solid var(--line);border-radius:8px;padding:10px;margin-bottom:10px;";
      var head = document.createElement("div");
      head.style.cssText = "display:flex;justify-content:space-between;align-items:center;font-size:12px;margin-bottom:6px;";
      var nm = document.createElement("span"); nm.textContent = comboName(s) + "  ·  " + (s.trigger_ticks || 0) + " triggers";
      var act = document.createElement("span"); act.style.cssText = "font-size:11px;font-weight:600;color:" + (s.trigger_ticks ? "#3fb950" : "#8b949e") + ";";
      act.textContent = "Action Taken: " + (s.trigger_ticks ? (s.top_intent || "—") + (s.top_intent_conf ? " (" + Math.round(s.top_intent_conf * 100) + "%)" : "") : "no trigger");
      head.appendChild(nm); head.appendChild(act);
      if ((s.g3_fired || 0) > 0 && s.g3_top) {
        var slv = String(s.g3_top).split(":").pop();
        var sl = document.createElement("span");
        sl.style.cssText = "font-size:11px;font-weight:600;color:#3fb950;";
        sl.textContent = "· slot (" + slv + ")";
        head.appendChild(sl);
      }
      card.appendChild(head);
      var wrap = document.createElement("div"); wrap.style.cssText = "position:relative;";
      var cv = document.createElement("canvas");
      cv.style.cssText = "width:100%;display:block;border:1px solid var(--line);border-radius:4px;background:#0d1117;";
      var ph = document.createElement("div");
      ph.style.cssText = "position:absolute;top:0;bottom:0;width:2px;background:#f85149;display:none;pointer-events:none;";
      wrap.appendChild(cv); wrap.appendChild(ph); card.appendChild(wrap);
      if ((s.trigger_ticks || 0) === 0 && archOf(s) >= 1 &&
          !evs.some(function (e) { return e.kind === "g1"; })) {
        var why = document.createElement("div");
        why.style.cssText = "font-size:10px;color:#f0883e;margin:2px 0 4px;";
        why.textContent = "Gate 1 never fired the wake — Architecture v" + (archOf(s) + 1) + " keeps Gate 2 silent by design.";
        card.insertBefore(why, wrap);
      }
      host.appendChild(card);
      drawGantt(cv, dur, evs, top4);
      RF.cards.push({ cv: cv, ph: ph, dur: dur });
    });
    drawPlayhead();
    rfBestSummary();
  }
  window.rfRender = render;   // probe/introspection handle
  // Gantt per combination: G1 wake lane, G2 intent lane (label+conf), gray
  // below-threshold ticks, and one "threshold-per-frame" lane per top intent.
  function drawGantt(canvas, dur, evs, top4) {
    var pps = 24, laneH = 16, gap = 5, axisH = 20, left = 8;
    var lanes = 2 + (top4 || []).length;
    if (!(isFinite(dur) && dur > 0)) dur = 30; // old/odd runs must not paint NaN-sized canvases
    canvas.width = left + Math.max(400, Math.ceil(dur * pps)) + 40;
    canvas.height = axisH + lanes * (laneH + gap) + 6;
    var ctx = canvas.getContext("2d");
    ctx.fillStyle = "#0d1117"; ctx.fillRect(0, 0, canvas.width, canvas.height);
    for (var s = 0; s <= dur; s += 2) {
      var x = left + s * pps;
      ctx.strokeStyle = (s % 5 === 0) ? "#30363d" : "#1c2128";
      ctx.beginPath(); ctx.moveTo(x, axisH - 4); ctx.lineTo(x, canvas.height); ctx.stroke();
      if (s % 5 === 0) { ctx.fillStyle = "#8b949e"; ctx.font = "9px Arial"; ctx.fillText(s + "s", x + 2, axisH - 8); }
    }
    var y = axisH;
    function laneBar(px, w, color, label, conf, laneY) {
      var x = left + px * pps;
      var ww = Math.min(w * pps, canvas.width - x - 30);
      if (ww <= 0) return;
      ctx.fillStyle = color; ctx.fillRect(x, laneY, ww, laneH);
      if (label) {
        ctx.fillStyle = "#0d1117"; ctx.font = "bold 8px Arial";
        var txt = label + (conf != null ? " " + Math.round(conf * 100) + "%" : "");
        ctx.fillText(txt, x + 3, laneY + laneH - 4);
      }
    }
    ctx.fillStyle = "#58a6ff"; ctx.font = "bold 9px Arial"; ctx.fillText("G1 wake", left, y + 12);
    evs.forEach(function (e) { if (e.kind === "g1") laneBar(e.t, 12, "#58a6ff", "wake", e.conf, y); });
    y += laneH + gap;
    ctx.fillStyle = "#3fb950"; ctx.font = "bold 9px Arial"; ctx.fillText("G2 intent", left, y + 12);
    evs.forEach(function (e) {
      if (e.kind === "g2") laneBar(e.t, 8, "#3fb950", e.label, e.conf, y);
      else if (e.kind === "g2-low") { var lx = left + e.t * pps; ctx.fillStyle = "#6e7681"; ctx.fillRect(lx, y, 2, laneH); }
      else if (e.kind === "g3") { var gx = left + e.t * pps; ctx.fillStyle = "#f0883e"; ctx.fillRect(gx, y, 4, laneH); }
    });
    y += laneH + gap;
    (top4 || []).forEach(function (ti, i) {
      var col = RF_INTENT_COLORS[i % RF_INTENT_COLORS.length];
      ctx.fillStyle = col; ctx.font = "bold 9px Arial";
      ctx.fillText(ti.intent + " (" + ti.ticks + ")", left, y + 12);
      evs.forEach(function (e) {
        if ((e.kind === "g2" || e.kind === "g3") && e.label === ti.intent) {
          var x = left + e.t * pps;
          ctx.fillStyle = col; ctx.fillRect(x, y, 6, laneH);
        }
      });
      y += laneH + gap;
    });
  }
  function fmtTime(t) { return (isFinite(t) ? t : 0).toFixed(1) + "s"; }
  function play() {
    var id = $("rf-rec").value; if (!id) { say("select a recording first"); return; }
    // Play doubles as Resume: if the same take is loaded but merely paused,
    // continue from the paused position instead of restarting from 0 s.
    if (RF.audio && RF.audio.src.indexOf(id) >= 0 && RF.audio.paused && !RF.audio.ended) {
      RF.audio.play().catch(function (e) { say("resume failed: " + e.message); });
      RF.playing = true; setAudioBtns(); startWave();
      say("resumed at " + fmtTime(RF.audio.currentTime));
      return;
    }
    stopAudio();
    var a = new Audio("/api/recordings/" + id + "/audio");
    RF.audio = a; RF.playing = true;
    a.onended = function () { RF.playing = false; hidePlayheads(); stopWave(); setAudioBtns(); };
    a.play().catch(function (e) { say("play failed: " + e.message); RF.playing = false; });
    setAudioBtns(); startWave();
    var taken = RF.recs.filter(function (r) { return r.id === id; })[0];
    say("playing " + ((taken && taken.label) || id));
  }
  function togglePause() {
    var a = RF.audio;
    if (!a) { say("nothing loaded — press ▶ Play first"); return; }
    if (a.paused) {
      a.play().catch(function (e) { say("resume failed: " + e.message); });
      RF.playing = true; startWave(); say("resumed at " + fmtTime(a.currentTime));
    } else {
      a.pause(); RF.playing = false; stopWave();
      say("paused at " + fmtTime(a.currentTime) + " — ▶ Play resumes");
    }
    setAudioBtns();
  }
  function setAudioBtns() {
    var a = RF.audio, playing = !!(a && !a.paused && !a.ended);
    var pb = $("rf-play"), pb2 = $("rf-pause");
    if (pb) pb.textContent = (a && a.paused && !a.ended) ? "▶ Resume" : "▶ Play";
    if (pb2) { pb2.disabled = !a; pb2.textContent = playing ? "⏸ Pause" : "▶ Resume"; }
  }
  function stopAudio() {
    if (RF.audio) { RF.audio.pause(); RF.audio.currentTime = 0; RF.audio = null; }
    RF.playing = false; stopWave(); hidePlayheads(); setAudioBtns();
  }
  // Live waveform + level from the playing audio via Web Audio analyser
  function startWave() {
    stopWave();
    var cv = $("rf-wave"); if (!cv) return;
    var ctx = cv.getContext("2d");
    try {
      if (!RF.actx) RF.actx = new (window.AudioContext || window.webkitAudioContext)();
      if (RF.actx.state === "suspended") RF.actx.resume();
      // A MediaElementSource can only be created once per element — re-creating
      // it on every resume threw InvalidStateError and killed the waveform.
      if (!RF.mediaSrc || RF.mediaAudio !== RF.audio) {
        RF.mediaSrc = RF.actx.createMediaElementSource(RF.audio);
        RF.mediaAudio = RF.audio;
        RF.analyser = RF.actx.createAnalyser(); RF.analyser.fftSize = 1024;
        RF.mediaSrc.connect(RF.analyser); RF.analyser.connect(RF.actx.destination);
        RF.waveData = new Float32Array(RF.analyser.fftSize);
      }
    } catch (e) { RF.analyser = null; say("waveform unavailable: " + e.message); }
    function loop() {
      RF.waveTimer = requestAnimationFrame(loop);
      ctx.fillStyle = "#0d1117"; ctx.fillRect(0, 0, cv.width, cv.height);
      if (RF.analyser) {
        RF.analyser.getFloatTimeDomainData(RF.waveData);
        ctx.strokeStyle = "#58a6ff"; ctx.lineWidth = 1.5; ctx.beginPath();
        var peak = 0;
        for (var i = 0; i < RF.waveData.length; i += 4) {
          var x = i / RF.waveData.length * cv.width, yv = cv.height / 2 + RF.waveData[i] * (cv.height / 2 - 4);
          if (i === 0) ctx.moveTo(x, yv); else ctx.lineTo(x, yv);
          var ab = Math.abs(RF.waveData[i]); if (ab > peak) peak = ab;
        }
        ctx.stroke(); ctx.lineWidth = 1;
        var lv = $("rf-level"); if (lv) lv.style.width = Math.min(100, Math.round(peak * 160)) + "%";
      } else {
        ctx.fillStyle = "#8b949e"; ctx.font = "10px Arial"; ctx.fillText("playing " + (RF.audio ? RF.audio.currentTime.toFixed(1) : "?") + "s", 8, cv.height / 2);
      }
      drawPlayhead();
    }
    loop();
  }
  function stopWave() {
    if (RF.waveTimer) { cancelAnimationFrame(RF.waveTimer); RF.waveTimer = null; }
    try { if (RF.mediaSrc) { RF.mediaSrc.disconnect(); RF.mediaSrc = null; RF.mediaAudio = null; } } catch (e) {}
    var lv = $("rf-level"); if (lv) lv.style.width = "0%";
    var cv = $("rf-wave"); if (cv) { var ctx = cv.getContext("2d"); ctx.fillStyle = "#0d1117"; ctx.fillRect(0, 0, cv.width, cv.height); }
  }
  // Red playhead across every drawn combination gantt while audio plays
  function drawPlayhead() {
    if (!RF.cards) return;
    var t = RF.audio ? RF.audio.currentTime : 0;
    RF.cards.forEach(function (c) {
      if (!c.ph) return;
      if (RF.playing && c.dur > 0) {
        var frac = Math.min(1, t / c.dur);
        c.ph.style.display = "block";
        c.ph.style.left = (frac * 100) + "%";
      } else c.ph.style.display = "none";
    });
  }
  function hidePlayheads() { (RF.cards || []).forEach(function (c) { if (c.ph) c.ph.style.display = "none"; }); }
  function reset() {
    stopAudio(); if (RF.pollTimer) { clearTimeout(RF.pollTimer); RF.pollTimer = null; }
    $("rf-results").innerHTML = ""; RF.cards = [];
    $("rf-bar").style.width = "0%"; $("rf-prog").textContent = "idle"; say("reset");
  }
  $("all-recframe-toggle").addEventListener("click", open);
  $("rf-refresh").addEventListener("click", loadRecs);
  $("recframe-back").addEventListener("click", close);
  $("rf-start").addEventListener("click", startTest);
  $("rf-batchstart").addEventListener("click", startBatch);
  $("rf-delselected").addEventListener("click", deleteSelected);
  $("rf-selall").addEventListener("change", function () {
    RF.batchIds = RF.batchIds || {};
    var on = this.checked;
    filteredRecs().forEach(function (r) { if (on) RF.batchIds[r.id] = true; else delete RF.batchIds[r.id]; });
    renderRecPane();
  });
  $("rf-stop").addEventListener("click", function () { RF.batchCancel = true; if (RF.jobId) send("POST", "/api/jobs/" + RF.jobId + "/cancel", {}); });
  $("rf-play").addEventListener("click", play);
  $("rf-pause").addEventListener("click", togglePause);
  $("rf-stopaudio").addEventListener("click", function () { stopAudio(); say("audio stopped — ▶ Play restarts from 0 s"); });
  $("rf-selectall").addEventListener("click", function () {
    var g = document.querySelectorAll("#rf-g1box input"), m = document.querySelectorAll("#rf-mbox input");
    g.forEach(function (c) { c.checked = true; }); m.forEach(function (c) { c.checked = true; });
    updateCount();
    say("all selected: " + g.length + " Gate 1 × " + m.length + " Gate 2 = " + (g.length * m.length) + " combinations");
  });
  $("rf-clearall").addEventListener("click", function () {
    document.querySelectorAll("#rf-g1box input, #rf-mbox input").forEach(function (c) { c.checked = false; });
    updateCount(); say("all combinations cleared");
  });
  $("rf-quickset").addEventListener("click", function () {
    // Same quick pair as the Recording Lab (QUICK / G1QUICK there)
    var qG1 = ["gate1v12_f16", "gate1v8_f32"];
    var qG2 = ["gate2v21p", "gate2v22", "gate2v46_impwarp", "gate2v56_v54", "gate2v56_v54b", "gate2v19"];
    document.querySelectorAll("#rf-g1box input").forEach(function (c) { c.checked = qG1.indexOf(c.value) >= 0; });
    document.querySelectorAll("#rf-mbox input").forEach(function (c) { c.checked = qG2.indexOf(c.value) >= 0; });
    updateCount();
    say("quick set: " + checked($("rf-g1box")).length + " G1 × " + checked($("rf-mbox")).length + " G2 = " + (checked($("rf-g1box")).length * checked($("rf-mbox")).length) + " combinations");
  });
  $("rf-reset").addEventListener("click", reset);
   ["rf-fwake", "rf-faction", "rf-fsource", "rf-label", "rf-fsearch"].forEach(function (id) {
     var e = $(id); if (e) e.addEventListener("change", renderRecPane);
   });
   if ($("rf-fsearch")) $("rf-fsearch").addEventListener("input", renderRecPane);
   if ($("rf-savetags")) $("rf-savetags").addEventListener("click", saveTags);
   // --- phrases helper (ⓘ): example commands for the selected main action ---
   var RF_PHRASES = {music_play: ["play some music","play my favourite playlist"], search: ["search the web for tomorrow's weather","search for chicken adobo recipes"], lights_on: ["turn on the lights","lights on in the kitchen"], lights_off: ["turn off the lights","lights off"], lights_dim: ["dim the lights","dim the living room lights"], lights_bright: ["brighten the lights","make the lights brighter"], timer_set: ["set a timer for five minutes","start a ten minute timer"], alarm_set: ["set an alarm for six thirty","wake me up at seven a m"], temp_up: ["turn the temperature up","make it warmer in here"], temp_down: ["turn the temperature down","make it cooler please"], media_play: ["play the video","resume the movie"], media_pause: ["pause the video","pause the movie"], media_next: ["next track","skip to the next song"], media_prev: ["previous track","go back one song"], volume_up: ["turn the volume up","louder please"], volume_down: ["turn the volume down","quieter please"], reminder_set: ["remind me to call mama at five","set a reminder for my meeting"], reminder_check: ["what are my reminders","read out my reminders"], call: ["call John","call the office"], silence: ["stop listening","go to sleep"]};
   function rfWakePrefix() { var w = ($("rf-recwake") && $("rf-recwake").value) || ($("rf-tagwake") && $("rf-tagwake").value) || ""; return (w === "Piattos" || w === "Nova") ? w : "[wake]"; }
   function rfRenderPhrases() {
     var body = $("rf-phrasepanel"); if (!body) return;
     var act = (($("rf-tagaction") && $("rf-tagaction").value) || "").trim().toLowerCase();
     var act2 = (($("rf-recaction") && $("rf-recaction").value) || "").trim().toLowerCase();
     var sel = act || act2;
     var pre = rfWakePrefix();
     var keys = Object.keys(RF_PHRASES);
     if (sel && keys.indexOf(sel) >= 0) keys = [sel].concat(keys.filter(function (k) { return k !== sel; }));
     body.textContent = "";
     var head = document.createElement("div");
     head.style.color = "#8b949e";
     head.style.marginBottom = "4px";
     head.textContent = "Say the wake word first, then the command:" + (sel ? " (showing " + sel + " first)" : "");
     body.appendChild(head);
     keys.forEach(function (k) {
       var row = document.createElement("div");
       row.style.margin = "3px 0";
       if (k === sel) { row.style.background = "#1c2b3a"; row.style.borderRadius = "4px"; row.style.padding = "2px 4px"; }
       var b = document.createElement("b");
       b.className = "rfpk";
       b.style.color = "#58a6ff";
       b.textContent = k;
       row.appendChild(b);
       row.appendChild(document.createElement("br"));
       RF_PHRASES[k].forEach(function (p, i) {
         if (i) row.appendChild(document.createTextNode(" · "));
         row.appendChild(document.createTextNode("“" + pre + ", " + p + "”"));
       });
       body.appendChild(row);
     });
   }
   function rfPhrasesOpen(show) {
     var p = $("rf-phrasepanel"); if (!p) return;
     p.style.display = (show === undefined) ? (p.style.display === "block" ? "none" : "block") : (show ? "block" : "none");
     if (p.style.display === "block") rfRenderPhrases();
   }
if ($("rf-phrasebtn")) $("rf-phrasebtn").addEventListener("click", function () { rfPhrasesOpen(); });
if ($("rf-recinfo")) $("rf-recinfo").addEventListener("click", function () { rfPhrasesOpen(true); var p = $("rf-phrasepanel"); if (p) p.scrollIntoView({ block: "nearest" }); });
   [("rf-tagaction"), ("rf-recaction")].forEach(function (id) {
     var e = $(id); if (e) e.addEventListener("input", function () { var p = $("rf-phrasepanel"); if (p && p.style.display === "block") rfRenderPhrases(); });
   });
   [("rf-recwake"), ("rf-tagwake")].forEach(function (id) {
     var e = $(id); if (e) e.addEventListener("change", function () { var p = $("rf-phrasepanel"); if (p && p.style.display === "block") rfRenderPhrases(); });
   });
   if ($("rf-modelsearch")) $("rf-modelsearch").addEventListener("input", applyModelFilter);
   if ($("rf-find")) {
     $("rf-find").addEventListener("input", rfFindRender);
     $("rf-find").addEventListener("keydown", function (e) { if (e.key === "Escape") { $("rf-find").value = ""; rfFindRender(); } });
   }
   if ($("rf-ncmode")) $("rf-ncmode").addEventListener("change", updateCount);
   if ($("rf-gatemode")) $("rf-gatemode").addEventListener("change", updateCount);
   if ($("rf-selectvisible")) $("rf-selectvisible").addEventListener("click", function () {
     document.querySelectorAll("#rf-g1box label, #rf-mbox label").forEach(function (l) {
       if (l.style.display !== "none") { var c = l.querySelector("input"); if (c) c.checked = true; }
     });
     updateCount();
     say("ticked every visible model — hidden ticks were kept");
   });
   $("rf-recnew").addEventListener("click", rfRecStart);
   $("rf-recpause").addEventListener("click", rfRecPause);
   $("rf-recstop").addEventListener("click", rfRecStop);
   $("rf-recdiscard").addEventListener("click", rfRecDiscard);
  $("rf-label").addEventListener("change", function () {
    var l = $("rf-label").value, rec = $("rf-rec");
    RF.recs.forEach(function (r, i) { rec.options[i].style.display = (!l || r.label === l) ? "" : "none"; });
    var firstVisible = RF.recs.findIndex(function (r) { return !l || r.label === l; });
    if (firstVisible >= 0) rec.selectedIndex = firstVisible;
  });
  document.addEventListener("keydown", function (ev) {
    if (ev.key === "Escape" && $("recframe").style.display === "block") close();
  });
})();
</script>
</body>
</html>
