<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="icon" href="data:,">
<title>VCM Pipeline — All in One (pseudo-code)</title>
<script>
// Client-error flight recorder: every uncaught error/rejection is POSTed to the
// server diag log (logs/live_YYYYMMDD.jsonl) so a stalled gantt or dead button
// can be troubleshooted after the fact instead of failing silently.
(function () {
  "use strict";
  var sent = 0;
  function report(kind, msg, extra) {
    try {
      if (++sent > 40) return; // don't spam the log on a broken loop
      var banner = document.getElementById("ui-error-banner");
      if (!banner && document.body) {
        banner = document.createElement("div"); banner.id = "ui-error-banner";
        banner.style.cssText = "position:fixed;top:0;left:0;right:0;z-index:2000;background:#b62324;color:#fff;font:11px/1.4 Segoe UI,Arial,sans-serif;padding:3px 10px;display:none;";
        document.body.appendChild(banner);
      }
      if (banner) { banner.style.display = "block"; banner.textContent = "⚠ UI error (logged) — " + msg.slice(0, 160); clearTimeout(report._t); report._t = setTimeout(function () { banner.style.display = "none"; }, 8000); }
      fetch("/api/client-log", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ kind: kind, message: String(msg).slice(0, 500), url: location.href, extra: extra || {} }) }).catch(function () {});
    } catch (e) {}
  }
  window.onerror = function (m, s, l, c) { report("window.onerror", m, { source: s, line: l, col: c }); };
  window.addEventListener("unhandledrejection", function (ev) { report("unhandledrejection", (ev.reason && (ev.reason.message || ev.reason)) || "unknown", { reason: String(ev.reason).slice(0, 300) }); });
  window.VCM_UI_ERRORS = { report: report };
})();
</script>
<!-- action light row before slot row: action light row before slot (layout order note) -->
<style>
:root{color-scheme:dark;--bg:#0d1117;--panel:#161b22;--panel2:#121820;--line:#30363d;--text:#e6edf3;--muted:#8b949e;--blue:#1f6feb;--green:#2ea043;--amber:#d29922;--purple:#a371f7;--orange:#f0883e}
*{box-sizing:border-box}
html,body{width:100%;height:100%;margin:0}
body{overflow:hidden;background:var(--bg);color:var(--text);font:14px/1.35 "Segoe UI",Arial,sans-serif}
/* The control rail sizes to its content: a hard 66px row clipped the third row of
   controls (Reset + the Nova/Piattos/G2-min threshold sliders) out of view. */
.app-shell{width:100%;height:100vh;max-width:1680px;margin:0 auto;padding:7px 10px;display:grid;grid-template-rows:36px auto minmax(0,1fr);gap:7px;overflow:hidden}
.topbar{display:flex;align-items:center;justify-content:space-between;gap:12px;min-width:0}
.brand{display:flex;align-items:baseline;gap:12px;min-width:0}.brand h1{font-size:18px;line-height:1;margin:0;white-space:nowrap}.brand .sub{font-size:11px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#status{font-size:11px;color:var(--muted);padding:4px 9px;border:1px solid var(--line);border-radius:99px;white-space:nowrap}
#status.err{color:#ff7b72;border-color:#b62324}
.control-rail{min-width:0;background:var(--panel);border:1px solid var(--line);border-radius:8px;padding:5px 8px;display:grid;grid-template-columns:minmax(150px,.8fr) minmax(180px,1fr) auto minmax(370px,2fr);gap:8px;align-items:center}
.control-field{min-width:0}.control-field label,.threshold-title{display:block;color:var(--muted);font-size:10px;line-height:1.1;margin:0 0 3px}
select{width:100%;min-width:0;background:#21262d;color:var(--text);border:1px solid var(--line);border-radius:5px;padding:4px 7px;font-size:11px}
button{background:#21262d;color:#c9d1d9;border:1px solid var(--line);border-radius:5px;padding:5px 9px;cursor:pointer;font-size:11px;white-space:nowrap}
button:hover{background:#30363d}
.threshold-controls{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:7px;min-width:0}
.threshold-control{min-width:0;color:var(--muted);font-size:10px}.threshold-control .range-label{display:flex;justify-content:space-between;gap:4px;margin-bottom:2px}.threshold-control output{color:var(--text);font-variant-numeric:tabular-nums}
input[type=range]{display:block;width:100%;height:12px;margin:0;accent-color:var(--blue)}
.dashboard{display:grid;grid-template-columns:minmax(0,1.34fr) minmax(360px,.86fr);gap:8px;min-height:0;overflow:hidden}
.left-column,.right-column{display:grid;gap:7px;min-width:0;min-height:0;overflow:hidden}
.left-column{grid-template-rows:auto auto minmax(148px,1fr) auto}
.right-column{grid-template-rows:minmax(0,1fr) minmax(105px,.35fr) auto}
.panel{background:var(--panel);border:1px solid var(--line);border-radius:8px;padding:7px 8px;min-width:0;min-height:0;overflow:hidden}
.panel-title{display:flex;align-items:center;justify-content:space-between;gap:8px;color:var(--muted);font-size:10px;font-weight:650;letter-spacing:.04em;text-transform:uppercase;margin:0 0 4px}
.memory-line{display:flex;align-items:center;gap:8px;min-width:0}.memory-line #pipe2-memory{margin:0;white-space:nowrap}
 #all-scheduler-status{transition:color .2s}#all-scheduler-status.delayed{color:#ff7b72;font-weight:700}
.pipe2-frames{display:flex;gap:2px;min-width:0;overflow:hidden}.pipe2-frame{display:inline-block;flex:1 1 0;max-width:22px;height:8px;border:1px solid #30363d;border-radius:2px;background:#0d1117}.pipe2-frame.filled{background:var(--blue);border-color:var(--blue)}
.diagram{display:flex;align-items:center;justify-content:space-between;gap:3px;flex-wrap:nowrap;margin-top:6px;min-width:0}
.dbox{flex:0 1 auto;min-width:48px;border:1px solid var(--line);border-radius:6px;padding:4px 6px;background:var(--panel2);font-size:10px;color:var(--muted);text-align:center;line-height:1.15}
.dbox small{display:block;font-size:9px;color:var(--muted);margin-top:2px}
.dbox.lit{border-color:var(--green);color:var(--text);box-shadow:0 0 0 1px rgba(46,160,67,.35)}
.dbox.route{border-color:var(--amber);box-shadow:0 0 0 1px rgba(210,153,34,.5)}
.darrow{color:var(--muted);font-size:12px;flex:0 0 auto}
.branch-boxes{display:flex;align-items:center;gap:3px}
.stage-row{display:grid;grid-template-columns:1fr 1fr 1.1fr;gap:6px;min-width:0}
.stage-card{background:var(--panel);border:1px solid var(--line);border-radius:7px;padding:5px 7px;min-width:0;overflow:hidden}
.stage-card .stage-label{font-size:9px;color:var(--muted);text-transform:uppercase;letter-spacing:.04em;margin-bottom:2px}
.threshold-meters{display:grid;gap:2px;margin-top:3px}.threshold-meter{display:grid;grid-template-columns:34px minmax(30px,1fr) 66px;gap:4px;align-items:center;font-size:9px;color:var(--muted);height:14px}.meter-track{height:9px;position:relative;border-radius:99px;background:#21262d;border:1px solid #484f58;overflow:visible}.meter-fill{display:block;height:100%;width:0;border-radius:99px;background:#b62324}.meter-fill.met{background:var(--green)}.meter-mark{position:absolute;top:-3px;bottom:-3px;width:2px;background:#f0883e;z-index:1}.meter-state{font-size:9px;text-align:right;white-space:nowrap;font-variant-numeric:tabular-nums}.meter-state.met{color:#3fb950}.meter-state.miss{color:#ff7b72}
.verdict{font-size:11px;font-weight:650;padding:4px 6px;border-radius:5px;margin:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.v-pass{background:#1a7f37;color:#fff}.v-low{background:#9e6a03;color:#fff}.v-fail{background:#b62324;color:#fff}.v-idle{background:#21262d;color:var(--muted)}
.action-room-row{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:7px;min-height:0;min-width:0;flex:1 1 auto;overflow:hidden}
.action-panel{display:flex;flex-direction:column;min-height:0;overflow:hidden}
.action-panel .panel-title{flex:0 0 auto}.action-panel #pipe2-action{flex:0 0 auto;margin-bottom:4px}
.parallel-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));grid-auto-rows:minmax(42px,1fr);gap:3px;margin:0;min-height:0;overflow-y:auto}.action-panel .parallel-grid{flex:1}
.parallel-action{background:var(--panel2);border:1px solid var(--line);border-radius:4px;padding:3px 5px;min-height:42px;height:auto;display:grid;grid-template-columns:10px minmax(0,1fr);column-gap:4px;align-items:center;overflow:hidden}
.parallel-action.selected{border-color:var(--green);box-shadow:0 0 0 1px var(--green)}
.parallel-led{display:inline-block;width:8px;height:8px;border-radius:50%;background:#30363d;margin:0;transition:background .15s,box-shadow .15s}.parallel-led.on{background:var(--green);box-shadow:0 0 6px var(--green)}
.parallel-action strong{font-size:9.5px;line-height:1.1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.parallel-action .statsline{display:none}

.room-panel{display:flex;flex-direction:column;min-height:0;overflow:hidden}
.room{position:relative;width:100%;height:100%;min-height:165px;background:linear-gradient(#101722,#1a2230 60%,#232c3b);border:1px solid var(--line);border-radius:6px;overflow:hidden;flex:1 1 auto}
.window{position:absolute;top:8px;left:10px;width:68px;height:48px;border-radius:5px;background:radial-gradient(circle at 70% 30%,#233a5c,#0a1220);border:2px solid #3a4658}
.stars{position:absolute;width:100%;height:100%;background-image:radial-gradient(#cfe1ff 1px,transparent 1px);background-size:14px 14px;opacity:.5}
.moon{position:absolute;top:5px;right:6px;width:14px;height:14px;border-radius:50%;background:#f4e9c8;box-shadow:0 0 10px #f4e9c8aa}
.floor{position:absolute;left:0;right:0;bottom:14px;height:2px;background:linear-gradient(90deg,transparent,#2b3442 10%,#2b3442 90%,transparent)}
.bed{position:absolute;bottom:16px;left:12px;width:125px;height:48px;background:#3b4a63;border-radius:6px;border:2px solid #55658a}
.bed .headboard{position:absolute;left:-8px;top:-16px;width:14px;height:64px;background:#54402c;border:2px solid #6b543f;border-radius:4px}
.bed .mattress{position:absolute;inset:3px;background:#4d5f80;border-radius:4px}
.bed .pillow{position:absolute;top:5px;left:6px;width:34px;height:14px;background:#dfe6f2;border-radius:4px}
.bed .blanket{position:absolute;bottom:3px;right:4px;width:74px;height:24px;background:#7c5ea8;border-radius:4px}
.bed .legs{position:absolute;bottom:-7px;left:6px;right:6px;height:7px}
.bed .legs i{position:absolute;bottom:0;width:7px;height:7px;background:#3a2f22;border-radius:0 0 2px 2px}
.bed .legs i:first-child{left:0}.bed .legs i:last-child{right:0}
.bed.zzz::after{content:"Z z z";position:absolute;top:-15px;right:12px;color:var(--muted);font-size:9px}
.nightstand{position:absolute;bottom:16px;left:144px;width:36px;height:32px;background:#4a3a2c;border:2px solid #6b543f;border-radius:4px}
.nightstand::before{content:"";position:absolute;left:4px;right:4px;top:5px;height:9px;border:1px solid #6b543f;border-radius:2px;background:#54402c}
.nightstand::after{content:"";position:absolute;left:15px;top:9px;width:4px;height:4px;border-radius:50%;background:#8a6a1d}
.nslamp{position:absolute;bottom:48px;left:150px;width:18px;height:22px}
.nslamp .shade{position:absolute;top:0;left:0;width:18px;height:9px;background:linear-gradient(#b18a35,#6e5a22);clip-path:polygon(16% 0,84% 0,100% 100%,0 100%);border-radius:2px}
.nslamp .stem{position:absolute;top:9px;left:8px;width:2px;height:9px;background:#6e7681}
.nslamp .base{position:absolute;bottom:0;left:4px;width:10px;height:4px;border-radius:2px;background:#6e7681}
.nslamp.on .shade{background:linear-gradient(#ffe27a,#d29922);box-shadow:0 0 14px 5px rgba(255,215,94,.5)}
.bulblamp{position:absolute;top:0;left:52%;width:30px;display:flex;flex-direction:column;align-items:center;z-index:2;transform:translateX(-50%)}
.bulbwire{width:2px;height:24px;background:#77808d}
.bulb{position:relative;width:28px;height:28px;border-radius:50%;background:radial-gradient(circle at 38% 32%,#596270,#303844 70%);border:2px solid #8b949e;transition:box-shadow .3s,background .3s,filter .3s}
.bulb::after{content:"";position:absolute;left:8px;bottom:-6px;width:10px;height:7px;border-radius:0 0 3px 3px;background:#6e7681;border:1px solid #9da5ae}
.bulb.on{background:var(--bulb-color,#ffe27a);border-color:#fff1b5;box-shadow:0 0 14px 5px rgba(255,215,94,.65),0 0 36px 16px rgba(255,215,94,.34);filter:brightness(calc(.6 + var(--bright,1)*.01))}
.bulb .fil{position:absolute;inset:8px;border-radius:50%;background:#20262e}
.bulb.on .fil{background:#b8860b}
.musicbox{position:absolute;bottom:16px;left:188px;width:110px;background:var(--panel2);border:1px solid var(--line);border-radius:5px;padding:3px 5px}
.musicbox .track{font-size:8.5px;color:var(--muted);margin-bottom:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.musicbox .bars{display:flex;gap:2px;align-items:flex-end;height:14px}
.musicbox .bars i{width:4px;background:var(--blue);border-radius:1px;height:3px}
.musicbox.playing .bars i{animation:jump .7s infinite ease-in-out}
.musicbox .bars i:nth-child(2){animation-delay:.15s}.musicbox .bars i:nth-child(3){animation-delay:.3s}.musicbox .bars i:nth-child(4){animation-delay:.45s}
@keyframes jump{0%,100%{height:3px}50%{height:14px}}
.vol{height:3px;background:#0d1117;border:1px solid var(--line);border-radius:2px;margin-top:2px;overflow:hidden}.vol i{display:block;height:100%;background:var(--green);width:40%}
.thermo{position:absolute;top:8px;right:8px;width:38px;background:var(--panel2);border:1px solid var(--line);border-radius:5px;padding:3px 2px;text-align:center}
.thermo .num{font-size:12px;font-weight:700}.thermo .unit{font-size:8px;color:var(--muted)}
.thermo .tube{height:32px;width:6px;margin:2px auto;background:#0d1117;border:1px solid var(--line);border-radius:3px;position:relative}.thermo .tube i{position:absolute;bottom:0;left:0;right:0;background:#ff6b6b;border-radius:2px;transition:height .4s}
.clock{position:absolute;top:8px;left:86px;background:var(--panel2);border:1px solid var(--line);border-radius:4px;padding:2px 5px;font-size:9.5px}
.room-subpanel{position:absolute;background:rgba(21,27,36,.94);border:1px solid var(--line);border-radius:5px;padding:3px 5px;font-size:9.5px;min-width:80px;display:none;z-index:3}
.room-subpanel b{display:block;font-size:7.5px;color:var(--muted);text-transform:uppercase;letter-spacing:.04em;margin-bottom:1px}
#p-timer{top:36px;right:8px}#p-alarm{top:36px;right:50px}#p-remind{bottom:50px;right:8px;max-width:125px}#p-call{bottom:50px;left:12px}#p-msg{top:36px;left:86px}#p-info{bottom:50px;left:90px}
#p-call.ring{border-color:var(--amber);animation:ring 1s infinite}@keyframes ring{0%,100%{box-shadow:0 0 0 rgba(210,153,34,0)}50%{box-shadow:0 0 10px rgba(210,153,34,.7)}}
#p-timer .cd{font-size:11px;font-weight:700}
ul#remlist{margin:0;padding-left:8px;max-height:40px;overflow:auto;font-size:8.5px}
.gauges{position:absolute;bottom:2px;right:6px;display:flex;gap:3px;font-size:7.5px;color:var(--muted)}
.gauges .g{background:var(--panel2);border:1px solid var(--line);border-radius:3px;padding:1px 3px}
.gauges .g b{color:var(--text)}
.room-subtitle{flex:0 0 auto;margin-top:3px;padding:3px 6px;min-height:20px;display:flex;align-items:center;gap:5px;background:#101820;border:1px solid #58a6ff;border-left:3px solid #58a6ff;border-radius:5px;font-size:9.5px;line-height:1.2}
.room-subtitle .speaker{flex:none;color:#79c0ff;font-weight:700}
.room-subtitle .text{font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.result-panel{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1.4fr);grid-template-rows:auto auto;gap:4px 8px;align-items:center}
.result-panel .panel-title{grid-column:1/-1;margin:0}
.parallel-specialists{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:3px;min-width:0}
.parallel-branch{padding:4px 5px;border:1px solid var(--line);border-radius:4px;font-size:10px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;background:var(--panel2)}
.parallel-branch.route{border-color:var(--amber);background:#211a0d;color:#ffe0a3}
.result-lines{display:grid;grid-template-columns:1fr 1.3fr;gap:3px 7px;min-width:0}
.result-lines .thrlabel{font-size:10px;margin:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.result-lines #pipe2-path{font-size:10px}.result-lines #pipe2-accuracy{grid-column:1/-1}
.right-column .charts-panel{display:grid;grid-template-rows:auto minmax(0,1fr) minmax(0,.82fr);gap:5px}
.chart-pair{display:grid;grid-template-columns:1fr 1fr;gap:6px;min-height:0}
.chart-box{min-width:0;min-height:0;display:flex;flex-direction:column}.chart-box figcaption,.chart-caption{font-size:9px;color:var(--muted);margin-bottom:2px}
.chart{width:100%;height:100%;min-height:55px;display:block;background:#0d1117;border-radius:4px}
.right-column .charts-panel h2{font-size:10px;margin:0;color:var(--muted);font-weight:650;letter-spacing:.04em;text-transform:uppercase}
.threshold-chart{min-height:0;display:flex;flex-direction:column}.threshold-chart .chart{flex:1}
.owner-panel{display:grid;grid-template-columns:auto minmax(0,1fr);gap:4px 8px;align-items:center;padding:6px 8px}
.owner-panel .panel-title{grid-column:1/-1;margin:0}.owner-panel button{grid-column:1;grid-row:2}.owner-panel #pipe2-ownervoice-summary{grid-column:2;grid-row:2;white-space:nowrap}
.owner-panel details{grid-column:1/-1;font-size:10px;color:var(--muted)}
.owner-panel details[open]{max-height:82px;overflow:auto}.owner-panel summary{cursor:pointer}
.logs-panel{min-height:0;display:flex;flex-direction:column}.gate-log-wrap{min-height:0;overflow:auto}.gate-log{width:100%;border-collapse:collapse;table-layout:fixed;font-size:9px;line-height:1.15}.gate-log th{color:var(--muted);font-weight:600;text-align:left;padding:2px 3px;border-bottom:1px solid var(--line)}.gate-log td{padding:3px;border-bottom:1px solid #252c34;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-variant-numeric:tabular-nums}.gate-log td.met{color:#3fb950}.gate-log td.miss{color:#ff7b72}.gate-log td.route{color:#ffe0a3;background:#211a0d}.gate-log th:first-child,.gate-log td:first-child{width:62px;color:var(--muted)}
.owner-panel #pipe2-ownervoice-perintent,.owner-panel #pipe2-ownervoice-mismatches{font-size:10px;overflow-wrap:anywhere}
@media (max-width:1100px){
 body{height:auto;min-height:100%;overflow:auto}.app-shell{height:auto;min-height:100vh;overflow:visible;display:flex;flex-direction:column}.control-rail{grid-template-columns:1fr 1fr}.dashboard{grid-template-columns:1fr;overflow:visible}.left-column,.right-column{overflow:visible}.left-column{grid-template-rows:auto auto auto auto}.right-column{grid-template-rows:auto auto auto}
}
</style>
</head>
<body>
<div class="app-shell">
 <header class="topbar">
  <div class="brand"><h1>Pipeline test</h1><span class="sub">All gates · live · localhost only</span> <span id="build-badge" title="Build marker - if this badge is missing, this tab is showing a stale page; refresh to load the latest build" style="margin-left:10px;font-size:10px;font-weight:600;color:#3fb950;border:1px solid #238636;border-radius:6px;padding:2px 7px;background:#12261a;white-space:nowrap;">build 2026-10-24 · arch + v7x layers</span> <a href="/room_sim.html" target="_blank" style="color:#58a6ff;text-decoration:none;font-weight:600;font-size:11px;padding:3px 8px;border:1px solid var(--line);border-radius:6px;background:#21262d;margin-left:8px;">Open Bedroom Simulation ↗</a></div>
  <div style="display:flex;gap:8px;align-items:center;">
  <button id="all-bench-toggle" title="Switch the trigger-gantt panel between the live timeline and the saved benchmark runs (Gate 1 × Gate 2 combinations)" style="background:#21262d;color:#c9d1d9;border:1px solid var(--line);border-radius:5px;padding:4px 9px;cursor:pointer;font-size:11px;">📊 Benchmark gantt</button>
  <button id="all-recframe-toggle" title="Open the recording test frame: pick a saved recording, replay it through every Gate 1 × Gate 2 combination, and see the per-combination trigger gantt" style="background:#21262d;color:#c9d1d9;border:1px solid var(--line);border-radius:5px;padding:4px 9px;cursor:pointer;font-size:11px;">🧪 Recording test</button>
  <button id="all-actions-toggle" title="Stop or resume the pipeline's ACTION execution (lights, music, calls, voice). Detection keeps running — practice and record without triggering anything." style="background:#b62324;color:#fff;border:1px solid #f85149;border-radius:5px;padding:4px 9px;cursor:pointer;font-size:11px;font-weight:600;">▶ Play actions</button>
  <div id="status">connecting…</div>
  </div>
 </header>

 <section id="all-top-controls" class="control-rail" aria-label="Gate models and thresholds">
  <div class="control-field"><label for="all-g1model">Gate 1 variant</label>
   <select id="all-g1model">
        <option value="gate1v12_f16" selected>G1 v12 · warp+masks · NEW default (val 90.4%)</option><option value="gate1v8_f32">G1 v8 · f32 (previous default)</option><option value="gate1v8_f16">G1 v8 · f16 (previous default)</option><option value="gate1v10_f16">G1 v10 · f16 (failed benchmark)</option><option value="gate1v10_dr">G1 v10 · dyn-range (failed benchmark)</option><option value="gate1v8c_f16" disabled>G1 v8c · disabled · needs 49×40 adapter</option>
