  <div class="control-field"><label for="all-arch">Architecture</label>
   <select id="all-arch" aria-label="Pipeline architecture" title="v1 — all gates run simultaneously and a trigger needs Gate 1 + Gate 2; v2 — Gate 2 sleeps until Gate 1 has heard the wake; v3 — v2 plus a two-tick intent vote before a command counts.">
    <option value="0" selected>v1 — all gates run</option>
    <option value="1">v2 — G1 first</option>
    <option value="2">v3 — G1 first + intent vote</option>
   </select>
