  <button id="all-calibrate">Calibrate 10s</button>
   <button id="all-stop-action">Stop action</button>
   <button id="all-noise-canceller" title="Spectral noise canceller: tracks ambient noise on quiet ticks, cleans inference windows when ON">Noise canceller: OFF</button>
   <select id="all-memory" title="Rolling memory seconds"><option value="20" selected>Memory 20 s</option><option value="10">Memory 10 s</option><option value="6">Memory 6 s</option></select>
   <select id="all-interval" title="Evaluation cadence (seconds per tick)"><option value="1" selected>Eval 1 s</option><option value="2">Eval 2 s</option><option value="3">Eval 3 s</option><option value="6">Eval 6 s</option></select>
   <button id="all-skip-ticks" title="Toggle skipped ticks tracking">Skipped ticks: OFF</button>
   <button id="all-reset-pipeline" style="background:#3b181a;border-color:#b62324;color:#ff7b72;" title="Reset pipeline: audio buffer, frames, and gate states">↺ Reset</button>
  <div class="threshold-controls" aria-label="Threshold controls">
   <label class="threshold-control"><span class="range-label"><span>Nova</span><output id="all-thr-nova-val">0.50</output></span><input type="range" id="all-thr-nova" min="0.05" max="0.95" step="0.05" value="0.5"></label>
   <label class="threshold-control"><span class="range-label"><span>Piattos</span><output id="all-thr-piattos-val">0.50</output></span><input type="range" id="all-thr-piattos" min="0.05" max="0.95" step="0.05" value="0.5"></label>
   <label class="threshold-control"><span class="range-label"><span>G2 min</span><output id="all-thr-g2min-val">0.50</output></span><input type="range" id="all-thr-g2min" min="0.05" max="0.95" step="0.05" value="0.5"></label>
  </div>
 </section>

 <div id="all-topcombos" style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;max-width:1200px;margin:0 auto 8px;padding:0 10px;" aria-label="Top combination bookmarks">
  <span style="font-size:10px;font-weight:700;color:#e3b341;white-space:nowrap;" title="Top 5 combinations from the batch replay (recordings/results). Click a bookmark to apply its Gate 1 + Gate 2 + Architecture + Noise-canceller settings to the live pipeline.">★ Top combos:</span>
  <span id="all-topcombos-status" style="font-size:10px;color:#e3b341;white-space:nowrap;"></span>
 </div>

 <main id="all-main-grid" class="dashboard">
  <section id="all-left-column" class="left-column" aria-label="Live pipeline">
   <section class="panel flow-panel">
    <div class="panel-title"><span>20-second memory · 1 s parallel evaluation</span><span>Light precedes specialists</span></div>
    <div class="memory-line"><div id="pipe2-memory" class="thrlabel">MEMORY: 0/20 s · waiting</div><div id="pipe2-frames" class="pipe2-frames" aria-label="20 stored audio frames"></div></div>
    <div id="all-scheduler-status" class="thrlabel">2 s evaluation · skipped_ticks 0 · 20-second recording buffer</div>
    <div id="all-skipped-log" class="thrlabel" style="display:none;color:var(--amber);font-size:9px"></div>
    <div id="all-diagram" class="diagram" aria-label="Gate trigger flow">
     <div class="dbox" id="all-box-mic"><b>MIC</b><small>1 s frames</small></div><span class="darrow">›</span>
     <div class="dbox" id="all-box-g1"><b>G1</b><small>wake · 2/3</small></div><span class="darrow">›</span>
     <div class="dbox" id="all-box-g2"><b>G2</b><small>intent · threshold</small></div><span class="darrow">›</span>
     <div class="dbox" id="all-box-light"><b>LIGHT</b><small>first</small></div><span class="darrow">›</span>
     <div class="branch-boxes"><div class="dbox" id="all-box-g3"><b>G3</b><small>numeric</small></div><div class="dbox" id="all-box-g4"><b>G4</b><small>color</small></div><div class="dbox" id="all-box-g5"><b>G5</b><small>reminder</small></div></div><span class="darrow">›</span>
     <div class="dbox" id="all-box-out"><b>RESULT</b><small>display only</small></div>
    </div>
   </section>

   <div class="stage-row">
    <section class="stage-card"><div class="stage-label">Gate 1 · wake</div><div id="pipe2-g1" class="verdict v-idle">Listening for Nova / Piattos</div><div class="threshold-meters"><div id="all-meter-nova" class="threshold-meter"><span>Nova</span><div class="meter-track"><i id="all-meter-nova-fill" class="meter-fill"></i><b id="all-meter-nova-mark" class="meter-mark"></b></div><span id="all-meter-nova-state" class="meter-state">—</span></div><div id="all-meter-piattos" class="threshold-meter"><span>Piattos</span><div class="meter-track"><i id="all-meter-piattos-fill" class="meter-fill"></i><b id="all-meter-piattos-mark" class="meter-mark"></b></div><span id="all-meter-piattos-state" class="meter-state">—</span></div></div></section>
    <section class="stage-card"><div class="stage-label" id="all-stage-g2-label">Gate 2 · only after wake</div><div id="pipe2-g2" class="verdict v-idle">Waiting for Gate 1 wake</div><div id="all-meter-g2" class="threshold-meter"><span>G2</span><div class="meter-track"><i id="all-meter-g2-fill" class="meter-fill"></i><b id="all-meter-g2-mark" class="meter-mark"></b></div><span id="all-meter-g2-state" class="meter-state">WAIT</span></div></section>
    <section class="stage-card"><div class="stage-label">Action · light first</div><div id="pipe2-action" class="verdict v-idle">Waiting for Gate 1 + Gate 2</div><div id="all-voice-status" style="font-size:9px;color:var(--muted);margin-top:3px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">🔊 Voice: idle</div></section>
   </div>

   <div class="action-room-row">
    <section class="panel action-panel" id="all-action-panel">
     <div class="panel-title"><span>One action light per intent</span><span>19 intents</span></div>
     <div id="pipe2-cards" class="parallel-grid"></div>
    </section>

    <section class="panel room-panel" id="all-room-panel">
     <div class="panel-title">
      <span>VCM Room Simulation</span>
      <div style="display:flex;gap:4px;align-items:center;">
       <button id="btn-persona" type="button" style="padding:1px 6px;font-size:9px;background:#21262d;color:#c9d1d9;border:1px solid var(--line);border-radius:4px;cursor:pointer;">Persona: <b id="lbl-persona" style="color:#58a6ff">Nova ♀</b></button>
      </div>
     </div>
     <div class="room" id="room">
      <div class="window"><div class="stars"></div><div class="moon"></div></div>
      <div class="clock" id="clock">--:--</div>
      <div class="floor"></div>
      <div class="bed" id="bed"><div class="headboard"></div><div class="mattress"></div><div class="pillow"></div><div class="blanket"></div><div class="legs"><i></i><i></i></div></div>
      <div class="nightstand"></div><div class="nslamp" id="nslamp" role="img" aria-label="Desk lamp off"><div class="shade"></div><div class="stem"></div><div class="base"></div></div>
      <div class="musicbox" id="musicbox"><div class="track" id="track">Track 1 · stopped</div><div class="bars"><i></i><i></i><i></i><i></i></div><div class="vol"><i id="volbar"></i></div></div>
      <div class="bulblamp"><div class="bulbwire"></div><div class="bulb" id="bulb" style="--bright:1"><div class="fil"></div></div></div>
      <div class="thermo"><div class="num" id="tempnum">22</div><div class="unit">°C</div><div class="tube"><i id="tempbar" style="height:50%"></i></div></div>
      <div class="room-subpanel" id="p-timer"><b>Timer</b><div class="cd" id="timercd">—</div></div>
      <div class="room-subpanel" id="p-alarm"><b>Alarm</b><div id="alarmset">not set</div></div>
      <div class="room-subpanel" id="p-remind"><b>Reminders</b><ul id="remlist"></ul></div>
      <div class="room-subpanel" id="p-call"><b>Intercom</b><div id="callstate">idle</div></div>
      <div class="room-subpanel" id="p-msg"><b>Message</b><div id="msgtext">—</div></div>
      <div class="room-subpanel" id="p-info"><b>Info</b><div id="infotext">—</div></div>
      <div class="gauges"><div class="g">G1 <b id="g1s">idle</b></div><div class="g">G2 <b id="g2s">idle</b></div></div>
     </div>
     <div class="room-subtitle" id="room-subtitle" role="status" aria-live="polite">
      <span class="speaker" id="room-subtitle-speaker">Nova:</span>
      <span class="text" id="room-subtitle-text">Ready for a voice command.</span>
     </div>
    </section>
   </div>

   <section class="panel result-panel">
    <div class="panel-title"><span>All specialists tested on the same window</span><span>Amber = routed by Gate 2</span></div>
    <div id="pipe2-specialists" class="parallel-specialists">
     <div id="pipe2-spec-gateN" class="parallel-branch">G3: waiting</div><div id="pipe2-spec-gate4" class="parallel-branch">G4: waiting</div><div id="pipe2-spec-gate5" class="parallel-branch">G5: waiting</div>
    </div>
    <div class="result-lines"><div id="pipe2-slot" class="thrlabel">SLOT: —</div><div id="pipe2-path" class="verdict v-idle">PATH: —</div><div id="pipe2-accuracy" class="thrlabel">ACCURACY: select expected phrase</div></div>
   </section>
  </section>

  <aside id="all-right-column" class="right-column" aria-label="Audio charts and recorded accuracy">
   <section class="panel charts-panel">
    <div class="panel-title"><span>Live mic</span><span>Waveform + level</span></div>
    <div class="chart-pair">
     <div class="chart-box"><figcaption>Voice waveform</figcaption><canvas id="all-wave" class="chart" width="700" height="100" aria-label="Live voice waveform"></canvas></div>
     <div class="chart-box"><figcaption>Volume / RMS</figcaption><canvas id="all-volume" class="chart" width="500" height="100" aria-label="Microphone volume level"></canvas></div>
    </div>
    <div class="threshold-trio" style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:6px;min-height:0">
     <div class="threshold-chart"><div class="chart-caption">Gate 1 · Wake thr & conf</div><canvas id="all-thrchart-g1" class="chart" width="300" height="95" aria-label="Gate 1 threshold and confidence history"></canvas></div>
     <div class="threshold-chart"><div class="chart-caption">Gate 2 · Intent thr & conf</div><canvas id="all-thrchart-g2" class="chart" width="300" height="95" aria-label="Gate 2 threshold and confidence history"></canvas></div>
     <div class="threshold-chart"><div class="chart-caption">Gate 3–5 · Slot specialist conf</div><canvas id="all-thrchart-g3" class="chart" width="300" height="95" aria-label="Gate 3-5 slot confidence history"></canvas></div>
     <canvas id="all-thrchart" style="display:none"></canvas>
    </div>
   </section>
   <section class="panel logs-panel">
    <div class="panel-title"><span>Gate 1 & Gate 2 Trigger Gantt</span><span>Timeline (last 30s)</span></div>
     <div class="gantt-wrap" id="all-gantt-wrap" style="position:relative;width:100%;height:68px;margin-bottom:6px;">
      <canvas id="all-gantt-chart" width="460" height="68" class="chart" style="width:100%;height:100%;display:block;" aria-label="Gantt chart of Gate 1 and Gate 2 trigger activations"></canvas>
     </div>
     <div id="all-bench-view" style="display:none;">
      <div class="row" style="display:flex;gap:6px;align-items:center;margin-bottom:4px;">
       <select id="all-bench-results" style="flex:1;background:#21262d;color:#e6edf3;border:1px solid var(--line);border-radius:5px;padding:3px 6px;font-size:11px;"></select>
       <button id="all-bench-refresh" style="background:#21262d;color:#c9d1d9;border:1px solid var(--line);border-radius:5px;padding:3px 8px;cursor:pointer;font-size:11px;">↻</button>
      </div>
      <div style="max-height:300px;overflow:auto;border:1px solid var(--line);border-radius:6px;background:#0d1117;">
       <canvas id="all-bench-chart" style="display:block;"></canvas>
      </div>
      <div class="hint" id="all-bench-info" style="font-size:9px;color:#8b949e;margin-top:3px;"></div>
      <div id="all-bench-summary" style="margin-top:8px;"></div>
     </div>
    <div class="panel-title" style="margin-top:2px;"><span>Recent history per gate</span><span>last 6 pipeline ticks</span></div>
    <div class="gate-log-wrap"><table class="gate-log"><thead><tr><th>Time</th><th>G1</th><th>G2</th><th>G3</th><th>G4</th><th>G5</th></tr></thead><tbody id="all-gate-history"><tr><td colspan="6">Waiting for mic frames</td></tr></tbody></table></div>
   </section>
   <section class="panel owner-panel" id="pipe2-ownervoice">
    <div class="panel-title"><span>Recorded voice test · 280 clips</span><span>Gate 2 offline score</span></div>
    <button id="pipe2ownervoiceRun">Score 280 recordings</button>
    <div id="pipe2-ownervoice-summary" class="verdict v-idle">Not scored yet</div>
    <button id="pipe2ownervoiceSave30" style="grid-column:1;grid-row:3">⏺ Save last 30 s</button>
    <div id="pipe2-ownervoice-capture" class="statsline" style="grid-column:2;grid-row:3;color:var(--muted)">Captures the last 30 s of live mic → Recording Lab</div>
    <details><summary>Per-intent accuracy and mismatches</summary><div id="pipe2-ownervoice-perintent" class="statsline">—</div><div id="pipe2-ownervoice-mismatches" class="statsline">—</div></details>
   </section>
  </aside>
 </main>
</div><script>
window.VCMPIPE2_PHRASES = {"G2": [["play some music", "PLAY_MUSIC"], ["what's the weather today", "WEATHER"], ["what time is it", "TIME"], ["turn on the lights", "LIGHT_ON"], ["turn off the lights", "LIGHT_OFF"], ["pause the music", "PAUSE"], ["stop", "STOP"], ["next song", "NEXT"], ["turn the volume up", "VOLUME_UP"], ["turn the volume down", "VOLUME_DOWN"], ["call mom", "CALL"], ["send a message to john", "MESSAGE"], ["list my reminders", "LIST_REMINDERS"], ["set a timer for 10 seconds", "TIMER"], ["set a timer for 30 seconds", "TIMER"], ["set a timer for 1 minute", "TIMER"], ["set an alarm for 6 am", "ALARM"], ["set an alarm for 8 am", "ALARM"], ["set an alarm for 9 pm", "ALARM"], ["set the temperature to 18 degrees", "TEMPERATURE"], ["set the temperature to 22 degrees", "TEMPERATURE"], ["set the temperature to 26 degrees", "TEMPERATURE"], ["set brightness to 20 percent", "BRIGHTNESS"], ["set brightness to 60 percent", "BRIGHTNESS"], ["set brightness to 100 percent", "BRIGHTNESS"], ["make the lights red", "COLOR"], ["make the lights blue", "COLOR"], ["make the lights green", "COLOR"], ["remind me to drink water", "CREATE_REMINDER"], ["remind me to study", "CREATE_REMINDER"], ["remind me to exercise", "CREATE_REMINDER"]]};
